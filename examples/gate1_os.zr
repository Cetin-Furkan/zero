// =============================================================================
// ZeroOS Gate-1a Bare-Metal UEFI Ring-0 Image (`examples/gate1_os.zr`)
// =============================================================================
// Written in hardware-typed Zero (zero raw `@mm_*` or `@port_in8/out8` pokes):
//   - `@port` typed hardware I/O channels (`debug_con`, `kbd_data`, `kbd_status`)
//   - `<packed>` firmware/CPU tables (`Tss64`, `AcpiRsdp`, `AcpiSdtHeader`)
//   - `@BootHandoff` overlay parameter & bounded `@view<MemRange>` span
//   - `@mmio<u32>` bounded GOP scanout aperture
//   - Hardware W^X CR3 via `IA32_EFER.NXE` (`.text` RX, DRAM RW+NX, ACPI RO+NX,
//     GOP WC+NX, MMIO UC+NX) + runtime `verify_no_wx_pages()` walker
//   - Compile-time `if qemu_debug == 1` branch elimination (zero `0xE9` on laptop)
//   - Non-returning `@halt()`
// =============================================================================

// Set to `0` for physical laptop media without port `0xE9` (`PEER_MASTER_PLAN.md` §8.5)
qemu_debug          :: 1

HANDOFF_MAGIC       :: 0x5A45524F48414E44
RSDP_MAGIC          :: 0x2052545020445352
MADT_SIG            :: 0x43495041

IA32_EFER_MSR       :: 0xC0000080
IA32_PAT_MSR        :: 0x277
PAT_PA1_WC_VALUE    :: 0x0007040600070106

PTE_NX              :: 1 << 63
PTE_DIR             :: 0x03
PTE_RX              :: 0x01
PTE_RW_NX           :: 0x03 | PTE_NX
PTE_RO_NX           :: 0x01 | PTE_NX
PTE_WC_NX           :: 0x0B | PTE_NX
PTE_UC_NX           :: 0x1B | PTE_NX
PDE_PS              :: 0x80
ADDR_MASK_4K        :: 0x000FFFFFFFFFF000

PAGE_4K             :: 0x1000
PAGE_2M             :: 0x200000
PAGE_1G             :: 0x40000000
TSS_LIMIT           :: @sizeof(Tss64) - 1

// Hardware I/O port channels (0xE9 debugcon, i8042 keyboard controller)
@port debug_con     : <u8 | 0xE9>
@port kbd_data      : <u8 | 0x60>
@port kbd_status    : <u8 | 0x64>

Tss64 :: <packed> {
    res0:       u32
    rsp0:       u64
    rsp1:       u64
    rsp2:       u64
    res1:       u64
    ist1:       u64
    ist2:       u64
    ist3:       u64
    ist4:       u64
    ist5:       u64
    ist6:       u64
    ist7:       u64
    res2:       u64
    res3:       u16
    iomap_base: u16
}

AcpiRsdp :: <packed> {
    signature:  u64
    checksum:   u8
    oemid_lo:   u32
    oemid_hi:   u16
    revision:   u8
    rsdt_addr:  u32
    length:     u32
    xsdt_addr:  u64
}

AcpiSdtHeader :: <packed> {
    signature:    u32
    length:       u32
    revision:     u8
    checksum:     u8
    oemid_lo:     u32
    oemid_hi:     u16
    oem_table_id: u64
    oem_rev:      u32
    creator_id:   u32
    creator_rev:  u32
}

MemRange :: {
    kind:     u32
    pad:      u32
    phys:     u64
    byte_len: u64
}

BootHandoff :: <align: 64B> {
    magic:         u64
    version:       u32
    core_count:    u32
    gop_base:      u64
    gop_width:     u32
    gop_height:    u32
    gop_stride:    u32
    gop_format:    u32
    rsdp:          u64
    madt:          u64
    mcfg:          u64
    ap_release:    u64
    ap_stack_base: u64
    map_count:     u32
    map:           u64
    code_base:     u64
    code_bytes:    u64
}

// 4KiB-aligned Ring-0 descriptor tables & page-table pool in `.bss` (0 disk bytes)
@slab gdt_slab      : <u64 | max: 8>
@slab tss_slab      : <u32 | max: 32>
@slab rsp0_slab     : <u64 | max: 2048>
@slab idt_slab      : <u64 | max: 512>
@slab pt_pool       : <u64 | max: 262144>
@slab pt_state      : <u64 | max: 4>

fn dbg_putc(ch: u8) i64 {
    if qemu_debug == 1 {
        debug_con.write(ch)
    }
    return 0
}

fn dbg_hex_nibble(v: u64) i64 {
    nib: u64 = v & 15
    if nib < 10 {
        dbg_putc(48 + nib)
    } else {
        dbg_putc(55 + nib)
    }
    return 0
}

fn dbg_hex32(v: u64) i64 {
    dbg_putc('0')
    dbg_putc('x')
    sh: i64 = 28
    loop <max: 8 | until: sh < 0> {
        u_sh: u64 = sh
        dbg_hex_nibble(v >> u_sh)
        sh = sh - 4
    }
    return 0
}

fn dbg_u32_dec(val: u64) i64 {
    if val == 0 {
        dbg_putc('0')
        return 0
    }
    div_u: u64 = 1000000000
    started: u64 = 0
    v: u64 = val
    loop <max: 10 | until: div_u == 0> {
        dig: u64 = v / div_u
        v %= div_u
        if dig != 0 || started == 1 {
            dbg_putc(48 + dig)
            started = 1
        }
        div_u /= 10
    }
    return 0
}

// Allocates a zeroed 4KiB page-table page from `pt_pool` (`512` u64 entries per page)
fn alloc_pt_page() u64 {
    pg_idx: u64 = pt_state[0]
    if pg_idx >= 512 {
        @halt()
    }
    pt_state[0] = pg_idx + 1
    return pg_idx
}

// Ensures directory `table_pg[slot]` points to a sub-table (`P | RW`, `NX = 0`)
fn ensure_subtable(table_pg: u64, slot: u64) u64 {
    idx: u64 = table_pg * 512 + slot
    cur: u64 = pt_pool[idx]
    if (cur & 1) != 0 {
        if (cur & PDE_PS) != 0 {
            @halt()
        }
        child_phys: u64 = cur & ADDR_MASK_4K
        return (child_phys - pt_pool.base) / PAGE_4K
    }
    new_pg: u64 = alloc_pt_page()
    new_phys: u64 = pt_pool.base + new_pg * PAGE_4K
    pt_pool[idx] = new_phys | PTE_DIR
    return new_pg
}

// Returns `1` iff `[start, start + len)` overlaps `[s_base, s_end)`
fn overlaps_span(start: u64, len: u64, s_base: u64, s_end: u64) u64 {
    end_a: u64 = start + len
    if end_a <= s_base {
        return 0
    }
    if start >= s_end {
        return 0
    }
    return 1
}

fn map_4k_page(addr: u64, flags: u64, overwrite: u64) i64 {
    pml4_i: u64 = (addr >> 39) & 511
    pdpt_i: u64 = (addr >> 30) & 511
    pd_i:   u64 = (addr >> 21) & 511
    pt_i:   u64 = (addr >> 12) & 511

    pdpt_pg: u64 = ensure_subtable(0, pml4_i)
    pd_pg:   u64 = ensure_subtable(pdpt_pg, pdpt_i)
    pt_pg:   u64 = ensure_subtable(pd_pg, pd_i)
    slot_idx: u64 = pt_pg * 512 + pt_i
    if overwrite == 0 && (pt_pool[slot_idx] & 1) != 0 {
        return 0
    }
    pt_pool[slot_idx] = addr | flags
    return 0
}

fn map_2m_huge(addr: u64, flags: u64) u64 {
    pml4_i: u64 = (addr >> 39) & 511
    pdpt_i: u64 = (addr >> 30) & 511
    pd_i:   u64 = (addr >> 21) & 511

    pdpt_pg: u64 = ensure_subtable(0, pml4_i)
    pd_pg:   u64 = ensure_subtable(pdpt_pg, pdpt_i)
    slot_idx: u64 = pd_pg * 512 + pd_i
    if (pt_pool[slot_idx] & 1) != 0 {
        return 0
    }
    pt_pool[slot_idx] = addr | flags | PDE_PS
    return 1
}

fn map_1g_huge(addr: u64, flags: u64) u64 {
    pml4_i: u64 = (addr >> 39) & 511
    pdpt_i: u64 = (addr >> 30) & 511

    pdpt_pg: u64 = ensure_subtable(0, pml4_i)
    slot_idx: u64 = pdpt_pg * 512 + pdpt_i
    if (pt_pool[slot_idx] & 1) != 0 {
        return 0
    }
    pt_pool[slot_idx] = addr | flags | PDE_PS
    return 1
}

fn build_wx_pagetables(handoff: @BootHandoff, gop_end: u64) u64 {
    pt_state[0] = 1
    ranges := @view<MemRange>(handoff.map, handoff.map_count)
    code_base: u64 = handoff.code_base
    code_end:  u64 = code_base + handoff.code_bytes
    gop_base:  u64 = handoff.gop_base

    // Pass 1: Map `kind == 1` (`WB DRAM`) enforcing hardware W^X:
    //   `.text` `[code_base, code_end)` -> `PTE_RX` (`P=1, RW=0, NX=0`)
    //   all other WB DRAM (excluding GOP) -> `PTE_RW_NX` (`P=1, RW=1, NX=1`)
    for i in 0..ranges.len {
        r := ranges[i]
        if r.kind == 1 {
            addr: u64 = r.phys & ADDR_MASK_4K
            end_addr: u64 = r.phys + r.byte_len
            loop <max: 1048576 | until: addr >= end_addr> {
                rem: u64 = end_addr - addr
                did_huge: u64 = 0

                if (addr & (PAGE_1G - 1)) == 0 && rem >= PAGE_1G {
                    if overlaps_span(addr, PAGE_1G, gop_base, gop_end) == 0 && overlaps_span(addr, PAGE_1G, code_base, code_end) == 0 {
                        did_huge = map_1g_huge(addr, PTE_RW_NX)
                        if did_huge == 1 {
                            addr += PAGE_1G
                        }
                    }
                }

                if did_huge == 0 && (addr & (PAGE_2M - 1)) == 0 && rem >= PAGE_2M {
                    if overlaps_span(addr, PAGE_2M, gop_base, gop_end) == 0 && overlaps_span(addr, PAGE_2M, code_base, code_end) == 0 {
                        did_huge = map_2m_huge(addr, PTE_RW_NX)
                        if did_huge == 1 {
                            addr += PAGE_2M
                        }
                    }
                }

                if did_huge == 0 {
                    if overlaps_span(addr, PAGE_4K, gop_base, gop_end) == 0 {
                        if addr >= code_base && addr < code_end {
                            map_4k_page(addr, PTE_RX, 1)
                        } else {
                            map_4k_page(addr, PTE_RW_NX, 1)
                        }
                    }
                    addr += PAGE_4K
                }
            }
        }
    }

    // Pass 2: Map `kind == 5` (`ACPI / Firmware Read-Only + NX`) without clobbering WB DRAM
    for i in 0..ranges.len {
        r := ranges[i]
        if r.kind == 5 {
            addr: u64 = r.phys & ADDR_MASK_4K
            end_addr: u64 = r.phys + r.byte_len
            loop <max: 262144 | until: addr >= end_addr> {
                if overlaps_span(addr, PAGE_4K, code_base, code_end) == 0 && overlaps_span(addr, PAGE_4K, gop_base, gop_end) == 0 {
                    map_4k_page(addr, PTE_RO_NX, 0)
                }
                addr += PAGE_4K
            }
        }
    }

    // Pass 3: Map `kind == 3` (`UC MMIO + NX`), excluding GOP
    for i in 0..ranges.len {
        r := ranges[i]
        if r.kind == 3 {
            addr: u64 = r.phys & ADDR_MASK_4K
            end_addr: u64 = r.phys + r.byte_len
            loop <max: 262144 | until: addr >= end_addr> {
                rem: u64 = end_addr - addr
                did_2m: u64 = 0
                if (addr & (PAGE_2M - 1)) == 0 && rem >= PAGE_2M {
                    if overlaps_span(addr, PAGE_2M, gop_base, gop_end) == 0 && overlaps_span(addr, PAGE_2M, code_base, code_end) == 0 {
                        did_2m = map_2m_huge(addr, PTE_UC_NX)
                        if did_2m == 1 {
                            addr += PAGE_2M
                        }
                    }
                }
                if did_2m == 0 {
                    if overlaps_span(addr, PAGE_4K, gop_base, gop_end) == 0 {
                        map_4k_page(addr, PTE_UC_NX, 0)
                    }
                    addr += PAGE_4K
                }
            }
        }
    }

    // Pass 4: Map `kind == 2` (`WC GOP + NX` via `IA32_PAT` `PA1`)
    for i in 0..ranges.len {
        r := ranges[i]
        if r.kind == 2 {
            addr: u64 = r.phys & ADDR_MASK_4K
            end_addr: u64 = r.phys + r.byte_len
            loop <max: 65536 | until: addr >= end_addr> {
                rem: u64 = end_addr - addr
                did_2m: u64 = 0
                if (addr & (PAGE_2M - 1)) == 0 && rem >= PAGE_2M {
                    did_2m = map_2m_huge(addr, PTE_WC_NX)
                    if did_2m == 1 {
                        addr += PAGE_2M
                    }
                }
                if did_2m == 0 {
                    map_4k_page(addr, PTE_WC_NX, 1)
                    addr += PAGE_4K
                }
            }
        }
    }

    return pt_pool.base
}

// Walks every present leaf entry (`1GiB`, `2MiB`, `4KiB`) and halts if ANY page is `W+X`
fn verify_no_wx_pages() u64 {
    wx_hits: u64 = 0
    for i0 in 0..512 {
        pml4e: u64 = pt_pool[i0]
        if (pml4e & 1) != 0 {
            pdpt_pg: u64 = ((pml4e & ADDR_MASK_4K) - pt_pool.base) / PAGE_4K
            for i1 in 0..512 {
                pdpte: u64 = pt_pool[pdpt_pg * 512 + i1]
                if (pdpte & 1) != 0 {
                    if (pdpte & PDE_PS) != 0 {
                        if (pdpte & 2) != 0 && (pdpte >> 63) == 0 {
                            wx_hits += 1
                        }
                    } else {
                        pd_pg: u64 = ((pdpte & ADDR_MASK_4K) - pt_pool.base) / PAGE_4K
                        for i2 in 0..512 {
                            pde: u64 = pt_pool[pd_pg * 512 + i2]
                            if (pde & 1) != 0 {
                                if (pde & PDE_PS) != 0 {
                                    if (pde & 2) != 0 && (pde >> 63) == 0 {
                                        wx_hits += 1
                                    }
                                } else {
                                    pt_pg: u64 = ((pde & ADDR_MASK_4K) - pt_pool.base) / PAGE_4K
                                    for i3 in 0..512 {
                                        pte: u64 = pt_pool[pt_pg * 512 + i3]
                                        if (pte & 1) != 0 && (pte & 2) != 0 && (pte >> 63) == 0 {
                                            wx_hits += 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if wx_hits != 0 {
        @halt()
    }
    return wx_hits
}

fn setup_gdt_and_tss() i64 {
    tss := @view<Tss64>(tss_slab.base)
    tss.rsp0 = rsp0_slab.base + 16384
    tss.iomap_base = @sizeof(Tss64)

    tss_base: u64 = tss_slab.base
    tss_lo: u64 = TSS_LIMIT
    tss_lo |= (tss_base & 0xFFFFFF) << 16
    tss_lo |= 0x89 << 40
    tss_lo |= ((tss_base >> 24) & 0xFF) << 56
    tss_hi: u64 = tss_base >> 32

    gdt_slab[0] = 0
    gdt_slab[1] = 0x00AF9A000000FFFF
    gdt_slab[2] = 0x00CF92000000FFFF
    gdt_slab[3] = tss_lo
    gdt_slab[4] = tss_hi

    @lgdt(gdt_slab.base, 39)
    @ltr(0x18)
    return 0
}

fn setup_idt() i64 {
    stubs: u64 = @isr_stub_base()
    u_sel: u64 = 0x0008
    u_attr: u64 = 0x8E00
    for v in 0..256 {
        uv: u64 = v
        fn_addr: u64 = stubs + uv * 16
        lo: u64 = (fn_addr & 0xFFFF) | (u_sel << 16) | (u_attr << 32) | (((fn_addr >> 16) & 0xFFFF) << 48)
        hi: u64 = fn_addr >> 32
        idt_slab[uv * 2]     = lo
        idt_slab[uv * 2 + 1] = hi
    }
    @lidt(idt_slab.base, 4095)
    return 0
}

fn verify_acpi_post_cr3(handoff: @BootHandoff) u64 {
    if handoff.rsdp == 0 || handoff.madt == 0 {
        return 0
    }
    rsdp := @view<AcpiRsdp>(handoff.rsdp)
    if rsdp.signature != RSDP_MAGIC {
        return 0
    }
    madt := @view<AcpiSdtHeader>(handoff.madt)
    if madt.signature != MADT_SIG {
        return 0
    }
    return 1
}

// Deterministic `(x, y)` pixel function (`fmt == 0`: BGRX8888, `fmt == 1`: RGBX8888)
fn expected_pixel(x: u64, y: u64, fmt: u64) u32 {
    b: u64 = x & 0xFF
    g: u64 = (y * 3 + (x >> 2)) & 0xFF
    r: u64 = (x ^ y) & 0xFF
    if fmt == 1 {
        px_rgbx: u32 = r | (g << 8) | (b << 16)
        return px_rgbx
    }
    px_bgrx: u32 = b | (g << 8) | (r << 16)
    return px_bgrx
}

fn pack_rgb(r: u64, g: u64, b: u64, fmt: u64) u32 {
    if fmt == 1 {
        c1: u32 = (r & 0xFF) | ((g & 0xFF) << 8) | ((b & 0xFF) << 16)
        return c1
    }
    c0: u32 = (b & 0xFF) | ((g & 0xFF) << 8) | ((r & 0xFF) << 16)
    return c0
}

fn draw_rect_safe(handoff: @BootHandoff, x0: u64, y0: u64, rw: u64, rh: u64, color: u32) i64 {
    w: u64 = handoff.gop_width
    h: u64 = handoff.gop_height
    stride_px: u64 = handoff.gop_stride / 4
    if x0 + rw > w || y0 + rh > h {
        return 0
    }
    fb := @mmio<u32>(handoff.gop_base, h * stride_px)
    for dy in 0..rh {
        row: u64 = (y0 + dy) * stride_px
        for dx in 0..rw {
            fb[row + x0 + dx] = color
        }
    }
    return 0
}

fn draw_led(handoff: @BootHandoff, slot: u64, r: u64, g: u64, b: u64) i64 {
    c: u32 = pack_rgb(r, g, b, handoff.gop_format)
    return draw_rect_safe(handoff, 32 + slot * 24, 8, 16, 12, c)
}

fn paint_scancode_cell(handoff: @BootHandoff, sc: u64) i64 {
    c: u32 = pack_rgb(sc ^ 0xA5, 0xFF, sc, handoff.gop_format)
    return draw_rect_safe(handoff, 32, 32, 32, 32, c)
}

fn main(handoff: @BootHandoff) i64 {
    // 1. Mask interrupts immediately & validate typed BootHandoff contract
    @cli()

    if @sizeof(Tss64) != 104 || handoff.magic != HANDOFF_MAGIC || handoff.version != 1 {
        @halt()
    }
    if handoff.gop_format > 1 || handoff.gop_base == 0 || handoff.gop_width == 0 || handoff.gop_height == 0 {
        @halt()
    }
    if handoff.gop_stride < handoff.gop_width * 4 {
        @halt()
    }
    if handoff.code_base == 0 || handoff.code_bytes == 0 || handoff.map == 0 {
        @halt()
    }

    // 2. Load 4-entry GDT + packed Tss64 (`@lgdt` + `@ltr`)
    setup_gdt_and_tss()

    // 3. Enable CR0 + CR4 (`OSFXSR | OSXMMEXCPT | FSGSBASE | PCIDE | OSXSAVE | PKE`), zero `PKRU`, unlock `XCR0 = 0xE7`
    cr0: u64 = @cr_read(0)
    u_em_mask: u64 = 4
    @cr_write(0, (cr0 & ~u_em_mask) | 0x10022)

    uefi_cr3: u64 = @cr_read(3)
    if (uefi_cr3 & 0xFFF) != 0 {
        @cr_write(3, uefi_cr3 & ADDR_MASK_4K)
    }

    cr4: u64 = @cr_read(4)
    @cr_write(4, cr4 | 0x470600)
    @wrpkru(0)
    @xsetbv(0, 0xE7)

    // 4. Enable `IA32_EFER.NXE`, program `IA32_PAT` (`PA1 = WC`), build & verify W^X `CR3`
    efer: u64 = @msr_read(IA32_EFER_MSR)
    @msr_write(IA32_EFER_MSR, efer | 0x800)
    @msr_write(IA32_PAT_MSR, PAT_PA1_WC_VALUE)

    uw: u64 = handoff.gop_width
    uh: u64 = handoff.gop_height
    ustride: u64 = handoff.gop_stride
    ufmt: u64 = handoff.gop_format
    stride_px: u64 = ustride / 4

    gop_end: u64 = handoff.gop_base + uh * ustride
    ranges := @view<MemRange>(handoff.map, handoff.map_count)
    for mi in 0..ranges.len {
        mr := ranges[mi]
        if mr.kind == 2 {
            gop_end = mr.phys + mr.byte_len
        }
    }

    new_cr3: u64 = build_wx_pagetables(handoff, gop_end)
    wx_hits: u64 = verify_no_wx_pages()
    @cr_write(3, new_cr3)

    // 5. Verify ACPI tables remain readable (RO + NX) post-CR3 & test IDT + `recover` (`fail 2`, `fail 3`)
    acpi_ok: u64 = verify_acpi_post_cr3(handoff)
    if acpi_ok != 1 {
        @halt()
    }
    setup_idt()

    caught_oob: u64 = 0
    oob_idx: u64 = 999
    {
        _oob := ranges[oob_idx].kind
    } recover err2 {
        caught_oob = err2
    }
    if caught_oob != 2 {
        @halt()
    }

    caught_null: u64 = 0
    {
        _nv := @view<AcpiRsdp>(0)
    } recover err3 {
        caught_null = err3
    }
    if caught_null != 3 {
        @halt()
    }

    // 6. Stride-sensitive `(x, y)` GOP paint via bounded `@mmio<u32>` + corner readback
    fb := @mmio<u32>(handoff.gop_base, uh * stride_px)
    for y in 0..uh {
        uy: u64 = y
        row_px: u64 = uy * stride_px
        for x in 0..uw {
            ux: u64 = x
            fb[row_px + ux] = expected_pixel(ux, uy, ufmt)
        }
    }

    p00: u32   = fb[0]
    p10: u32   = fb[stride_px + 10]
    plast: u32 = fb[(uh - 1) * stride_px + (uw - 1)]
    if p00 != expected_pixel(0, 0, ufmt) || p10 != expected_pixel(10, 1, ufmt) || plast != expected_pixel(uw - 1, uh - 1, ufmt) {
        @halt()
    }

    // Draw top-bar boot checkpoint LEDs (clear of sampled corners/scancode cell)
    draw_led(handoff, 0, 0x00, 0xE5, 0xFF)
    draw_led(handoff, 1, 0x29, 0x79, 0xFF)
    draw_led(handoff, 2, 0xFF, 0xD6, 0x00)
    draw_led(handoff, 3, 0xFF, 0x6D, 0x00)

    // Emit fixed `0xE9` telemetry banner (completely compiled out when `qemu_debug :: 0`)
    if qemu_debug == 1 {
        dbg_putc('Z')
        dbg_putc('E')
        dbg_putc('R')
        dbg_putc('O')
        dbg_putc('H')
        dbg_putc('A')
        dbg_putc('N')
        dbg_putc('D')
        dbg_putc(' ')
        dbg_putc('W')
        dbg_putc('=')
        dbg_u32_dec(uw)
        dbg_putc(' ')
        dbg_putc('H')
        dbg_putc('=')
        dbg_u32_dec(uh)
        dbg_putc(' ')
        dbg_putc('S')
        dbg_putc('=')
        dbg_u32_dec(ustride)
        dbg_putc(' ')
        dbg_putc('F')
        dbg_putc('=')
        dbg_u32_dec(ufmt)
        dbg_putc(' ')
        dbg_putc('C')
        dbg_putc('=')
        dbg_u32_dec(handoff.core_count)
        dbg_putc(' ')
        dbg_putc('M')
        dbg_putc('=')
        dbg_u32_dec(handoff.map_count)
        dbg_putc(' ')
        dbg_putc('P')
        dbg_putc('T')
        dbg_putc('=')
        dbg_u32_dec(pt_state[0])
        dbg_putc(' ')
        dbg_putc('W')
        dbg_putc('X')
        dbg_putc('=')
        dbg_u32_dec(wx_hits)
        dbg_putc(' ')
        dbg_putc('A')
        dbg_putc('C')
        dbg_putc('P')
        dbg_putc('I')
        dbg_putc('=')
        dbg_u32_dec(acpi_ok)
        dbg_putc(' ')
        dbg_putc('K')
        dbg_putc('B')
        dbg_putc('D')
        dbg_putc(10)
    }

    // 7. Drain residual i8042 byte, poll `kbd_status` bit 0, read `kbd_data`
    loop <max: 16 | until: (kbd_status.read() & 1) == 0> {
        _discard: u8 = kbd_data.read()
    }

    got_make: u64 = 0
    make_sc: u64 = 0
    if qemu_debug == 1 {
        loop <max: 20000000000 | until: got_make == 1> {
            st: u8 = kbd_status.read()
            if (st & 1) != 0 {
                sc: u8 = kbd_data.read()
                if sc > 0 && sc < 0x80 {
                    make_sc = sc
                    got_make = 1
                }
            }
        }
    } else {
        loop <max: 1000000000000 | until: got_make == 1> {
            st: u8 = kbd_status.read()
            if (st & 1) != 0 {
                sc: u8 = kbd_data.read()
                if sc > 0 && sc < 0x80 {
                    make_sc = sc
                    got_make = 1
                }
            }
        }
    }

    if got_make == 1 {
        draw_led(handoff, 4, 0x00, 0xE6, 0x76)
        paint_scancode_cell(handoff, make_sc)
        if qemu_debug == 1 {
            dbg_putc('S')
            dbg_putc('C')
            dbg_putc('A')
            dbg_putc('N')
            dbg_putc('=')
            dbg_hex32(make_sc)
            dbg_putc(' ')
            dbg_putc('G')
            dbg_putc('A')
            dbg_putc('T')
            dbg_putc('E')
            dbg_putc('1')
            dbg_putc('A')
            dbg_putc('_')
            dbg_putc('O')
            dbg_putc('K')
            dbg_putc(10)
        }
    }

    // 8. Halt BSP permanently (`cli; hlt; jmp`)
    @halt()
    return 0
}
