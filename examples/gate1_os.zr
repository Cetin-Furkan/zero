// =============================================================================
// ZeroOS Gate-1b Modular Bare-Metal UEFI Entry (`examples/gate1_os.zr`)
// =============================================================================
// Set `qemu_debug :: 0` for physical laptop media without port `0xE9` (§8.5)
qemu_debug :: 1

use "os/hw_types.zr"
use "os/debug_io.zr"
use "os/paging_wx.zr"
use "os/reactor_fabric.zr"
use "os/smp_madt.zr"
use "os/nvme_capsule.zr"
use "os/hud_render.zr"

fn main(handoff: @BootHandoff) i64 {
    // 1. Mask interrupts & validate typed BootHandoff contract
    @cli()

    if @sizeof(Tss64) != 104 || @sizeof(BootHandoff) != 128 || handoff.magic != HANDOFF_MAGIC || handoff.version != 1 {
        @halt()
    }
    if handoff.gop_format > 1 || handoff.gop_base == 0 || handoff.gop_width == 0 || handoff.gop_height == 0 {
        @halt()
    }
    if handoff.gop_stride < handoff.gop_width * 4 || handoff.code_base == 0 || handoff.code_bytes == 0 || handoff.map == 0 {
        @halt()
    }

    // 2. Load BSP (`slot 0`) GDT + packed `Tss64` (`@lgdt` + `@ltr`)
    setup_core_gdt_and_tss(0)

    // 3. Enable CR0 + CR4 (`OSFXSR | OSXMMEXCPT | FSGSBASE | PCIDE | OSXSAVE | PKE`), `PKRU=0`, `XCR0=0xE7`
    cr0: u64 = @cr_read(0)
    u_em_mask: u64 = 4
    @cr_write(0, (cr0 & ~u_em_mask) | 0x10022)

    uefi_cr3: u64 = @cr_read(3)
    if uefi_cr3[11:0] != 0 {
        @cr_write(3, uefi_cr3 |> align4k)
    }

    cr4: u64 = @cr_read(4)
    @cr_write(4, cr4 | 0x470600)
    @wrpkru(0)
    @xsetbv(0, 0xE7)

    // 4. Enable `IA32_EFER.NXE`, program `IA32_PAT` (`PA1 = WC`), build & verify W^X `CR3` via `@PtePtr`
    efer: u64 = @msr_read(IA32_EFER_MSR)
    @msr_write(IA32_EFER_MSR, efer | 0x800)
    @msr_write(IA32_PAT_MSR, PAT_PA1_WC_VALUE)

    uw: u64      = handoff.gop_width
    uh: u64      = handoff.gop_height
    ustride: u64 = handoff.gop_stride
    ufmt: u64    = handoff.gop_format

    gop_end: u64 = handoff.gop_base + uh * ustride
    ranges := @view<MemRange>(handoff.map, handoff.map_count)
    for mr in ranges {
        if mr.kind == 2 {
            gop_end = mr.phys + mr.byte_len
        }
    }

    new_cr3: u64 = build_wx_pagetables(handoff, gop_end)
    wx_hits: u64 = verify_no_wx_pages()

    // Stamp read-only AP trampoline boot vector BEFORE activating hardware W^X `new_cr3`
    handoff.ap_release = ap_mbox.base + 32
    ap_mbox[4] = 0
    if handoff.ap_trampoline != 0 && handoff.ap_stack_base != 0 {
        tramp_params := @mmio<u64>(handoff.ap_trampoline + 0x138, 3)
        tramp_params[0] = new_cr3
        tramp_params[1] = @fn_addr(ap_main)
        tramp_params[2] = ap_mbox.base
    }

    @cr_write(3, new_cr3)

    // 5. Verify ACPI post-CR3, install IDT, test `recover` (`fail 2`, `fail 3`), & wake MADT APs!
    acpi_ok: u64 = verify_acpi_post_cr3(handoff)
    if acpi_ok != 1 {
        @halt()
    }
    setup_idt()

    caught_oob: u64 = 0
    oob_idx: u64 = 999
    {
        _oob := ranges[oob_idx].kind
    } recover err2 {
        caught_oob = err2
    }
    caught_null: u64 = 0
    {
        _nv := @view<AcpiRsdp>(0)
    } recover err3 {
        caught_null = err3
    }
    if caught_oob != 2 || caught_null != 3 {
        @halt()
    }

    online_cores:  u64 = bring_up_madt_cores(handoff)
    fabric_cycles: u64 = run_reactor_fabric(online_cores)
    cap_val:       u64 = probe_and_exec_nvme_capsule(handoff)

    // Recheck hardware W^X page tables AFTER dynamic NVMe `@capsule` sealing!
    wx_hits = verify_no_wx_pages()

    // 6. Non-temporal `movnti` GOP paint + checkpoint LEDs + per-core pips + live `rdtsc`/`CAP` HUD!
    stream_paint_gop(handoff)
    draw_led(handoff, 0, 0x00, 0xE5, 0xFF)
    draw_led(handoff, 1, 0x29, 0x79, 0xFF)
    draw_led(handoff, 2, 0xFF, 0xD6, 0x00)
    draw_led(handoff, 3, 0xFF, 0x6D, 0x00)
    if cap_val != 0 {
        draw_led(handoff, 5, 0xE0, 0x66, 0xFF)
    }
    for ci in 0..online_cores {
        uci: u64 = ci
        draw_core_pip(handoff, uci)
    }
    draw_status_hud(handoff, online_cores, fabric_cycles, cap_val)

    // 7. Emit `0xE9` telemetry banner (`elided when qemu_debug :: 0`)
    if qemu_debug == 1 {
        dbg_str("ZEROHAND W=")
        dbg_u32_dec(uw)
        dbg_str(" H=")
        dbg_u32_dec(uh)
        dbg_str(" S=")
        dbg_u32_dec(ustride)
        dbg_str(" F=")
        dbg_u32_dec(ufmt)
        dbg_str(" C=")
        dbg_u32_dec(handoff.core_count)
        dbg_str(" M=")
        dbg_u32_dec(handoff.map_count)
        dbg_str(" PT=")
        dbg_u32_dec(pt_state[0])
        dbg_str(" WX=")
        dbg_u32_dec(wx_hits)
        dbg_str(" ACPI=")
        dbg_u32_dec(acpi_ok)
        dbg_str(" GS=1 FAB=1 CYC=")
        dbg_u32_dec(fabric_cycles)
        dbg_str(" CAP=")
        dbg_u32_dec(cap_val)
        dbg_str(" KBD\n")
    }

    // 8. Drain residual i8042 byte, poll `kbd_status` bit 0, read `kbd_data`
    loop <max: 16 | until: kbd_status.read()[0:0] == 0> {
        _discard: u8 = kbd_data.read()
    }

    got_make: u64 = 0
    make_sc:  u64 = 0
    if qemu_debug == 1 {
        loop <max: 80000000 | until: got_make == 1> {
            if kbd_status.read()[0:0] != 0 {
                sc: u8 = kbd_data.read()
                if sc > 0 && sc < 0x80 {
                    make_sc = sc
                    got_make = 1
                }
            }
        }
    } else {
        loop <max: 1000000000000 | until: got_make == 1> {
            if kbd_status.read()[0:0] != 0 {
                sc: u8 = kbd_data.read()
                if sc > 0 && sc < 0x80 {
                    make_sc = sc
                    got_make = 1
                }
            }
        }
    }

    if got_make == 1 {
        draw_led(handoff, 4, 0x00, 0xE6, 0x76)
        paint_scancode_cell(handoff, make_sc)
        if qemu_debug == 1 {
            dbg_str("SCAN=")
            dbg_hex32(make_sc)
            dbg_str(" GATE1B_OK\n")
        }
    }

    @halt()
    return 0
}
