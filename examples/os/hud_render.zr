// =============================================================================
// ZeroOS Non-Temporal `movnti` / `vmovntdq` Scanout & Obsidian Command Deck (`os/hud_render.zr`)
// =============================================================================
use "hw_types.zr"
use "hw_domains.zr"
use "zerofs_ledger.zr"

// Complete 5x7 binary bitmap font packed into 35-bit `u64` constants (`row 0` in `[34:30]`)
GLYPH_A :: (0b01110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b11111 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b10001
GLYPH_B :: (0b11110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b11110 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b11110
GLYPH_C :: (0b01110 << 30) | (0b10001 << 25) | (0b10000 << 20) | (0b10000 << 15) | (0b10000 << 10) | (0b10001 << 5) | 0b01110
GLYPH_D :: (0b11110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b10001 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b11110
GLYPH_E :: (0b11111 << 30) | (0b10000 << 25) | (0b10000 << 20) | (0b11110 << 15) | (0b10000 << 10) | (0b10000 << 5) | 0b11111
GLYPH_F :: (0b11111 << 30) | (0b10000 << 25) | (0b10000 << 20) | (0b11110 << 15) | (0b10000 << 10) | (0b10000 << 5) | 0b10000
GLYPH_G :: (0b01110 << 30) | (0b10001 << 25) | (0b10000 << 20) | (0b10111 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b01110
GLYPH_H :: (0b10001 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b11111 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b10001
GLYPH_I :: (0b01110 << 30) | (0b00100 << 25) | (0b00100 << 20) | (0b00100 << 15) | (0b00100 << 10) | (0b00100 << 5) | 0b01110
GLYPH_J :: (0b00111 << 30) | (0b00010 << 25) | (0b00010 << 20) | (0b00010 << 15) | (0b10010 << 10) | (0b10010 << 5) | 0b01100
GLYPH_K :: (0b10001 << 30) | (0b10010 << 25) | (0b10100 << 20) | (0b11000 << 15) | (0b10100 << 10) | (0b10010 << 5) | 0b10001
GLYPH_L :: (0b10000 << 30) | (0b10000 << 25) | (0b10000 << 20) | (0b10000 << 15) | (0b10000 << 10) | (0b10000 << 5) | 0b11111
GLYPH_M :: (0b10001 << 30) | (0b11011 << 25) | (0b10101 << 20) | (0b10101 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b10001
GLYPH_N :: (0b10001 << 30) | (0b11001 << 25) | (0b10101 << 20) | (0b10011 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b10001
GLYPH_O :: (0b01110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b10001 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b01110
GLYPH_P :: (0b11110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b11110 << 15) | (0b10000 << 10) | (0b10000 << 5) | 0b10000
GLYPH_Q :: (0b01110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b10001 << 15) | (0b10101 << 10) | (0b10010 << 5) | 0b01101
GLYPH_R :: (0b11110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b11110 << 15) | (0b10100 << 10) | (0b10010 << 5) | 0b10001
GLYPH_S :: (0b01111 << 30) | (0b10000 << 25) | (0b10000 << 20) | (0b01110 << 15) | (0b00001 << 10) | (0b00001 << 5) | 0b11110
GLYPH_T :: (0b11111 << 30) | (0b00100 << 25) | (0b00100 << 20) | (0b00100 << 15) | (0b00100 << 10) | (0b00100 << 5) | 0b00100
GLYPH_U :: (0b10001 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b10001 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b01110
GLYPH_V :: (0b10001 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b10001 << 15) | (0b10001 << 10) | (0b01010 << 5) | 0b00100
GLYPH_W :: (0b10001 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b10101 << 15) | (0b10101 << 10) | (0b11011 << 5) | 0b10001
GLYPH_X :: (0b10001 << 30) | (0b01010 << 25) | (0b00100 << 20) | (0b00100 << 15) | (0b00100 << 10) | (0b01010 << 5) | 0b10001
GLYPH_Y :: (0b10001 << 30) | (0b10001 << 25) | (0b01010 << 20) | (0b00100 << 15) | (0b00100 << 10) | (0b00100 << 5) | 0b00100
GLYPH_Z :: (0b11111 << 30) | (0b00001 << 25) | (0b00010 << 20) | (0b00100 << 15) | (0b01000 << 10) | (0b10000 << 5) | 0b11111

GLYPH_0 :: (0b01110 << 30) | (0b10011 << 25) | (0b10101 << 20) | (0b10101 << 15) | (0b11001 << 10) | (0b10001 << 5) | 0b01110
GLYPH_1 :: (0b00100 << 30) | (0b01100 << 25) | (0b00100 << 20) | (0b00100 << 15) | (0b00100 << 10) | (0b00100 << 5) | 0b01110
GLYPH_2 :: (0b01110 << 30) | (0b10001 << 25) | (0b00001 << 20) | (0b00110 << 15) | (0b01000 << 10) | (0b10000 << 5) | 0b11111
GLYPH_3 :: (0b11110 << 30) | (0b00001 << 25) | (0b00001 << 20) | (0b01110 << 15) | (0b00001 << 10) | (0b00001 << 5) | 0b11110
GLYPH_4 :: (0b00010 << 30) | (0b00110 << 25) | (0b01010 << 20) | (0b10010 << 15) | (0b11111 << 10) | (0b00010 << 5) | 0b00010
GLYPH_5 :: (0b11111 << 30) | (0b10000 << 25) | (0b11110 << 20) | (0b00001 << 15) | (0b00001 << 10) | (0b10001 << 5) | 0b01110
GLYPH_6 :: (0b01110 << 30) | (0b10000 << 25) | (0b11110 << 20) | (0b10001 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b01110
GLYPH_7 :: (0b11111 << 30) | (0b00001 << 25) | (0b00010 << 20) | (0b00100 << 15) | (0b01000 << 10) | (0b01000 << 5) | 0b01000
GLYPH_8 :: (0b01110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b01110 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b01110
GLYPH_9 :: (0b01110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b01111 << 15) | (0b00001 << 10) | (0b00001 << 5) | 0b01110

GLYPH_COL  :: (0b00000 << 30) | (0b00100 << 25) | (0b00100 << 20) | (0b00000 << 15) | (0b00100 << 10) | (0b00100 << 5) | 0b00000
GLYPH_SL   :: (0b00001 << 30) | (0b00010 << 25) | (0b00010 << 20) | (0b00100 << 15) | (0b01000 << 10) | (0b01000 << 5) | 0b10000
GLYPH_DASH :: (0b00000 << 30) | (0b00000 << 25) | (0b00000 << 20) | (0b11111 << 15) | (0b00000 << 10) | (0b00000 << 5) | 0b00000
GLYPH_DOT  :: (0b00000 << 30) | (0b00000 << 25) | (0b00000 << 20) | (0b00000 << 15) | (0b00000 << 10) | (0b00110 << 5) | 0b00110
GLYPH_GT   :: (0b10000 << 30) | (0b01000 << 25) | (0b00100 << 20) | (0b00010 << 15) | (0b00100 << 10) | (0b01000 << 5) | 0b10000
GLYPH_LBR  :: (0b01110 << 30) | (0b01000 << 25) | (0b01000 << 20) | (0b01000 << 15) | (0b01000 << 10) | (0b01000 << 5) | 0b01110
GLYPH_RBR  :: (0b01110 << 30) | (0b00010 << 25) | (0b00010 << 20) | (0b00010 << 15) | (0b00010 << 10) | (0b00010 << 5) | 0b01110
GLYPH_UND  :: (0b00000 << 30) | (0b00000 << 25) | (0b00000 << 20) | (0b00000 << 15) | (0b00000 << 10) | (0b00000 << 5) | 0b11111
GLYPH_PLUS :: (0b00000 << 30) | (0b00100 << 25) | (0b00100 << 20) | (0b11111 << 15) | (0b00100 << 10) | (0b00100 << 5) | 0b00000
GLYPH_EQ   :: (0b00000 << 30) | (0b00000 << 25) | (0b11111 << 20) | (0b00000 << 15) | (0b11111 << 10) | (0b00000 << 5) | 0b00000

fn expected_pixel(x: u64, y: u64, fmt: u64) u32 {
    b: u64 = x[7:0]
    g: u64 = (y * 3 + (x >> 2))[7:0]
    r: u64 = (x ^ y)[7:0]
    if fmt == 1 {
        px_rgbx: u32 = r | (g << 8) | (b << 16)
        return px_rgbx
    }
    px_bgrx: u32 = b | (g << 8) | (r << 16)
    return px_bgrx
}

fn pack_rgb(r: u64, g: u64, b: u64, fmt: u64) u32 {
    if fmt == 1 {
        c1: u32 = r[7:0] | (g[7:0] << 8) | (b[7:0] << 16)
        return c1
    }
    c0: u32 = b[7:0] | (g[7:0] << 8) | (r[7:0] << 16)
    return c0
}

// 512-bit `AVX-512` (`u32x16` + `@vec_stream` `vmovntdq zmm`) Ring-0 `<tile>` GOP scanout + `@sfence()`
fn stream_paint_gop(handoff: @BootHandoff) i64 {
    uw: u64 = handoff.gop_width
    uh: u64 = handoff.gop_height
    ufmt: u64 = handoff.gop_format
    stride_bytes: u64 = handoff.gop_stride
    stride_px: u64 = stride_bytes / 4
    vec_chunks: u64 = uw >> 4
    rem_px: u64 = uw & 15

    tile {
        iota: u32x16  = @vec_iota32()
        mask8: u32x16 = @vec_splat32(0xFF)

        for y in 0..uh {
            uy: u64 = y
            row_addr: u64 = handoff.gop_base + uy * stride_bytes
            vy: u32x16  = @vec_splat32(uy)
            vy3: u32x16 = @vec_splat32(uy * 3)

            for cx in 0..vec_chunks {
                ucx: u64 = cx
                base_x: u64 = ucx << 4
                dst_addr: u64 = row_addr + (ucx << 6)

                vx: u32x16 = @vec_splat32(base_x) + iota
                vb: u32x16 = vx & mask8
                vg: u32x16 = (vy3 + (vx >> 2)) & mask8
                vr: u32x16 = (vx ^ vy) & mask8

                vpx: u32x16 = vb | (vg << 8) | (vr << 16)
                if ufmt == 1 {
                    vpx = vr | (vg << 8) | (vb << 16)
                }

                if (dst_addr & 63) == 0 {
                    @vec_stream(dst_addr, vpx)
                } else {
                    @vec_store32(dst_addr, vpx)
                }
            }

            if rem_px != 0 {
                tail_x: u64 = vec_chunks << 4
                tail_addr: u64 = row_addr + (vec_chunks << 6)
                vx_t: u32x16 = @vec_splat32(tail_x) + iota
                vb_t: u32x16 = vx_t & mask8
                vg_t: u32x16 = (vy3 + (vx_t >> 2)) & mask8
                vr_t: u32x16 = (vx_t ^ vy) & mask8
                vpx_t: u32x16 = vb_t | (vg_t << 8) | (vr_t << 16)
                if ufmt == 1 {
                    vpx_t = vr_t | (vg_t << 8) | (vb_t << 16)
                }
                @vec_store32(tail_addr, vpx_t, rem_px)
            }
        }
    }
    @sfence()

    fb := @mmio<u32>(handoff.gop_base, uh * stride_px)
    if fb[0] != expected_pixel(0, 0, ufmt) || fb[stride_px + 10] != expected_pixel(10, 1, ufmt) || fb[(uh - 1) * stride_px + (uw - 1)] != expected_pixel(uw - 1, uh - 1, ufmt) {
        @halt()
    }
    return 0
}

fn draw_rect_safe(handoff: @BootHandoff, x0: u64, y0: u64, rw: u64, rh: u64, color: u32) i64 {
    w: u64 = handoff.gop_width
    h: u64 = handoff.gop_height
    stride_px: u64 = handoff.gop_stride / 4
    if x0 + rw > w || y0 + rh > h {
        return 0
    }
    fb := @mmio<u32>(handoff.gop_base, h * stride_px)
    for dy in 0..rh {
        row: u64 = (y0 + dy) * stride_px
        for dx in 0..rw {
            fb[row + x0 + dx] = color
        }
    }
    return 0
}

fn draw_led(handoff: @BootHandoff, slot: u64, r: u64, g: u64, b: u64) i64 =>
    draw_rect_safe(handoff, 32 + slot * 24, 8, 16, 12, pack_rgb(r, g, b, handoff.gop_format))

fn draw_core_pip(handoff: @BootHandoff, core_idx: u64) i64 =>
    draw_rect_safe(handoff, 200 + core_idx * 16, 8, 12, 12, pack_rgb(0x00, 0xFF, 0xAA, handoff.gop_format))

fn paint_scancode_cell(handoff: @BootHandoff, sc: u64) i64 =>
    draw_rect_safe(handoff, 32, 32, 32, 32, pack_rgb(sc ^ 0xA5, 0xFF, sc, handoff.gop_format))

fn glyph_for_char(ch: u8) u64 {
    g: u64 = 0
    match ch {
        'A' => g = GLYPH_A
        'B' => g = GLYPH_B
        'C' => g = GLYPH_C
        'D' => g = GLYPH_D
        'E' => g = GLYPH_E
        'F' => g = GLYPH_F
        'G' => g = GLYPH_G
        'H' => g = GLYPH_H
        'I' => g = GLYPH_I
        'J' => g = GLYPH_J
        'K' => g = GLYPH_K
        'L' => g = GLYPH_L
        'M' => g = GLYPH_M
        'N' => g = GLYPH_N
        'O' => g = GLYPH_O
        'P' => g = GLYPH_P
        'Q' => g = GLYPH_Q
        'R' => g = GLYPH_R
        'S' => g = GLYPH_S
        'T' => g = GLYPH_T
        'U' => g = GLYPH_U
        'V' => g = GLYPH_V
        'W' => g = GLYPH_W
        'X' => g = GLYPH_X
        'Y' => g = GLYPH_Y
        'Z' => g = GLYPH_Z
        '0' => g = GLYPH_0
        '1' => g = GLYPH_1
        '2' => g = GLYPH_2
        '3' => g = GLYPH_3
        '4' => g = GLYPH_4
        '5' => g = GLYPH_5
        '6' => g = GLYPH_6
        '7' => g = GLYPH_7
        '8' => g = GLYPH_8
        '9' => g = GLYPH_9
        ':' => g = GLYPH_COL
        '/' => g = GLYPH_SL
        '-' => g = GLYPH_DASH
        '.' => g = GLYPH_DOT
        '>' => g = GLYPH_GT
        '[' => g = GLYPH_LBR
        ']' => g = GLYPH_RBR
        '_' => g = GLYPH_UND
        '+' => g = GLYPH_PLUS
        '=' => g = GLYPH_EQ
        _   => g = 0
    }
    return g
}

fn draw_glyph_2x(handoff: @BootHandoff, x0: u64, y0: u64, ch: u8, color: u32) i64 {
    bits: u64 = glyph_for_char(ch)
    if bits == 0 {
        return 0
    }
    for gy in 0..7 {
        ugy: u64 = gy
        for gx in 0..5 {
            ugx: u64 = gx
            sh: u64 = (6 - ugy) * 5 + (4 - ugx)
            if ((bits >> sh) & 1) != 0 {
                draw_rect_safe(handoff, x0 + ugx * 2, y0 + ugy * 2, 2, 2, color)
            }
        }
    }
    return 0
}

fn draw_hud_text(handoff: @BootHandoff, x0: u64, y0: u64, label: str, color: u32) i64 {
    for idx, ch in label {
        draw_glyph_2x(handoff, x0 + idx * 12, y0, ch, color)
    }
    return 0
}

fn draw_deck_text(handoff: @BootHandoff, x0: u64, y0: u64, label: str, color: u32) u64 {
    for idx, ch in label {
        draw_glyph_2x(handoff, x0 + idx * 11, y0, ch, color)
    }
    return x0 + label.len * 11
}

fn draw_hud_u32(handoff: @BootHandoff, x0: u64, y0: u64, val: u64, color: u32) i64 {
    if val == 0 {
        draw_glyph_2x(handoff, x0, y0, '0', color)
        return 0
    }
    div_u: u64 = 1000000
    v: u64 = val
    if v > 9999999 {
        v = 9999999
    }
    started: u64 = 0
    pos: u64 = 0
    loop <max: 7 | until: div_u == 0> {
        dig: u64 = v / div_u
        v %= div_u
        if dig != 0 || started == 1 {
            ch_d: u8 = 48 + dig
            draw_glyph_2x(handoff, x0 + pos * 12, y0, ch_d, color)
            pos += 1
            started = 1
        }
        div_u /= 10
    }
    return 0
}

// Renders decimal when `val <= 999999999`, or `0X` + 8-hex-digit folded digest for wide 64-bit returns!
fn draw_deck_val(handoff: @BootHandoff, x0: u64, y0: u64, val: u64, color: u32) u64 {
    if val == 0 {
        draw_glyph_2x(handoff, x0, y0, '0', color)
        return x0 + 11
    }
    if val <= 999999999 {
        div_u: u64 = 100000000
        v: u64 = val
        started: u64 = 0
        pos: u64 = 0
        loop <max: 9 | until: div_u == 0> {
            dig: u64 = v / div_u
            v %= div_u
            if dig != 0 || started == 1 {
                ch_d: u8 = 48 + dig
                draw_glyph_2x(handoff, x0 + pos * 11, y0, ch_d, color)
                pos += 1
                started = 1
            }
            div_u /= 10
        }
        return x0 + pos * 11
    }

    cx: u64 = draw_deck_text(handoff, x0, y0, "0X", color)
    folded: u64 = val ^ (val >> 32)
    for nib_i in 0..8 {
        un: u64 = nib_i
        sh: u64 = (7 - un) * 4
        nib: u64 = (folded >> sh) & 15
        hex_ch: u8 = "0123456789ABCDEF"[nib]
        draw_glyph_2x(handoff, cx + un * 11, y0, hex_ch, color)
    }
    return cx + 8 * 11
}

// Renders an obsidian top-bar HUD badge (`x=420..1040, y=6..32`) with live `rdtsc` cycles & NVMe `@capsule` status!
fn draw_status_hud(handoff: @BootHandoff, online_cores: u64, fabric_cycles: u64, cap_val: u64) i64 {
    if handoff.gop_width < 1060 || handoff.gop_height < 64 {
        return 0
    }
    bg_border := pack_rgb(0x00, 0xE5, 0xFF, handoff.gop_format)
    bg_fill   := pack_rgb(0x0C, 0x10, 0x18, handoff.gop_format)
    fg_cyan   := pack_rgb(0x00, 0xFF, 0xAA, handoff.gop_format)
    fg_amber  := pack_rgb(0xFF, 0xD6, 0x00, handoff.gop_format)
    fg_violet := pack_rgb(0xE0, 0x66, 0xFF, handoff.gop_format)
    fg_white  := pack_rgb(0xF0, 0xF4, 0xFF, handoff.gop_format)

    badge_w: u64 = 512
    if cap_val != 0 {
        badge_w = 620
    }
    draw_rect_safe(handoff, 420, 6, badge_w, 26, bg_border)
    draw_rect_safe(handoff, 422, 8, badge_w - 4, 22, bg_fill)
    draw_hud_text(handoff, 434, 12, "ZERO OS // GATE 3 // C:", fg_white)

    c_ch: u8 = '1'
    if online_cores < 10 {
        c_ch = 48 + online_cores
    }
    draw_glyph_2x(handoff, 434 + 23 * 12, 12, c_ch, fg_cyan)
    draw_hud_text(handoff, 434 + 25 * 12, 12, "WX:0 CYC:", fg_cyan)
    draw_hud_u32(handoff, 434 + 34 * 12, 12, fabric_cycles, fg_amber)
    if cap_val != 0 {
        draw_hud_text(handoff, 434 + 41 * 12, 12, "CAP:", fg_violet)
        draw_hud_u32(handoff, 434 + 45 * 12, 12, cap_val, fg_violet)
    }
    return 0
}

fn draw_deck_capsule_row(handoff: @BootHandoff, y0: u64, slot_num: u64, active_slot: u64, label: str, is_loaded: u64) i64 {
    fmt: u64  = handoff.gop_format
    row_hi    := pack_rgb(0x16, 0x26, 0x3D, fmt)
    fg_cyan   := pack_rgb(0x00, 0xFF, 0xAA, fmt)
    fg_amber  := pack_rgb(0xFF, 0xD6, 0x00, fmt)
    fg_violet := pack_rgb(0xE0, 0x66, 0xFF, fmt)
    fg_white  := pack_rgb(0xF0, 0xF4, 0xFF, fmt)
    fg_muted  := pack_rgb(0x78, 0x8A, 0xA4, fmt)

    if active_slot == slot_num {
        draw_rect_safe(handoff, 40, y0 - 3, 560, 20, row_hi)
        draw_glyph_2x(handoff, 44, y0, '>', fg_amber)
    }
    row_col: u32 = fg_white
    if active_slot == slot_num {
        row_col = fg_cyan
    }
    draw_deck_text(handoff, 60, y0, label, row_col)
    if is_loaded != 0 {
        draw_deck_text(handoff, 368, y0, "SEALED RX WX:0", fg_violet)
    } else {
        draw_deck_text(handoff, 368, y0, "OFFLINE", fg_muted)
    }
    return 0
}

// Renders the Obsidian Command Deck panel inside `x=32..608, y=84..332` (`576 x 248`),
// preserving all existing top-bar LEDs, core pips, `(40,40)` scancode cell, `(420,6)` HUD, & `(640,400)`!
fn draw_command_deck(handoff: @BootHandoff, online_cores: u64, active_cap_slot: u64, boot_cap_val: u64) i64 {
    if handoff.gop_width < 640 || handoff.gop_height < 360 {
        return 0
    }
    fmt: u64  = handoff.gop_format
    bg_border := pack_rgb(0x00, 0xE5, 0xFF, fmt)
    bg_fill   := pack_rgb(0x0C, 0x10, 0x18, fmt)
    hdr_fill  := pack_rgb(0x12, 0x1A, 0x2A, fmt)
    div_col   := pack_rgb(0x1E, 0x32, 0x4A, fmt)
    fg_cyan   := pack_rgb(0x00, 0xFF, 0xAA, fmt)
    fg_amber  := pack_rgb(0xFF, 0xD6, 0x00, fmt)
    fg_violet := pack_rgb(0xE0, 0x66, 0xFF, fmt)
    fg_white  := pack_rgb(0xF0, 0xF4, 0xFF, fmt)
    fg_sky    := pack_rgb(0x64, 0xD2, 0xFF, fmt)

    // Outer 2px cyan frame (`x=32..608, y=84..332`) + deep obsidian body
    draw_rect_safe(handoff, 32, 84, 576, 248, bg_border)
    draw_rect_safe(handoff, 34, 86, 572, 244, bg_fill)
    draw_rect_safe(handoff, 34, 86, 572, 26, hdr_fill)
    draw_rect_safe(handoff, 34, 112, 572, 2, bg_border)

    // Title Row (`y = 92`): online Reactors + IRQ1/MWAIT status
    cx: u64 = draw_deck_text(handoff, 44, 92, "COMMAND DECK // C:", fg_white)
    cx = draw_deck_val(handoff, cx, 92, online_cores, fg_cyan)
    cx = draw_deck_text(handoff, cx + 11, 92, "IRQ1/MWAIT:", fg_sky)
    if kbd_state[4] != 0 {
        draw_deck_text(handoff, cx, 92, "ARMED", fg_cyan)
    } else {
        draw_deck_text(handoff, cx, 92, "POLL", fg_amber)
    }

    // Row 1 (`y = 122`): Live Ring-0 AVX-512 `<tile | simd: 8>` vs Scalar cycles
    cx = draw_deck_text(handoff, 44, 122, "AVX-512 VEC:", fg_sky)
    cx = draw_deck_val(handoff, cx, 122, simd_telemetry[2], fg_cyan)
    cx = draw_deck_text(handoff, cx, 122, " / SCALAR:", fg_sky)
    cx = draw_deck_val(handoff, cx, 122, simd_telemetry[1], fg_amber)
    draw_deck_text(handoff, cx, 122, " CYC", fg_white)

    // Row 2 (`y = 146`): NVMe `ZEXTENT1` sealed capsule directory header
    cx = draw_deck_text(handoff, 44, 146, "NVME ZEXTENT1 CAPSULES:", fg_white)
    cx = draw_deck_val(handoff, cx + 6, 146, cap_dir_entries[4], fg_violet)
    if boot_cap_val != 0 {
        cx = draw_deck_text(handoff, cx + 11, 146, "BOOT:", fg_sky)
        draw_deck_val(handoff, cx, 146, boot_cap_val, fg_violet)
    }

    // Rows 3..5 (`y = 170, 194, 218`): Sealed W^X capsule slots
    draw_deck_capsule_row(handoff, 170, 1, active_cap_slot, "[1] EXT0 COMPUTE", cap_dir_entries[0])
    draw_deck_capsule_row(handoff, 194, 2, active_cap_slot, "[2] EXT1 AVX512_WAVE", cap_dir_entries[1])
    draw_deck_capsule_row(handoff, 218, 3, active_cap_slot, "[3] EXT2 MATRIX_CRC", cap_dir_entries[2])

    draw_rect_safe(handoff, 42, 243, 556, 1, div_col)

    // Row 6 (`y = 250`): Last multi-core capsule execution result
    if active_cap_slot == 0 {
        draw_deck_text(handoff, 44, 250, "LAST EXEC: READY // WORKERS IN MWAIT", fg_cyan)
    } else {
        cx = draw_deck_text(handoff, 44, 250, "LAST EXEC: CAP", fg_white)
        cx = draw_deck_val(handoff, cx, 250, active_cap_slot, fg_cyan)
        cx = draw_deck_text(handoff, cx + 11, 250, "SUM=", fg_amber)
        draw_deck_val(handoff, cx, 250, fabric_state[1], fg_amber)
    }

    // Row 7 (`y = 274`): Multi-core `MOVDIR64B` + `MWAIT` round-trip `rdtsc` cycles & count
    cx = draw_deck_text(handoff, 44, 274, "RDTSC:", fg_sky)
    cx = draw_deck_val(handoff, cx + 6, 274, fabric_state[2], fg_amber)
    cx = draw_deck_text(handoff, cx, 274, " CYC // RUNS:", fg_sky)
    cx = draw_deck_val(handoff, cx + 6, 274, fabric_state[3], fg_cyan)
    cx = draw_deck_text(handoff, cx + 11, 274, "IRQS:", fg_sky)
    draw_deck_val(handoff, cx + 6, 274, kbd_state[5], fg_violet)

    // Footer Legend (`y = 300..330`)
    draw_rect_safe(handoff, 34, 300, 572, 30, hdr_fill)
    draw_rect_safe(handoff, 34, 300, 572, 1, bg_border)
    draw_deck_text(handoff, 40, 309, "[1/2/3] CAPSULE  [4] ZEROFS  [B] SIMD  [Q] HALT", fg_amber)
    draw_zerofs_panel(handoff)
    return 0
}

// Renders the Stage-2 `ZEROFS ZLEDGER1 // HW DOMAINS` cockpit panel at `x=624..1200, y=84..332`
// (strictly above `(pw/2, ph/2) = (640, 400)` on `1280x800` GOP and clear of all existing HUD regions!)
fn draw_zerofs_panel(handoff: @BootHandoff) i64 {
    if handoff.gop_width < 1220 || handoff.gop_height < 680 {
        return 0
    }
    fmt: u64  = handoff.gop_format
    bg_border := pack_rgb(0x00, 0xE5, 0xFF, fmt)
    bg_fill   := pack_rgb(0x0C, 0x10, 0x18, fmt)
    hdr_fill  := pack_rgb(0x12, 0x1A, 0x2A, fmt)
    div_col   := pack_rgb(0x1E, 0x32, 0x4A, fmt)
    fg_cyan   := pack_rgb(0x00, 0xFF, 0xAA, fmt)
    fg_amber  := pack_rgb(0xFF, 0xD6, 0x00, fmt)
    fg_violet := pack_rgb(0xE0, 0x66, 0xFF, fmt)
    fg_white  := pack_rgb(0xF0, 0xF4, 0xFF, fmt)
    fg_sky    := pack_rgb(0x64, 0xD2, 0xFF, fmt)
    fg_muted  := pack_rgb(0x78, 0x8A, 0xA4, fmt)

    draw_rect_safe(handoff, 624, 84, 576, 248, bg_border)
    draw_rect_safe(handoff, 626, 86, 572, 244, bg_fill)
    draw_rect_safe(handoff, 626, 86, 572, 26, hdr_fill)
    draw_rect_safe(handoff, 626, 112, 572, 2, bg_border)

    cx: u64 = draw_deck_text(handoff, 636, 92, "ZEROFS ZLEDGER1 // PCI DOMAINS:", fg_white)
    draw_deck_val(handoff, cx + 6, 92, hw_dom_summary[0], fg_cyan)

    // Row 1 (`y = 122`): Non-POSIX Hardware Domains (`nvme` w/ multi-queue count, `gt`, `gna`, `xhci`)
    cx = draw_deck_text(handoff, 636, 122, "DOM:", fg_sky)
    if dom_nvme.present != 0 {
        if nvme_ctrl_state[7] > 0 {
            cx = draw_deck_text(handoff, cx + 8, 122, "NVME:", fg_cyan)
            cx = draw_deck_val(handoff, cx, 122, nvme_ctrl_state[7], fg_amber)
            cx = draw_deck_text(handoff, cx, 122, "Q", fg_cyan)
        } else {
            cx = draw_deck_text(handoff, cx + 8, 122, "NVME:ON", fg_cyan)
        }
    } else {
        cx = draw_deck_text(handoff, cx + 8, 122, "NVME:--", fg_muted)
    }
    if dom_gt.present   != 0 { cx = draw_deck_text(handoff, cx + 8, 122, "GT:ON",   fg_cyan) } else { cx = draw_deck_text(handoff, cx + 8, 122, "GT:--",   fg_muted) }
    if dom_gna.present  != 0 { cx = draw_deck_text(handoff, cx + 8, 122, "GNA:ON",  fg_cyan) } else { cx = draw_deck_text(handoff, cx + 8, 122, "GNA:--",  fg_muted) }
    if dom_xhci.present != 0 { cx = draw_deck_text(handoff, cx + 8, 122, "XHCI:ON", fg_cyan) } else { cx = draw_deck_text(handoff, cx + 8, 122, "XHCI:--", fg_muted) }

    // Row 2 (`y = 148`): Mandatory `ZLEDGER1` Partition Guard Status
    cx = draw_deck_text(handoff, 636, 148, "WRITE GUARD:", fg_white)
    if zfs_is_write_armed() == 1 {
        draw_deck_text(handoff, cx + 8, 148, "ZLEDGER1 ARMED [COW RW]", fg_cyan)
    } else {
        draw_deck_text(handoff, 636 + 13 * 11, 148, "SAFE_RO [FOREIGN LOCKED]", fg_amber)
    }

    // Row 3 (`y = 174`): CoW Superblock Epoch & Mirror (`A` / `B`)
    cx = draw_deck_text(handoff, 636, 174, "SUPER EPOCH:", fg_sky)
    cx = draw_deck_val(handoff, cx + 8, 174, zfs_state[2], fg_violet)
    cx = draw_deck_text(handoff, cx + 14, 174, "MIRROR:", fg_sky)
    if zfs_state[11] == 1 {
        draw_deck_text(handoff, cx + 8, 174, "BUCKET_1 [A]", fg_cyan)
    } else {
        if zfs_state[11] == 2 {
            draw_deck_text(handoff, cx + 8, 174, "BUCKET_2 [B]", fg_cyan)
        } else {
            draw_deck_text(handoff, cx + 8, 174, "NONE", fg_muted)
        }
    }

    // Row 4 (`y = 200`): Eytzinger Merkle B+Tree Key Count, Tree Level (`0..2`), & Snapshot ID
    cx = draw_deck_text(handoff, 636, 200, "KEYS:", fg_sky)
    cx = draw_deck_val(handoff, cx + 6, 200, zfs_state[6], fg_cyan)
    cx = draw_deck_text(handoff, cx + 11, 200, "LVL:", fg_sky)
    cx = draw_deck_val(handoff, cx + 6, 200, zfs_state[12], fg_violet)
    cx = draw_deck_text(handoff, cx + 11, 200, "SNAP:", fg_sky)
    draw_deck_val(handoff, cx + 6, 200, zfs_state[3], fg_amber)

    // Row 5 (`y = 224`): Hardware Crypto & `@oneshot` Engine
    draw_deck_text(handoff, 636, 224, "CRYPTO: AES-128-CTR + SHA-NI + ONESHOT", fg_violet)

    draw_rect_safe(handoff, 634, 245, 556, 1, div_col)

    // Row 6 (`y = 256`): Last Verified NVMe CoW Transaction Value
    cx = draw_deck_text(handoff, 636, 256, "LAST COW TX:", fg_white)
    if zfs_state[10] == 0 {
        draw_deck_text(handoff, cx + 8, 256, "IDLE // PRESS [4]", fg_cyan)
    } else {
        draw_deck_val(handoff, cx + 8, 256, zfs_state[10], fg_amber)
    }

    draw_rect_safe(handoff, 626, 300, 572, 30, hdr_fill)
    draw_rect_safe(handoff, 626, 300, 572, 1, bg_border)
    draw_deck_text(handoff, 634, 309, "[4] COMMIT COW SNAP + AES-NI EXTENT TO NVME", fg_amber)
    return 0
}
