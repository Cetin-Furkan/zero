// =============================================================================
// ZeroOS Non-Temporal `movnti` Scanout & Crisp Bitmap HUD (`os/hud_render.zr`)
// =============================================================================
use "hw_types.zr"

// 5x7 binary bitmap glyphs packed into 35-bit `u64` constants (`row 0` in `[34:30]`)
GLYPH_Z :: (0b11111 << 30) | (0b00001 << 25) | (0b00010 << 20) | (0b00100 << 15) | (0b01000 << 10) | (0b10000 << 5) | 0b11111
GLYPH_E :: (0b11111 << 30) | (0b10000 << 25) | (0b10000 << 20) | (0b11110 << 15) | (0b10000 << 10) | (0b10000 << 5) | 0b11111
GLYPH_R :: (0b11110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b11110 << 15) | (0b10100 << 10) | (0b10010 << 5) | 0b10001
GLYPH_O :: (0b01110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b10001 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b01110
GLYPH_S :: (0b01111 << 30) | (0b10000 << 25) | (0b10000 << 20) | (0b01110 << 15) | (0b00001 << 10) | (0b00001 << 5) | 0b11110
GLYPH_C :: (0b01110 << 30) | (0b10001 << 25) | (0b10000 << 20) | (0b10000 << 15) | (0b10000 << 10) | (0b10001 << 5) | 0b01110
GLYPH_W :: (0b10001 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b10101 << 15) | (0b10101 << 10) | (0b11011 << 5) | 0b10001
GLYPH_X :: (0b10001 << 30) | (0b01010 << 25) | (0b00100 << 20) | (0b00100 << 15) | (0b00100 << 10) | (0b01010 << 5) | 0b10001
GLYPH_K :: (0b10001 << 30) | (0b10010 << 25) | (0b10100 << 20) | (0b11000 << 15) | (0b10100 << 10) | (0b10010 << 5) | 0b10001
GLYPH_G :: (0b01110 << 30) | (0b10001 << 25) | (0b10000 << 20) | (0b10111 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b01110
GLYPH_A :: (0b01110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b11111 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b10001
GLYPH_T :: (0b11111 << 30) | (0b00100 << 25) | (0b00100 << 20) | (0b00100 << 15) | (0b00100 << 10) | (0b00100 << 5) | 0b00100
GLYPH_B :: (0b11110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b11110 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b11110
GLYPH_P :: (0b11110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b11110 << 15) | (0b10000 << 10) | (0b10000 << 5) | 0b10000
GLYPH_F :: (0b11111 << 30) | (0b10000 << 25) | (0b10000 << 20) | (0b11110 << 15) | (0b10000 << 10) | (0b10000 << 5) | 0b10000
GLYPH_Y :: (0b10001 << 30) | (0b10001 << 25) | (0b01010 << 20) | (0b00100 << 15) | (0b00100 << 10) | (0b00100 << 5) | 0b00100
GLYPH_COL :: (0b00000 << 30) | (0b00100 << 25) | (0b00100 << 20) | (0b00000 << 15) | (0b00100 << 10) | (0b00100 << 5) | 0b00000
GLYPH_SL  :: (0b00001 << 30) | (0b00010 << 25) | (0b00010 << 20) | (0b00100 << 15) | (0b01000 << 10) | (0b01000 << 5) | 0b10000
GLYPH_0 :: (0b01110 << 30) | (0b10011 << 25) | (0b10101 << 20) | (0b10101 << 15) | (0b11001 << 10) | (0b10001 << 5) | 0b01110
GLYPH_1 :: (0b00100 << 30) | (0b01100 << 25) | (0b00100 << 20) | (0b00100 << 15) | (0b00100 << 10) | (0b00100 << 5) | 0b01110
GLYPH_2 :: (0b01110 << 30) | (0b10001 << 25) | (0b00001 << 20) | (0b00110 << 15) | (0b01000 << 10) | (0b10000 << 5) | 0b11111
GLYPH_3 :: (0b11110 << 30) | (0b00001 << 25) | (0b00001 << 20) | (0b01110 << 15) | (0b00001 << 10) | (0b00001 << 5) | 0b11110
GLYPH_4 :: (0b00010 << 30) | (0b00110 << 25) | (0b01010 << 20) | (0b10010 << 15) | (0b11111 << 10) | (0b00010 << 5) | 0b00010
GLYPH_5 :: (0b11111 << 30) | (0b10000 << 25) | (0b11110 << 20) | (0b00001 << 15) | (0b00001 << 10) | (0b10001 << 5) | 0b01110
GLYPH_6 :: (0b01110 << 30) | (0b10000 << 25) | (0b11110 << 20) | (0b10001 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b01110
GLYPH_7 :: (0b11111 << 30) | (0b00001 << 25) | (0b00010 << 20) | (0b00100 << 15) | (0b01000 << 10) | (0b01000 << 5) | 0b01000
GLYPH_8 :: (0b01110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b01110 << 15) | (0b10001 << 10) | (0b10001 << 5) | 0b01110
GLYPH_9 :: (0b01110 << 30) | (0b10001 << 25) | (0b10001 << 20) | (0b01111 << 15) | (0b00001 << 10) | (0b00001 << 5) | 0b01110

fn expected_pixel(x: u64, y: u64, fmt: u64) u32 {
    b: u64 = x[7:0]
    g: u64 = (y * 3 + (x >> 2))[7:0]
    r: u64 = (x ^ y)[7:0]
    if fmt == 1 {
        px_rgbx: u32 = r | (g << 8) | (b << 16)
        return px_rgbx
    }
    px_bgrx: u32 = b | (g << 8) | (r << 16)
    return px_bgrx
}

fn pack_rgb(r: u64, g: u64, b: u64, fmt: u64) u32 {
    if fmt == 1 {
        c1: u32 = r[7:0] | (g[7:0] << 8) | (b[7:0] << 16)
        return c1
    }
    c0: u32 = b[7:0] | (g[7:0] << 8) | (r[7:0] << 16)
    return c0
}

// Non-temporal `movnti` full-screen diagnostic gradient paint + `@sfence()`
fn stream_paint_gop(handoff: @BootHandoff) i64 {
    uw: u64 = handoff.gop_width
    uh: u64 = handoff.gop_height
    ufmt: u64 = handoff.gop_format
    stride_px: u64 = handoff.gop_stride / 4

    fb_nt := @stream<u32>(handoff.gop_base, uh * stride_px)
    for y in 0..uh {
        uy: u64 = y
        row_px: u64 = uy * stride_px
        for x in 0..uw <unroll: 4> {
            ux: u64 = x
            fb_nt[row_px + ux] = expected_pixel(ux, uy, ufmt)
        }
    }
    @sfence()

    fb := @mmio<u32>(handoff.gop_base, uh * stride_px)
    if fb[0] != expected_pixel(0, 0, ufmt) || fb[stride_px + 10] != expected_pixel(10, 1, ufmt) || fb[(uh - 1) * stride_px + (uw - 1)] != expected_pixel(uw - 1, uh - 1, ufmt) {
        @halt()
    }
    return 0
}

fn draw_rect_safe(handoff: @BootHandoff, x0: u64, y0: u64, rw: u64, rh: u64, color: u32) i64 {
    w: u64 = handoff.gop_width
    h: u64 = handoff.gop_height
    stride_px: u64 = handoff.gop_stride / 4
    if x0 + rw > w || y0 + rh > h {
        return 0
    }
    fb := @mmio<u32>(handoff.gop_base, h * stride_px)
    for dy in 0..rh {
        row: u64 = (y0 + dy) * stride_px
        for dx in 0..rw {
            fb[row + x0 + dx] = color
        }
    }
    return 0
}

fn draw_led(handoff: @BootHandoff, slot: u64, r: u64, g: u64, b: u64) i64 =>
    draw_rect_safe(handoff, 32 + slot * 24, 8, 16, 12, pack_rgb(r, g, b, handoff.gop_format))

fn draw_core_pip(handoff: @BootHandoff, core_idx: u64) i64 =>
    draw_rect_safe(handoff, 200 + core_idx * 16, 8, 12, 12, pack_rgb(0x00, 0xFF, 0xAA, handoff.gop_format))

fn paint_scancode_cell(handoff: @BootHandoff, sc: u64) i64 =>
    draw_rect_safe(handoff, 32, 32, 32, 32, pack_rgb(sc ^ 0xA5, 0xFF, sc, handoff.gop_format))

fn glyph_for_char(ch: u8) u64 {
    g: u64 = 0
    match ch {
        'Z' => g = GLYPH_Z
        'E' => g = GLYPH_E
        'R' => g = GLYPH_R
        'O' => g = GLYPH_O
        'S' => g = GLYPH_S
        'C' => g = GLYPH_C
        'W' => g = GLYPH_W
        'X' => g = GLYPH_X
        'K' => g = GLYPH_K
        'G' => g = GLYPH_G
        'A' => g = GLYPH_A
        'T' => g = GLYPH_T
        'B' => g = GLYPH_B
        'P' => g = GLYPH_P
        'F' => g = GLYPH_F
        'Y' => g = GLYPH_Y
        ':' => g = GLYPH_COL
        '/' => g = GLYPH_SL
        '0' => g = GLYPH_0
        '1' => g = GLYPH_1
        '2' => g = GLYPH_2
        '3' => g = GLYPH_3
        '4' => g = GLYPH_4
        '5' => g = GLYPH_5
        '6' => g = GLYPH_6
        '7' => g = GLYPH_7
        '8' => g = GLYPH_8
        '9' => g = GLYPH_9
        _   => g = 0
    }
    return g
}

fn draw_glyph_2x(handoff: @BootHandoff, x0: u64, y0: u64, ch: u8, color: u32) i64 {
    bits: u64 = glyph_for_char(ch)
    if bits == 0 {
        return 0
    }
    for gy in 0..7 {
        ugy: u64 = gy
        for gx in 0..5 {
            ugx: u64 = gx
            sh: u64 = (6 - ugy) * 5 + (4 - ugx)
            if ((bits >> sh) & 1) != 0 {
                draw_rect_safe(handoff, x0 + ugx * 2, y0 + ugy * 2, 2, 2, color)
            }
        }
    }
    return 0
}

fn draw_hud_text(handoff: @BootHandoff, x0: u64, y0: u64, label: str, color: u32) i64 {
    for idx, ch in label {
        draw_glyph_2x(handoff, x0 + idx * 12, y0, ch, color)
    }
    return 0
}

fn draw_hud_u32(handoff: @BootHandoff, x0: u64, y0: u64, val: u64, color: u32) i64 {
    if val == 0 {
        draw_glyph_2x(handoff, x0, y0, '0', color)
        return 0
    }
    div_u: u64 = 1000000
    v: u64 = val
    if v > 9999999 {
        v = 9999999
    }
    started: u64 = 0
    pos: u64 = 0
    loop <max: 7 | until: div_u == 0> {
        dig: u64 = v / div_u
        v %= div_u
        if dig != 0 || started == 1 {
            ch_d: u8 = 48 + dig
            draw_glyph_2x(handoff, x0 + pos * 12, y0, ch_d, color)
            pos += 1
            started = 1
        }
        div_u /= 10
    }
    return 0
}

// Renders an obsidian top-bar HUD badge (`x=420..1040, y=6..32`) with live `rdtsc` cycles & NVMe `@capsule` status!
fn draw_status_hud(handoff: @BootHandoff, online_cores: u64, fabric_cycles: u64, cap_val: u64) i64 {
    if handoff.gop_width < 1060 || handoff.gop_height < 64 {
        return 0
    }
    bg_border := pack_rgb(0x00, 0xE5, 0xFF, handoff.gop_format)
    bg_fill   := pack_rgb(0x0C, 0x10, 0x18, handoff.gop_format)
    fg_cyan   := pack_rgb(0x00, 0xFF, 0xAA, handoff.gop_format)
    fg_amber  := pack_rgb(0xFF, 0xD6, 0x00, handoff.gop_format)
    fg_violet := pack_rgb(0xE0, 0x66, 0xFF, handoff.gop_format)
    fg_white  := pack_rgb(0xF0, 0xF4, 0xFF, handoff.gop_format)

    badge_w: u64 = 512
    if cap_val != 0 {
        badge_w = 620
    }
    draw_rect_safe(handoff, 420, 6, badge_w, 26, bg_border)
    draw_rect_safe(handoff, 422, 8, badge_w - 4, 22, bg_fill)
    draw_hud_text(handoff, 434, 12, "ZERO OS // GATE 3 // C:", fg_white)

    c_ch: u8 = '1'
    if online_cores < 10 {
        c_ch = 48 + online_cores
    }
    draw_glyph_2x(handoff, 434 + 23 * 12, 12, c_ch, fg_cyan)
    draw_hud_text(handoff, 434 + 25 * 12, 12, "WX:0 CYC:", fg_cyan)
    draw_hud_u32(handoff, 434 + 34 * 12, 12, fabric_cycles, fg_amber)
    if cap_val != 0 {
        draw_hud_text(handoff, 434 + 41 * 12, 12, "CAP:", fg_violet)
        draw_hud_u32(handoff, 434 + 45 * 12, 12, cap_val, fg_violet)
    }
    return 0
}
