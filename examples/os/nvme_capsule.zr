// =============================================================================
// ZeroOS Gate-3/4 PCIe `ECAM` + NVMe `@dma_queue` + Multi-`@capsule` Engine (`os/nvme_capsule.zr`)
// =============================================================================
// Implements `ZERO_OS_ARCHITECTURE.md` §3 & §6 without VFS/FAT/ext4:
//   1. Discovers PCIe `ECAM` from ACPI `MCFG` & locates NVMe (`01h:08h:02h`)
//   2. Initializes Admin + I/O `@dma_queue` rings (`ASQ`/`ACQ` + `SQ1`/`CQ1`)
//   3. Queries `Identify Namespace` for exact hardware LBA shift (`512e` vs `4Kn`)
//   4. Discovers up to 4 sealed extents (`Extent 0..3`) in `MasterExtentSuper` (LBA 0),
//      DMAs each extent into `boot_capsule.base + idx * 65536`, verifies hardware
//      SSE4.2 `@crc32c`, seals all capsule slots `PTE_RX` / `PTE_RO_NX` (`WX=0`),
//      populates `cap_dir_entries`, and verifies `Extent 0` (`fail 88` + `777`)!
// =============================================================================
use "hw_types.zr"
use "paging_wx.zr"
use "zerofs_ledger.zr"

// Persistent NVMe controller state for post-boot `ZeroFS` (`ZLEDGER1`) DMA:
//   [0]=ready, [1]=lbads, [2]=blks_per_4k, [3]=iosq_db, [4]=iocq_db, [5]=io_seq, [6]=ns_bytes
@slab nvme_ctrl_state   : u64[8]
@slab zfs_nvme_sba_page : u8[4096]
@slab zfs_nvme_sbb_page : u8[4096]
@slab zfs_nvme_root_page: u8[4096]
@slab zfs_nvme_io_page  : u8[4096]

fn get_loaded_capsule_entry(idx: u64) u64 {
    if idx >= CAPSULE_MAX_SLOTS {
        return 0
    }
    return cap_dir_entries[idx]
}

fn get_loaded_capsule_count() u64 => cap_dir_entries[4]

fn nvme_submit_and_poll(
    sq_slot_addr:   u64,
    cq_slot_addr:   u64,
    cmd:            @NvmeCmd,
    sq_db_addr:     u64,
    cq_db_addr:     u64,
    tail_and_phase: u64
) u64 {
    next_tail: u32 = tail_and_phase[31:1]
    exp_phase: u64 = tail_and_phase[0:0]

    sq_view := @view<NvmeCmd>(sq_slot_addr)
    sq_view.cdw0  = cmd.cdw0
    sq_view.nsid  = cmd.nsid
    sq_view.rsv0  = 0
    sq_view.mptr  = 0
    sq_view.prp1  = cmd.prp1
    sq_view.prp2  = cmd.prp2
    sq_view.cdw10 = cmd.cdw10
    sq_view.cdw11 = cmd.cdw11
    sq_view.cdw12 = cmd.cdw12
    sq_view.cdw13 = 0
    sq_view.cdw14 = 0
    sq_view.cdw15 = 0
    @sfence()

    sq_db := @mmio<u32>(sq_db_addr)
    cq_db := @mmio<u32>(cq_db_addr)
    sq_db.write(next_tail)

    status_mmio := @mmio<u16>(cq_slot_addr + 14)
    got_done: u64 = 0
    raw_st:   u64 = 0
    loop <max: 50000000 | until: got_done == 1> {
        st16: u16 = status_mmio.read()
        if st16[0:0] == exp_phase {
            raw_st = st16
            got_done = 1
        } else {
            @pause()
        }
    }
    if got_done == 0 {
        return 0
    }
    cq_db.write(next_tail)
    if raw_st[15:1] != 0 {
        return 0
    }
    return 1
}

// Submits one 4KiB NVMe I/O Read (`Opcode = 0x02`) on `SQ1`/`CQ1` (`cap = 16`)
// with proper ring wrap (`(io_seq + 1) & 15`) and CQ phase toggle (`((io_seq >> 4) & 1) ^ 1`).
fn nvme_io_read_4k(
    lba_start:   u64,
    dst_phys:    u64,
    blks_per_4k: u32,
    iosq_db:     u64,
    iocq_db:     u64,
    io_seq:      u64
) u64 {
    next_tail: u64 = (io_seq + 1) & 15
    exp_phase: u64 = ((io_seq >> 4) & 1) ^ 1
    cid_v:     u32 = 0x10 + (io_seq & 0x7FFF)
    rd_cmd := NvmeCmd{
        cdw0: (cid_v << 16) | 0x02, nsid: 1, rsv0: 0, mptr: 0,
        prp1: dst_phys, prp2: 0,
        cdw10: lba_start[31:0], cdw11: lba_start[63:32], cdw12: blks_per_4k,
        cdw13: 0, cdw14: 0, cdw15: 0
    }
    return nvme_submit_and_poll(
        nvme_io_sq1.slot_addr(io_seq),
        nvme_io_cq1.slot_addr(io_seq),
        rd_cmd,
        iosq_db,
        iocq_db,
        (next_tail << 1) | exp_phase
    )
}

fn find_nvme_bar0_via_mcfg(handoff: @BootHandoff) u64 {
    if handoff.mcfg == 0 {
        return 0
    }
    hdr := @view<AcpiSdtHeader>(handoff.mcfg)
    if hdr.signature != MCFG_SIG || hdr.length < 60 {
        return 0
    }
    ent := @view<AcpiMcfgEntry>(handoff.mcfg + 44)
    if ent.ecam_base == 0 {
        return 0
    }

    start_bus: u64 = ent.start_bus
    end_bus:   u64 = ent.end_bus
    if end_bus > start_bus + 7 {
        end_bus = start_bus + 7
    }
    bus_span: u64 = (end_bus - start_bus + 1) << 20
    ensure_uc_mmio_mapped(ent.ecam_base + (start_bus << 20), bus_span)

    for b in start_bus..(end_bus + 1) {
        ub: u64 = b
        for d in 0..32 {
            ud: u64 = d
            for f in 0..8 {
                uf: u64 = f
                cfg_addr: u64 = ent.ecam_base + (ub << 20) + (ud << 15) + (uf << 12)
                cfg := @mmio<u32>(cfg_addr, 16)
                vd: u32 = cfg[0]
                if vd == 0xFFFF_FFFF {
                    if uf == 0 {
                        break
                    }
                    continue
                }
                cls: u32 = cfg[2]
                if cls[31:8] == 0x010802 {
                    // Enable PCI Memory Space (bit 1) + Bus Master DMA (bit 2)
                    cmd_st: u32 = cfg[1]
                    cfg[1] = cmd_st | 0x06

                    bar_lo: u64 = cfg[4]
                    bar_phys: u64 = bar_lo & 0xFFFF_FFF0
                    if (bar_lo & 0x06) == 0x04 {
                        bar_hi: u64 = cfg[5]
                        bar_phys = bar_phys | (bar_hi << 32)
                    }
                    return bar_phys
                }
                if uf == 0 {
                    hdr_t: u32 = cfg[3]
                    if hdr_t[23:23] == 0 {
                        break
                    }
                }
            }
        }
    }
    return 0
}

// Probes NVMe via `MCFG`, streams & CRC32C-verifies up to 4 `@capsule` extents (`Extent 0..3`),
// seals all `256 KiB` capsule slots `PTE_RX` / `PTE_RO_NX` (`WX=0`), populates `cap_dir_entries`,
// and verifies `Extent 0` (`fail 88` `recover` + `@call(ext0, 40, 2) == 777`)!
fn probe_and_exec_nvme_capsule(handoff: @BootHandoff) u64 {
    for ci in 0..16 {
        cap_dir_entries[ci] = 0
    }
    nvme_ctrl_state[0] = 0
    zfs_disarm_safe_ro()

    bar0: u64 = find_nvme_bar0_via_mcfg(handoff)
    if bar0 == 0 {
        return 0
    }
    ensure_uc_mmio_mapped(bar0, 0x2000)

    regs32 := @mmio<u32>(bar0, 2048)
    regs64 := @mmio<u64>(bar0, 1024)

    cap_reg:   u64 = regs64[0]
    dstrd:     u64 = cap_reg[35:32]
    db_stride: u64 = 4 << dstrd     // bytes per doorbell register

    // 1. Reset NVMe controller (`CC.EN = 0 -> CSTS.RDY == 0`)
    if regs32[5][0:0] != 0 {
        regs32[5] = 0
        rdy_clr: u64 = 0
        loop <max: 50000000 | until: rdy_clr == 1> {
            if regs32[7][0:0] == 0 {
                rdy_clr = 1
            } else {
                @pause()
            }
        }
        if rdy_clr == 0 {
            return 0
        }
    }

    // 2. Bind Admin `@dma_queue` rings (`cap = 16`) & enable controller (`CC = 0x0046_0001`)
    regs32[9] = 0x000F_000F         // AQA: ACQS = 15, ASQS = 15
    regs64[5] = nvme_admin_sq.base  // ASQ physical base
    regs64[6] = nvme_admin_cq.base  // ACQ physical base
    regs32[5] = 0x0046_0001         // CC: IOCQES=4 (16B), IOSQES=6 (64B), EN=1

    rdy_on: u64 = 0
    loop <max: 50000000 | until: rdy_on == 1> {
        if regs32[7][0:0] == 1 {
            rdy_on = 1
        } else {
            @pause()
        }
    }
    if rdy_on == 0 {
        return 0
    }

    asq_db:  u64 = bar0 + 0x1000
    acq_db:  u64 = bar0 + 0x1000 + db_stride
    iosq_db: u64 = bar0 + 0x1000 + 2 * db_stride
    iocq_db: u64 = bar0 + 0x1000 + 3 * db_stride

    // 3. Admin Identify Namespace 1 (`Opcode = 0x06`, `CNS = 0x00`) -> read hardware `LBADS` shift
    id_cmd := NvmeCmd{
        cdw0: 0x0001_0006, nsid: 1, rsv0: 0, mptr: 0,
        prp1: nvme_meta_page.base, prp2: 0,
        cdw10: 0, cdw11: 0, cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0
    }
    if nvme_submit_and_poll(nvme_admin_sq.slot_addr(0), nvme_admin_cq.slot_addr(0), id_cmd, asq_db, acq_db, (1 << 1) | 1) == 0 {
        return 0
    }
    flbas: u64 = nvme_meta_page[26] & 0x0F
    lbads: u64 = nvme_meta_page[128 + flbas * 4 + 2]
    if lbads < 9 || lbads > 12 {
        return 0
    }

    // 4. Admin Create I/O CQ 1 (`Opcode = 0x05`) & Create I/O SQ 1 (`Opcode = 0x01`)
    ccq_cmd := NvmeCmd{
        cdw0: 0x0002_0005, nsid: 0, rsv0: 0, mptr: 0,
        prp1: nvme_io_cq1.base, prp2: 0,
        cdw10: (15 << 16) | 1, cdw11: 1, cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0
    }
    if nvme_submit_and_poll(nvme_admin_sq.slot_addr(1), nvme_admin_cq.slot_addr(1), ccq_cmd, asq_db, acq_db, (2 << 1) | 1) == 0 {
        return 0
    }

    csq_cmd := NvmeCmd{
        cdw0: 0x0003_0001, nsid: 0, rsv0: 0, mptr: 0,
        prp1: nvme_io_sq1.base, prp2: 0,
        cdw10: (15 << 16) | 1, cdw11: (1 << 16) | 1, cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0
    }
    if nvme_submit_and_poll(nvme_admin_sq.slot_addr(2), nvme_admin_cq.slot_addr(2), csq_cmd, asq_db, acq_db, (3 << 1) | 1) == 0 {
        return 0
    }

    // 5. Record initialized NVMe I/O `@dma_queue` state & read `MasterExtentSuper` at LBA 0 (`4 KiB`)
    nsze_qwords := @view<u64>(nvme_meta_page.base, 2)
    ns_bytes: u64 = nsze_qwords[0] << lbads
    blks_per_4k: u32 = (4096 >> lbads) - 1
    io_seq: u64 = 0

    nvme_ctrl_state[0] = 1
    nvme_ctrl_state[1] = lbads
    nvme_ctrl_state[2] = blks_per_4k
    nvme_ctrl_state[3] = iosq_db
    nvme_ctrl_state[4] = iocq_db
    nvme_ctrl_state[5] = 0
    nvme_ctrl_state[6] = ns_bytes

    if nvme_io_read_4k(0, nvme_meta_page.base, blks_per_4k, iosq_db, iocq_db, io_seq) == 0 {
        nvme_ctrl_state[0] = 0
        return 0
    }
    io_seq += 1
    nvme_ctrl_state[5] = io_seq

    super := @view<MasterExtentSuper>(nvme_meta_page.base)
    if super.magic != ZEXT_MAGIC || super.version != 1 || super.extent_count == 0 {
        // Seal unused capsule arena as `PTE_RO_NX` even when LBA 0 is not `ZEXTENT1` (e.g. foreign drive)!
        for rem0 in 0..CAPSULE_MAX_SLOTS {
            u_r0: u64 = rem0
            seal_capsule_wx_rx(boot_capsule.base + u_r0 * CAPSULE_SLOT_BYTES, 0, CAPSULE_SLOT_BYTES)
        }
        return 0
    }

    ext_cnt: u64 = super.extent_count
    if ext_cnt > CAPSULE_MAX_SLOTS {
        ext_cnt = CAPSULE_MAX_SLOTS
    }

    // 6. Stream, `@crc32c`-verify, and `W^X`-seal all `ext_cnt` extents (`Extent 0..ext_cnt-1`)
    for idx in 0..ext_cnt {
        u_idx: u64 = idx
        ext := @view<MasterExtentEntry>(nvme_meta_page.base + 64 + u_idx * 32)
        if ext.byte_len < 72 || ext.byte_len > CAPSULE_SLOT_BYTES || (ext.start_byte & 4095) != 0 {
            return 0
        }

        slot_base:    u64 = boot_capsule.base + u_idx * CAPSULE_SLOT_BYTES
        pages_needed: u64 = (ext.byte_len + 4095) >> 12
        for pg in 0..pages_needed {
            upg: u64 = pg
            lba_start: u64 = (ext.start_byte + upg * 4096) >> lbads
            if nvme_io_read_4k(lba_start, slot_base + upg * 4096, blks_per_4k, iosq_db, iocq_db, io_seq) == 0 {
                return 0
            }
            io_seq += 1
        }

        cap_hdr := @view<ZeroCapsuleHeader>(slot_base)
        if cap_hdr.magic != ZCAP_MAGIC || cap_hdr.version != 1 || cap_hdr.entry_off != 64 {
            return 0
        }
        code_bytes: u64 = cap_hdr.code_bytes
        if code_bytes == 0 || (code_bytes & 7) != 0 || 64 + code_bytes > ext.byte_len {
            return 0
        }
        qwords := @view<u64>(slot_base + 64, code_bytes / 8)
        crc_acc: u64 = 0xFFFF_FFFF
        for qw in qwords {
            crc_acc = @crc32c(crc_acc, qw)
        }
        calc_crc: u32 = (~crc_acc)[31:0]
        if calc_crc != cap_hdr.crc32c || calc_crc != ext.crc32c {
            @halt()
        }

        seal_capsule_wx_rx(slot_base, 64 + code_bytes, CAPSULE_SLOT_BYTES)

        cap_dir_entries[u_idx]      = slot_base + cap_hdr.entry_off
        cap_dir_entries[8 + u_idx]  = ext.byte_len
        cap_dir_entries[12 + u_idx] = calc_crc
        cap_dir_entries[4]          = u_idx + 1
    }

    // Seal any trailing unused capsule slots (`ext_cnt..CAPSULE_MAX_SLOTS`) as `PTE_RO_NX`
    for rem_idx in ext_cnt..CAPSULE_MAX_SLOTS {
        u_rem: u64 = rem_idx
        seal_capsule_wx_rx(boot_capsule.base + u_rem * CAPSULE_SLOT_BYTES, 0, CAPSULE_SLOT_BYTES)
    }
    nvme_ctrl_state[5] = io_seq

    // 7. Verify `Extent 0` per-core `gs:0` `fail 88` `recover` + boot compute (`777`)!
    ext0_entry: u64 = cap_dir_entries[0]
    caught_cap_fault: u64 = 0
    {
        _bad_call := @call(ext0_entry, 0, 0)
    } recover cerr {
        caught_cap_fault = cerr
    }
    if caught_cap_fault != 88 {
        @halt()
    }

    cap_ret: u64 = @call(ext0_entry, 40, 2)
    return cap_ret
}

fn load_and_run_nvme_capsule(handoff: @BootHandoff) u64 => probe_and_exec_nvme_capsule(handoff)

// =============================================================================
// Stage-2 Bare-Metal NVMe `ZeroFS` (`ZLEDGER1`) Driver & Mandatory Write Guard
// =============================================================================

fn nvme_dma_read_4k(byte_off: u64, dst_phys: u64) u64 {
    if nvme_ctrl_state[0] != 1 || (byte_off & 4095) != 0 {
        return 0
    }
    if byte_off + 4096 > nvme_ctrl_state[6] {
        return 0
    }
    lbads:   u64 = nvme_ctrl_state[1]
    blks_4k: u32 = nvme_ctrl_state[2]
    iosq_db: u64 = nvme_ctrl_state[3]
    iocq_db: u64 = nvme_ctrl_state[4]
    seq:     u64 = nvme_ctrl_state[5]

    ok: u64 = nvme_io_read_4k(byte_off >> lbads, dst_phys, blks_4k, iosq_db, iocq_db, seq)
    if ok == 0 {
        return 0
    }
    nvme_ctrl_state[5] = seq + 1
    return 1
}

// HARD HARDWARE INTERLOCK (`ZERO_NEXT_GEN_SPEC.md` §3.2):
// Refuses ANY NVMe Write (`Opcode = 0x01`) unless `zfs_is_write_armed() == 1` (verified `ZLEDGER1`
// magic + `@crc32c` on target disk!) AND `byte_off >= 2 MiB` (Bucket 0 `ZEXTENT1` is immutable!).
fn nvme_dma_write_4k_guarded(byte_off: u64, src_phys: u64) u64 {
    if nvme_ctrl_state[0] != 1 || zfs_is_write_armed() != 1 {
        return 0
    }
    if byte_off < ZFS_BUCKET_SUPER_A * ZFS_BUCKET_BYTES || (byte_off & 4095) != 0 {
        return 0
    }
    if byte_off + 4096 > nvme_ctrl_state[6] {
        return 0
    }

    lbads:      u64 = nvme_ctrl_state[1]
    blks_4k:    u32 = nvme_ctrl_state[2]
    iosq_db:    u64 = nvme_ctrl_state[3]
    iocq_db:    u64 = nvme_ctrl_state[4]
    seq:        u64 = nvme_ctrl_state[5]
    lba_start:  u64 = byte_off >> lbads
    next_tail:  u64 = (seq + 1) & 15
    exp_phase:  u64 = ((seq >> 4) & 1) ^ 1
    cid_v:      u32 = 0x100 + (seq & 0x7FFF)

    wr_cmd := NvmeCmd{
        cdw0: (cid_v << 16) | 0x01, nsid: 1, rsv0: 0, mptr: 0,
        prp1: src_phys, prp2: 0,
        cdw10: lba_start[31:0], cdw11: lba_start[63:32], cdw12: blks_4k,
        cdw13: 0, cdw14: 0, cdw15: 0
    }
    ok: u64 = nvme_submit_and_poll(
        nvme_io_sq1.slot_addr(seq),
        nvme_io_cq1.slot_addr(seq),
        wr_cmd,
        iosq_db,
        iocq_db,
        (next_tail << 1) | exp_phase
    )
    if ok == 0 {
        return 0
    }
    nvme_ctrl_state[5] = seq + 1
    return 1
}

// HARD HARDWARE INTERLOCK: NVMe Flush (`Opcode = 0x00`) also requires `zfs_is_write_armed() == 1`!
fn nvme_dma_flush_guarded() u64 {
    if nvme_ctrl_state[0] != 1 || zfs_is_write_armed() != 1 {
        return 0
    }
    iosq_db:   u64 = nvme_ctrl_state[3]
    iocq_db:   u64 = nvme_ctrl_state[4]
    seq:       u64 = nvme_ctrl_state[5]
    next_tail: u64 = (seq + 1) & 15
    exp_phase: u64 = ((seq >> 4) & 1) ^ 1
    cid_v:     u32 = 0x200 + (seq & 0x7FFF)

    fl_cmd := NvmeCmd{
        cdw0: (cid_v << 16) | 0x00, nsid: 1, rsv0: 0, mptr: 0,
        prp1: 0, prp2: 0,
        cdw10: 0, cdw11: 0, cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0
    }
    ok: u64 = nvme_submit_and_poll(
        nvme_io_sq1.slot_addr(seq),
        nvme_io_cq1.slot_addr(seq),
        fl_cmd,
        iosq_db,
        iocq_db,
        (next_tail << 1) | exp_phase
    )
    if ok == 0 {
        return 0
    }
    nvme_ctrl_state[5] = seq + 1
    return 1
}

// Probes Buckets 1 & 2 (`0x20_0000` & `0x40_0000`) via Read ONLY:
//   • Foreign / unformatted / `ZEXTENT1`-only drives stay locked in `SAFE_RO` (`0` writes ever issued!).
//   • Genuine `ZLEDGER1` drives mount the highest-epoch valid superblock & Eytzinger `CRC32C` root!
fn mount_nvme_zerofs() u64 {
    zfs_disarm_safe_ro()
    if nvme_ctrl_state[0] != 1 {
        return 0
    }
    if nvme_dma_read_4k(ZFS_BUCKET_SUPER_A * ZFS_BUCKET_BYTES, zfs_nvme_sba_page.base) == 0 {
        return 0
    }
    if nvme_dma_read_4k(ZFS_BUCKET_SUPER_B * ZFS_BUCKET_BYTES, zfs_nvme_sbb_page.base) == 0 {
        return 0
    }

    sb_a := ptr* ZLedgerSuperblock (zfs_nvme_sba_page.base)
    sb_b := ptr* ZLedgerSuperblock (zfs_nvme_sbb_page.base)
    va: u64 = zfs_validate_super(sb_a)
    vb: u64 = zfs_validate_super(sb_b)
    if va == 0 && vb == 0 {
        return 0
    }

    chosen : ptr* ZLedgerSuperblock = sb_a
    if vb == 1 {
        if va == 0 || sb_b[0].epoch >= sb_a[0].epoch {
            chosen = sb_b
        }
    }

    root_byte_off: u64 = mask<chosen[0].root_ext | ZFS_ADDR42_MASK> << 6
    if nvme_dma_read_4k(root_byte_off, zfs_nvme_root_page.base) == 0 {
        return 0
    }

    mounted_ep: u64 = 0
    {
        mounted_ep = zfs_mount_from_supers(sb_a, sb_b, ptr* u8 (zfs_nvme_root_page.base))
    } recover _merr {
        zfs_disarm_safe_ro()
        mounted_ep = 0
    }
    return mounted_ep
}

// Executes a full crash-safe CoW `ZeroFS` (`ZLEDGER1`) transaction on bare-metal NVMe:
//   1. $O(1)$ descending snapshot (`current_snap -= 1`)
//   2. `AES-128-CTR` + `SHA-NI` locked extent write (`4 KiB` DMA page)
//   3. CoW `4 KiB` Eytzinger `CRC32C` B-tree root write + NVMe `Flush`
//   4. Alternating `ZLedgerSuperblock` (`Mirror A` <-> `Mirror B`) write + NVMe `Flush`
//   5. Hardware DMA readback + `AES-NI`/`SHA-NI` decrypt + `ptr* @oneshot` register-wiped verification!
fn exec_nvme_zerofs_cow_tx(online_cores: u64) u64 {
    if zfs_is_write_armed() != 1 || nvme_ctrl_state[0] != 1 {
        return 0
    }

    new_snap: u32   = zfs_create_snapshot()
    next_ep:  u64   = zfs_state[2] + 1
    id_hash:  u64   = 0x5A46_5300_0000_0000 | next_ep
    user_key: u64   = 0x5A45_524F_2026_4B45
    want_val: u64   = next_ep * 100000 + online_cores * 100 + zfs_state[6] + 1

    data_bid: u64   = 0
    data_off: u64   = zfs_alloc_cow_bytes(online_cores - 1, 4096, 4096, data_bid)

    // Build `64B` `ZfsPieceHeader32` + `64B` `AES-128-CTR` encrypted cacheline in `zfs_nvme_io_page`
    io_qw := ptr* u64 (zfs_nvme_io_page.base)
    for z in 0..512 {
        uz: u64 = z
        io_qw[uz] = 0
    }
    ktag: u64 = @sha256_tag(user_key, id_hash)
    hdr := ptr* ZfsPieceHeader32 (zfs_nvme_io_page.base)
    hdr[0].exact_len = 64
    hdr[0].key_tag   = ktag
    hdr[0].p0        = 1
    hdr[0].p1        = 0

    io_qw[8] = want_val
    io_qw[9] = new_snap
    cipher_p := ptr* u8 (zfs_nvme_io_page.base + 64)
    _ := @aes128_ctr64(cipher_p, cipher_p, user_key, id_hash)
    ccrc: u32  = zfs_crc32c_bytes(cipher_p, 64)
    ext_w: u64 = zfs_encode_extent_word(data_off, 64, ZFS_PERM_RW, ZFS_CRYPT_AES_SHA, 0, 1)

    kp := ptr* LedgerKey (zfs_key_scratch.base)
    kp[0].id_hash     = id_hash
    kp[0].snap_id     = new_snap
    kp[0].bucket_id   = data_bid
    kp[0].bucket_gen  = zfs_bucket_gens[data_bid]
    kp[0].ext_word    = ext_w
    kp[0].key_tag     = ktag
    kp[0].exact_len   = 64
    kp[0].owner_rid   = online_cores - 1
    kp[0].data_crc32c = ccrc
    kp[0].meta_flags  = ((id_hash >> 56) & 0xFF) | (1 << 8)
    kp[0].reserved    = 0
    kp[0].entry_crc   = 0
    zfs_stage_insert_key(kp)

    root_bid: u64 = 0
    root_off: u64 = zfs_alloc_cow_bytes(0, 4096, 4096, root_bid)
    sbp := ptr* ZLedgerSuperblock (zfs_sb_scratch.base)
    mirror_b: u64 = zfs_prepare_cow_commit(ptr* u8 (zfs_nvme_root_page.base), root_off, sbp)

    // Ordered CoW NVMe persistence: Data + B-Tree Root -> Flush -> Alternating Superblock -> Flush!
    if nvme_dma_write_4k_guarded(data_off, zfs_nvme_io_page.base) == 0 { @halt() }
    if nvme_dma_write_4k_guarded(root_off, zfs_nvme_root_page.base) == 0 { @halt() }
    if nvme_dma_flush_guarded() == 0 { @halt() }

    sb_page_base: u64 = zfs_nvme_sba_page.base
    if mirror_b == 2 {
        sb_page_base = zfs_nvme_sbb_page.base
    }
    sb_qw := ptr* u64 (sb_page_base)
    for z in 0..512 {
        uz: u64 = z
        sb_qw[uz] = 0
    }
    dst_sb := ptr* ZLedgerSuperblock (sb_page_base)
    dst_sb[0] = sbp[0]
    if nvme_dma_write_4k_guarded(mirror_b * ZFS_BUCKET_BYTES, sb_page_base) == 0 { @halt() }
    if nvme_dma_flush_guarded() == 0 { @halt() }

    // Clear RAM buffer, DMA back `data_off` from NVMe, decrypt via `AES-NI`, and read via `ptr* @oneshot`!
    for z in 0..32 {
        uz: u64 = z
        io_qw[uz] = 0
    }
    if nvme_dma_read_4k(data_off, zfs_nvme_io_page.base) == 0 { @halt() }
    if hdr[0].key_tag != @sha256_tag(user_key, id_hash) { @halt() }

    pad_p := ptr* u8 (zfs_crypto_scratch.base)
    _ := @aes128_ctr64(pad_p, cipher_p, user_key, id_hash)
    secret_p : ptr* @oneshot u64 = pad_p + 0
    shown    : ptr* @oneshot u64 = secret_p
    got_val  : u64               = shown[0]

    pad_qw := ptr* u64 (zfs_crypto_scratch.base)
    for z in 0..8 {
        uz: u64 = z
        pad_qw[uz] = 0
    }
    if got_val != want_val {
        @halt()
    }
    zfs_state[10] = got_val
    return got_val
}
