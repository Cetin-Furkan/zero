// =============================================================================
// Zero Stage-1 Self-Hosted Compiler — Lexer & Module Loader (`compiler/lexer.zr`)
// =============================================================================

fn is_alpha_or_us(c: u8) i64 {
    if c >= 'a' && c <= 'z' { return 1 }
    if c >= 'A' && c <= 'Z' { return 1 }
    if c == '_' { return 1 }
    return 0
}

fn is_digit(c: u8) i64 {
    if c >= '0' && c <= '9' { return 1 }
    return 0
}

fn is_alnum_or_us(c: u8) i64 {
    if is_alpha_or_us(c) == 1 { return 1 }
    return is_digit(c)
}

fn hex_val(c: u8, line: i64) u64 {
    if c >= '0' && c <= '9' { return c - '0' }
    if c >= 'a' && c <= 'f' { return c - 'a' + 10 }
    if c >= 'A' && c <= 'F' { return c - 'A' + 10 }
    die_line("error: invalid hex digit", line)
    return 0
}

fn push_tok(kind: i64, kw: i64, line: i64, val: i64, aux: i64) {
    idx := g[G_TOK_CNT]
    tok_kind[idx] = kind
    tok_kw[idx]   = kw
    tok_line[idx] = line
    tok_val[idx]  = val
    tok_aux[idx]  = aux
    g[G_TOK_CNT]  = idx + 1
}

