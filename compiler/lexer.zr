// Canonicalizes `path_scratch[0..raw_len)` into `canon_buf[0..out_len)` (NUL-terminated)
fn canonicalize_scratch_path(raw_len: i64) i64 {
    out: i64 = 0
    i: i64 = 0
    if raw_len > 0 && path_scratch[0] == '/' {
        canon_buf[0] = '/'
        out = 1
        i = 1
    }

    loop <max: 1024 | until: i >= raw_len> {
        if path_scratch[i] == '/' {
            i += 1
            continue
        }
        seg_start := i
        loop <max: 4096 | until: i >= raw_len || path_scratch[i] == '/'> {
            i += 1
        }
        seg_len := i - seg_start

        // Ignore `.`
        if seg_len == 1 && path_scratch[seg_start] == '.' {
            continue
        }

        // Collapse `..` against previous non-`..` segment if possible
        if seg_len == 2 && path_scratch[seg_start] == '.' && path_scratch[seg_start + 1] == '.' {
            if out > 0 && !(out == 1 && canon_buf[0] == '/') {
                // Find start of last segment in `canon_buf`
                prev_sl: i64 = -1
                for k in 0..out {
                    if canon_buf[k] == '/' {
                        prev_sl = k
                    }
                }
                last_start: i64 = 0
                if prev_sl >= 0 {
                    last_start = prev_sl + 1
                }
                last_len := out - last_start
                is_prev_dotdot := 0
                if last_len == 2 && canon_buf[last_start] == '.' && canon_buf[last_start + 1] == '.' {
                    is_prev_dotdot = 1
                }
                if is_prev_dotdot == 0 {
                    if prev_sl < 0 {
                        out = 0
                    } else {
                        if prev_sl == 0 && canon_buf[0] == '/' {
                            out = 1
                        } else {
                            out = prev_sl
                        }
                    }
                    continue
                }
            }
        }

        if out > 0 && canon_buf[out - 1] != '/' {
            canon_buf[out] = '/'
            out += 1
        }
        for k in 0..seg_len {
            canon_buf[out] = path_scratch[seg_start + k]
            out += 1
        }
    }

    if out == 0 {
        canon_buf[0] = '.'
        out = 1
    }
    canon_buf[out] = 0
    return out
}

fn decode_escape(off: i64, end_off: i64, line: i64) i64 {
    // Returns `(consumed_extra << 8) | byte_val`
    if off >= end_off {
        die_line("error: unclosed string or char escape", line)
    }
    c: u8 = src_buf[off]
    if c == 'n'  { return 10 }
    if c == 't'  { return 9 }
    if c == 'r'  { return 13 }
    if c == '0'  { return 0 }
    if c == '\\' { return '\\' }
    if c == '"'  { return '"' }
    if c == '\'' { return '\'' }
    if c == 'x' {
        if off + 2 >= end_off {
            die_line("error: incomplete \\x escape", line)
        }
        hi: u64 = hex_val(src_buf[off + 1], line)
        lo: u64 = hex_val(src_buf[off + 2], line)
        return (2 << 8) | ((hi << 4) | lo)
    }
    return c
}

fn load_and_lex_module(pool_path_off: i64, pool_path_len: i64) {
    // Copy path from `str_pool` to `path_scratch` and canonicalize
    for i in 0..pool_path_len {
        path_scratch[i] = str_pool[pool_path_off + i]
    }
    c_len := canonicalize_scratch_path(pool_path_len)
    c_pool_off := pool_append_bytes(canon_buf.base, c_len)
    c_sym := sym_intern_pool(c_pool_off, c_len)

    // Deduplicate already-imported canonical module paths
    icnt := g[G_IMP_CNT]
    for i in 0..icnt {
        if imp_syms[i] == c_sym {
            return
        }
    }
    imp_syms[icnt] = c_sym
    g[G_IMP_CNT] = icnt + 1

    // Re-materialize NUL-terminated path in `canon_buf` for `SYS_OPENAT`
    for i in 0..c_len {
        canon_buf[i] = str_pool[c_pool_off + i]
    }
    canon_buf[c_len] = 0

    fd := @syscall(SYS_OPENAT, AT_FDCWD, canon_buf.base, 0, 0)
    if fd < 0 {
        die_msg("error: failed to open input .zr file")
    }
    flen := @syscall(SYS_LSEEK, fd, 0, SEEK_END)
    if flen < 0 {
        die_msg("error: failed to stat input .zr file")
    }
    @syscall(SYS_LSEEK, fd, 0, 0)

    fstart := g[G_SRC_OFF]
    if flen > 0 {
        got := @syscall(SYS_READ, fd, src_buf.base + fstart, flen)
        if got != flen {
            die_msg("error: short read on input .zr file")
        }
    }
    @syscall(SYS_CLOSE, fd)
    src_buf[fstart + flen] = 0
    g[G_SRC_OFF] = fstart + flen + 1

    // Extract directory prefix length of `str_pool[c_pool_off .. c_pool_off + c_len)`
    dir_len: i64 = 0
    for i in 0..c_len {
        if str_pool[c_pool_off + i] == '/' {
            dir_len = i
        }
    }

    tokenize_range(fstart, fstart + flen, 1, c_pool_off, dir_len)
}

fn tokenize_range(start_off: i64, end_off: i64, allow_imports: i64, dir_pool_off: i64, dir_len: i64) {
    pos: i64 = start_off
    line: i64 = 1
    brace_depth: i64 = 0

    loop <max: 2097152 | until: pos >= end_off> {
        c: u8 = src_buf[pos]

        // Whitespace
        if c == ' ' || c == '\t' || c == '\r' {
            pos += 1
            continue
        }
        if c == '\n' {
            line += 1
            pos += 1
            continue
        }

        // Line comment `// ...`
        if c == '/' && pos + 1 < end_off && src_buf[pos + 1] == '/' {
            pos += 2
            loop <max: 1048576 | until: pos >= end_off || src_buf[pos] == '\n'> {
                pos += 1
            }
            continue
        }

        // Block comment `/* ... */`
        if c == '/' && pos + 1 < end_off && src_buf[pos + 1] == '*' {
            pos += 2
            closed := 0
            loop <max: 1048576 | until: pos >= end_off> {
                if src_buf[pos] == '\n' {
                    line += 1
                }
                if pos + 1 < end_off && src_buf[pos] == '*' && src_buf[pos + 1] == '/' {
                    pos += 2
                    closed = 1
                    break
                }
                pos += 1
            }
            if closed == 0 {
                die_line("error: unclosed block comment", line)
            }
            continue
        }

        // Identifiers & Keywords (plus top-level `use "..."` module expansion)
        if is_alpha_or_us(c) == 1 {
            id_start := pos
            pos += 1
            loop <max: 4096 | until: pos >= end_off || is_alnum_or_us(src_buf[pos]) == 0> {
                pos += 1
            }
            id_len := pos - id_start
            p_off := pool_append_bytes(src_buf.base + id_start, id_len)
            sym_id := sym_intern_pool(p_off, id_len)

            // Check top-level `use "rel/path.zr"`
            if allow_imports == 1 && brace_depth == 0 && sym_id == g[G_SYM_USE] {
                ws := pos
                ws_line := line
                loop <max: 65536 | until: ws >= end_off> {
                    wc: u8 = src_buf[ws]
                    if wc == ' ' || wc == '\t' || wc == '\r' {
                        ws += 1
                        continue
                    }
                    if wc == '\n' {
                        ws_line += 1
                        ws += 1
                        continue
                    }
                    break
                }
                if ws < end_off && src_buf[ws] == '"' {
                    ws += 1
                    sub_start := g[G_STR_OFF]
                    loop <max: 4096 | until: ws >= end_off || src_buf[ws] == '"'> {
                        str_pool[g[G_STR_OFF]] = src_buf[ws]
                        g[G_STR_OFF] += 1
                        ws += 1
                    }
                    if ws >= end_off {
                        die_line("error: unclosed use path string", ws_line)
                    }
                    ws += 1
                    sub_len := g[G_STR_OFF] - sub_start
                    if sub_len == 0 {
                        die_line("error: empty use path", ws_line)
                    }

                    // Build combined path `dir + "/" + sub` into `str_pool`
                    comb_off := g[G_STR_OFF]
                    if str_pool[sub_start] != '/' && dir_len > 0 {
                        for k in 0..dir_len {
                            str_pool[g[G_STR_OFF]] = str_pool[dir_pool_off + k]
                            g[G_STR_OFF] += 1
                        }
                        str_pool[g[G_STR_OFF]] = '/'
                        g[G_STR_OFF] += 1
                    }
                    for k in 0..sub_len {
                        str_pool[g[G_STR_OFF]] = str_pool[sub_start + k]
                        g[G_STR_OFF] += 1
                    }
                    comb_len := g[G_STR_OFF] - comb_off

                    pos = ws
                    line = ws_line
                    load_and_lex_module(comb_off, comb_len)
                    continue
                }
            }

            kw: i64 = sym_kw[sym_id]
            prev_is_at := 0
            if g[G_TOK_CNT] > 0 && tok_kind[g[G_TOK_CNT] - 1] == TOK_AT {
                prev_is_at = 1
            }
            if kw != 0 && (kw < KW_SLAB || prev_is_at == 1) {
                push_tok(TOK_KW, kw, line, sym_id, 0)
            } else {
                push_tok(TOK_IDENT, 0, line, sym_id, 0)
            }
            continue
        }

        // Integer Literals (`0x...`, `0b...`, decimal, `_` separators, `B`/`KB`/`MB`/`GB`)
        if is_digit(c) == 1 {
            val: u64 = 0
            if c == '0' && pos + 1 < end_off && (src_buf[pos + 1] == 'x' || src_buf[pos + 1] == 'X') {
                pos += 2
                digits := 0
                loop <max: 256 | until: pos >= end_off> {
                    hc: u8 = src_buf[pos]
                    if hc == '_' {
                        pos += 1
                        continue
                    }
                    if (hc >= '0' && hc <= '9') || (hc >= 'a' && hc <= 'f') || (hc >= 'A' && hc <= 'F') {
                        val = (val << 4) | hex_val(hc, line)
                        digits += 1
                        pos += 1
                        continue
                    }
                    break
                }
                if digits == 0 {
                    die_line("error: empty hex literal", line)
                }
            } else {
                if c == '0' && pos + 1 < end_off && (src_buf[pos + 1] == 'b' || src_buf[pos + 1] == 'B') {
                    pos += 2
                    digits := 0
                    loop <max: 256 | until: pos >= end_off> {
                        bc: u8 = src_buf[pos]
                        if bc == '_' {
                            pos += 1
                            continue
                        }
                        if bc == '0' || bc == '1' {
                            val = (val << 1) | (bc - '0')
                            digits += 1
                            pos += 1
                            continue
                        }
                        break
                    }
                    if digits == 0 {
                        die_line("error: empty binary literal", line)
                    }
                } else {
                    loop <max: 256 | until: pos >= end_off> {
                        dc: u8 = src_buf[pos]
                        if dc == '_' {
                            pos += 1
                            continue
                        }
                        if is_digit(dc) == 1 {
                            val = val * 10 + (dc - '0')
                            pos += 1
                            continue
                        }
                        break
                    }
                    // Optional `B`, `KB`, `MB`, `GB` byte-unit suffixes
                    if pos < end_off && src_buf[pos] == 'B' {
                        pos += 1
                    } else {
                        if pos + 1 < end_off && src_buf[pos + 1] == 'B' {
                            sc: u8 = src_buf[pos]
                            if sc == 'K' {
                                val = val << 10
                                pos += 2
                            } else {
                                if sc == 'M' {
                                    val = val << 20
                                    pos += 2
                                } else {
                                    if sc == 'G' {
                                        val = val << 30
                                        pos += 2
                                    }
                                }
                            }
                        }
                    }
                }
            }
            push_tok(TOK_INT, 0, line, val, 0)
            continue
        }

        // String Literal `"..."`
        if c == '"' {
            pos += 1
            s_start := g[G_STR_OFF]
            closed := 0
            loop <max: 262144 | until: pos >= end_off> {
                sc: u8 = src_buf[pos]
                if sc == '"' {
                    pos += 1
                    closed = 1
                    break
                }
                if sc == '\n' {
                    die_line("error: unclosed string literal", line)
                }
                if sc == '\\' {
                    pos += 1
                    dec := decode_escape(pos, end_off, line)
                    str_pool[g[G_STR_OFF]] = dec & 0xFF
                    g[G_STR_OFF] += 1
                    pos += 1 + (dec >> 8)
                } else {
                    str_pool[g[G_STR_OFF]] = sc
                    g[G_STR_OFF] += 1
                    pos += 1
                }
            }
            if closed == 0 {
                die_line("error: unclosed string literal", line)
            }
            s_len := g[G_STR_OFF] - s_start
            push_tok(TOK_STR, 0, line, s_start, s_len)
            continue
        }

        // Character Literal `'x'`
        if c == '\'' {
            pos += 1
            if pos >= end_off {
                die_line("error: unclosed char literal", line)
            }
            ch_val: i64 = 0
            if src_buf[pos] == '\\' {
                pos += 1
                dec := decode_escape(pos, end_off, line)
                ch_val = dec & 0xFF
                pos += 1 + (dec >> 8)
            } else {
                ch_val = src_buf[pos]
                pos += 1
            }
            if pos >= end_off || src_buf[pos] != '\'' {
                die_line("error: expected closing single quote", line)
            }
            pos += 1
            push_tok(TOK_CHAR, 0, line, ch_val, 0)
            continue
        }

        // Multi-character & single-character operators
        c1: u8 = 0
        c2: u8 = 0
        c3: u8 = 0
        if pos + 1 < end_off { c1 = src_buf[pos + 1] }
        if pos + 2 < end_off { c2 = src_buf[pos + 2] }
        if pos + 3 < end_off { c3 = src_buf[pos + 3] }

        // 4-char `<<<=`, `>>>=`
        if c == '<' && c1 == '<' && c2 == '<' && c3 == '=' {
            push_tok(TOK_ROL_EQ, 0, line, 0, 0)
            pos += 4
            continue
        }
        if c == '>' && c1 == '>' && c2 == '>' && c3 == '=' {
            push_tok(TOK_ROR_EQ, 0, line, 0, 0)
            pos += 4
            continue
        }

        // 3-char `<<<`, `>>>`, `<<=`, `>>=`
        if c == '<' && c1 == '<' && c2 == '<' {
            push_tok(TOK_ROL, 0, line, 0, 0)
            pos += 3
            continue
        }
        if c == '>' && c1 == '>' && c2 == '>' {
            push_tok(TOK_ROR, 0, line, 0, 0)
            pos += 3
            continue
        }
        if c == '<' && c1 == '<' && c2 == '=' {
            push_tok(TOK_SHL_EQ, 0, line, 0, 0)
            pos += 3
            continue
        }
        if c == '>' && c1 == '>' && c2 == '=' {
            push_tok(TOK_SHR_EQ, 0, line, 0, 0)
            pos += 3
            continue
        }

        // 2-char operators
        if c == ':' && c1 == ':' { push_tok(TOK_COLON2,     0, line, 0, 0)  pos += 2  continue }
        if c == ':' && c1 == '=' { push_tok(TOK_WALRUS,     0, line, 0, 0)  pos += 2  continue }
        if c == '.' && c1 == '.' { push_tok(TOK_DOT2,       0, line, 0, 0)  pos += 2  continue }
        if c == '-' && c1 == '>' { push_tok(TOK_ARROW,      0, line, 0, 0)  pos += 2  continue }
        if c == '=' && c1 == '>' { push_tok(TOK_FAT_ARROW,  0, line, 0, 0)  pos += 2  continue }
        if c == '|' && c1 == '>' { push_tok(TOK_PIPE_GT,    0, line, 0, 0)  pos += 2  continue }
        if c == '=' && c1 == '=' { push_tok(TOK_EQ,         0, line, 0, 0)  pos += 2  continue }
        if c == '!' && c1 == '=' { push_tok(TOK_NE,         0, line, 0, 0)  pos += 2  continue }
        if c == '<' && c1 == '=' { push_tok(TOK_LE,         0, line, 0, 0)  pos += 2  continue }
        if c == '>' && c1 == '=' { push_tok(TOK_GE,         0, line, 0, 0)  pos += 2  continue }
        if c == '&' && c1 == '&' { push_tok(TOK_AND2,       0, line, 0, 0)  pos += 2  continue }
        if c == '|' && c1 == '|' { push_tok(TOK_OR2,        0, line, 0, 0)  pos += 2  continue }
        if c == '<' && c1 == '<' { push_tok(TOK_SHL,        0, line, 0, 0)  pos += 2  continue }
        if c == '>' && c1 == '>' { push_tok(TOK_SHR,        0, line, 0, 0)  pos += 2  continue }
        if c == '+' && c1 == '=' { push_tok(TOK_PLUS_EQ,    0, line, 0, 0)  pos += 2  continue }
        if c == '-' && c1 == '=' { push_tok(TOK_MINUS_EQ,   0, line, 0, 0)  pos += 2  continue }
        if c == '*' && c1 == '=' { push_tok(TOK_STAR_EQ,    0, line, 0, 0)  pos += 2  continue }
        if c == '/' && c1 == '=' { push_tok(TOK_SLASH_EQ,   0, line, 0, 0)  pos += 2  continue }
        if c == '%' && c1 == '=' { push_tok(TOK_PERCENT_EQ, 0, line, 0, 0)  pos += 2  continue }
        if c == '|' && c1 == '=' { push_tok(TOK_PIPE_EQ,    0, line, 0, 0)  pos += 2  continue }
        if c == '&' && c1 == '=' { push_tok(TOK_AMP_EQ,     0, line, 0, 0)  pos += 2  continue }
        if c == '^' && c1 == '=' { push_tok(TOK_CARET_EQ,   0, line, 0, 0)  pos += 2  continue }

        // 1-char punctuation & operators
        if c == '(' { push_tok(TOK_LPAREN,  0, line, 0, 0)  pos += 1  continue }
        if c == ')' { push_tok(TOK_RPAREN,  0, line, 0, 0)  pos += 1  continue }
        if c == '{' { brace_depth += 1  push_tok(TOK_LBRACE, 0, line, 0, 0)  pos += 1  continue }
        if c == '}' {
            if brace_depth > 0 { brace_depth -= 1 }
            push_tok(TOK_RBRACE, 0, line, 0, 0)
            pos += 1
            continue
        }
        if c == '[' { push_tok(TOK_LBRACK,  0, line, 0, 0)  pos += 1  continue }
        if c == ']' { push_tok(TOK_RBRACK,  0, line, 0, 0)  pos += 1  continue }
        if c == ':' { push_tok(TOK_COLON,   0, line, 0, 0)  pos += 1  continue }
        if c == '=' { push_tok(TOK_ASSIGN,  0, line, 0, 0)  pos += 1  continue }
        if c == ',' { push_tok(TOK_COMMA,   0, line, 0, 0)  pos += 1  continue }
        if c == '.' { push_tok(TOK_DOT,     0, line, 0, 0)  pos += 1  continue }
        if c == '@' { push_tok(TOK_AT,      0, line, 0, 0)  pos += 1  continue }
        if c == '|' { push_tok(TOK_PIPE,    0, line, 0, 0)  pos += 1  continue }
        if c == '&' { push_tok(TOK_AMP,     0, line, 0, 0)  pos += 1  continue }
        if c == '^' { push_tok(TOK_CARET,   0, line, 0, 0)  pos += 1  continue }
        if c == '~' { push_tok(TOK_TILDE,   0, line, 0, 0)  pos += 1  continue }
        if c == '!' { push_tok(TOK_BANG,    0, line, 0, 0)  pos += 1  continue }
        if c == '?' { push_tok(TOK_QMARK,   0, line, 0, 0)  pos += 1  continue }
        if c == ';' {
            // Semicolon Law: ';' is ONLY legal inline between a stage and its flag/loop consumer.
            // A ';' at the end of a line (before '\n', '//', '}', or EOF) is a hard parse error.
            sp := pos + 1
            loop <max: 65536 | until: sp >= end_off> {
                sc: u8 = src_buf[sp]
                if sc == ' ' || sc == '\t' || sc == '\r' {
                    sp += 1
                    continue
                }
                if sc == '/' && sp + 1 < end_off && src_buf[sp + 1] == '*' {
                    sp += 2
                    has_nl := 0
                    loop <max: 65536 | until: sp >= end_off> {
                        if src_buf[sp] == '\n' { has_nl = 1  break }
                        if sp + 1 < end_off && src_buf[sp] == '*' && src_buf[sp + 1] == '/' {
                            sp += 2
                            break
                        }
                        sp += 1
                    }
                    if has_nl == 1 {
                        die_line("error: ';' at end of line is forbidden (';' is only for inline flag/stage handoff)", line)
                    }
                    continue
                }
                break
            }
            if sp >= end_off || src_buf[sp] == '\n' || src_buf[sp] == '}' || (src_buf[sp] == '/' && sp + 1 < end_off && src_buf[sp + 1] == '/') {
                die_line("error: ';' at end of line is forbidden (';' is only for inline flag/stage handoff)", line)
            }
            push_tok(TOK_SEMI, 0, line, 0, 0)
            pos += 1
            continue
        }
        if c == '+' { push_tok(TOK_PLUS,    0, line, 0, 0)  pos += 1  continue }
        if c == '-' { push_tok(TOK_MINUS,   0, line, 0, 0)  pos += 1  continue }
        if c == '*' { push_tok(TOK_STAR,    0, line, 0, 0)  pos += 1  continue }
        if c == '/' { push_tok(TOK_SLASH,   0, line, 0, 0)  pos += 1  continue }
        if c == '%' { push_tok(TOK_PERCENT, 0, line, 0, 0)  pos += 1  continue }
        if c == '<' { push_tok(TOK_LT,      0, line, 0, 0)  pos += 1  continue }
        if c == '>' { push_tok(TOK_GT,      0, line, 0, 0)  pos += 1  continue }

        die_line("error: unexpected character in source", line)
    }
}
