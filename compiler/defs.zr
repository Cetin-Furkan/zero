KW_PRINT        :: 13
KW_TRUE         :: 14
KW_FALSE        :: 15
KW_SLAB         :: 16
KW_ARENA        :: 17
KW_CAPSULE      :: 18

// --- Type Tags & Modifiers ---
TY_VOID         :: 0
TY_I64          :: 1
TY_U64          :: 2
TY_I32          :: 3
TY_U32          :: 4
TY_I16          :: 5
TY_U16          :: 6
TY_I8           :: 7
TY_U8           :: 8
TY_BP_BASE      :: 64       // 64 + bp_idx

TY_BASE_MASK    :: 0x0FFF
TY_FLAG_VIEW1   :: 0x1000   // @view<T>(addr) single pointer overlay
TY_FLAG_SPAN    :: 0x2000   // 16B `{ ptr: u64, len: u64 }` (`str`, `bytes`, `[]T`)

// --- Global Compiler State Indices (`g[G_*]`) ---
G_MODE_CAPSULE  :: 0
G_MODE_LEX      :: 1
G_SRC_OFF       :: 2
G_IMP_CNT       :: 3
G_STR_OFF       :: 4
G_SYM_CNT       :: 5
G_TOK_CNT       :: 6
