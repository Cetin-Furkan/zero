// --- Type Tags & Modifiers ---
TY_VOID         :: 0
TY_I64          :: 1
TY_U64          :: 2
TY_I32          :: 3
TY_U32          :: 4
TY_I16          :: 5
TY_U16          :: 6
TY_I8           :: 7
TY_U8           :: 8
TY_U32X16       :: 9        // 512-bit AVX-512 16 x u32 ZMM vector (64B, 64B align)
TY_U64X8        :: 10       // 512-bit AVX-512 8  x u64 ZMM vector (64B, 64B align)
TY_BP_BASE      :: 0x100    // 0x100 + ut_idx -> BitPack (`bp_*[ut_idx]` & `ut_*[ut_idx]`)
TY_STRUCT_BASE  :: 0x300    // 0x300 + ut_idx -> Struct or @cell64 (`ut_*[ut_idx]`)
TY_PTR_BASE     :: 0x500    // 0x500 + ut_idx -> Custom @ptr (`ptr_*[ut_idx]` & `ut_*[ut_idx]`)

TY_BASE_MASK    :: 0x0FFF
TY_FLAG_VIEW1   :: 0x1000   // @Type / @view<T>(addr) / @mmio<T>(addr) 8B pointer overlay
TY_FLAG_SPAN    :: 0x2000   // 16B `{ ptr: u64, len: u64 }` (`str`, `bytes`, `[]T`, `@span`, `@view(a,n)`)
TY_FLAG_MMIO    :: 0x4000   // @mmio<T> volatile aperture modifier (no null fault)
TY_FLAG_STREAM  :: 0x8000   // @stream<u32|u64> non-temporal `movnti` span modifier
TY_FLAG_ATOMIC  :: 0x10000  // @atomic<u32|u64> hardware `lock` pointer

