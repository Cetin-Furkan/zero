TOK_RBRACE      :: 13
TOK_LBRACK      :: 14
TOK_RBRACK      :: 15
TOK_COLON       :: 16
TOK_COLON2      :: 17       // ::
TOK_WALRUS      :: 18       // :=
TOK_ASSIGN      :: 19       // =
TOK_COMMA       :: 20
TOK_DOT         :: 21
TOK_DOT2        :: 22       // ..
TOK_AT          :: 23       // @
TOK_PIPE        :: 24       // |
TOK_AMP         :: 25       // &
TOK_CARET       :: 26       // ^
TOK_TILDE       :: 27       // ~
TOK_BANG        :: 28       // !
TOK_QMARK       :: 29       // ?
TOK_SEMI        :: 30       // ;

TOK_PLUS        :: 32
TOK_MINUS       :: 33
TOK_STAR        :: 34
TOK_SLASH       :: 35
TOK_PERCENT     :: 36
TOK_SHL         :: 37       // <<
TOK_SHR         :: 38       // >>
TOK_ROL         :: 39       // <<<
TOK_ROR         :: 40       // >>>

TOK_EQ          :: 42       // ==
TOK_NE          :: 43       // !=
TOK_LT          :: 44       // <
TOK_LE          :: 45       // <=
TOK_GT          :: 46       // >
TOK_GE          :: 47       // >=
TOK_AND2        :: 48       // &&
TOK_OR2         :: 49       // ||

TOK_PLUS_EQ     :: 52       // +=
TOK_MINUS_EQ    :: 53       // -=
TOK_STAR_EQ     :: 54       // *=
TOK_SLASH_EQ    :: 55       // /=
TOK_PERCENT_EQ  :: 56       // %=
TOK_PIPE_EQ     :: 57       // |=
TOK_AMP_EQ      :: 58       // &=
TOK_CARET_EQ    :: 59       // ^=
TOK_SHL_EQ      :: 60       // <<=
TOK_SHR_EQ      :: 61       // >>=
TOK_ROL_EQ      :: 62       // <<<=
TOK_ROR_EQ      :: 63       // >>>=

TOK_ARROW       :: 66       // ->
TOK_FAT_ARROW   :: 67       // =>
TOK_PIPE_GT     :: 68       // |>

// --- Keyword IDs ---
KW_FN           :: 1
KW_RETURN       :: 2
KW_IF           :: 3
KW_ELSE         :: 4
KW_FOR          :: 5
KW_IN           :: 6
KW_LOOP         :: 7
