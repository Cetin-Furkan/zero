// Pre-interned contextual symbol IDs
G_SYM_MAIN      :: 40
G_SYM_USE       :: 41
G_SYM_MAX       :: 42
G_SYM_CAP       :: 43
G_SYM_UNTIL     :: 44
G_SYM_BITS      :: 45
G_SYM_BASE      :: 46
G_SYM_PTR       :: 47
G_SYM_LEN       :: 48
G_SYM_VIEW      :: 49
G_SYM_RSP_ALIGN :: 50
G_SYM_CRC32C    :: 51
G_SYM_POPCNT    :: 52
G_SYM_LZCNT     :: 53
G_SYM_TZCNT     :: 54
G_SYM_RID       :: 55
G_SYM_CALL      :: 56
G_SYM_FN_ADDR   :: 57
G_SYM_SIZEOF    :: 58
G_SYM_ALIGNOF   :: 59
G_SYM_TILE      :: 60

// --- Static `@slab` Arenas (Zero-Initialized in `Phdr[1]` `.bss`) ---
@slab g            : <i64 | max: 64>

@slab src_buf      : <u8  | max: 524288>
@slab imp_syms     : <u32 | max: 128>
@slab path_scratch : <u8  | max: 4096>
@slab canon_buf    : <u8  | max: 4096>

@slab str_pool     : <u8  | max: 262144>
@slab sym_off      : <u32 | max: 8192>
@slab sym_len      : <u32 | max: 8192>
@slab sym_kw       : <u8  | max: 8192>
@slab sym_ht       : <u32 | max: 16384>     // power-of-2 open-addressing table

@slab tok_kind     : <u8  | max: 131072>
@slab tok_kw       : <u8  | max: 131072>
@slab tok_line     : <u32 | max: 131072>
@slab tok_val      : <i64 | max: 131072>
@slab tok_aux      : <u32 | max: 131072>

@slab cst_sym      : <u32 | max: 2048>
@slab cst_tok      : <u32 | max: 2048>
@slab cst_done     : <u8  | max: 2048>
@slab cst_val      : <i64 | max: 2048>

@slab bp_sym       : <u32 | max: 128>
@slab bp_bytes     : <u32 | max: 128>
@slab bp_fstart    : <u32 | max: 128>
@slab bp_fcnt      : <u32 | max: 128>
@slab bpf_sym      : <u32 | max: 1024>
@slab bpf_shift    : <u32 | max: 1024>
@slab bpf_width    : <u32 | max: 1024>

@slab sp_sym       : <u32 | max: 512>
@slab sp_elem_ty   : <u32 | max: 512>
@slab sp_elem_sz   : <u32 | max: 512>
@slab sp_cap       : <u64 | max: 512>
@slab sp_vaddr     : <u64 | max: 512>

@slab fn_sym       : <u32 | max: 1024>
@slab fn_defined   : <u8  | max: 1024>
@slab fn_ret_ty    : <u32 | max: 1024>
@slab fn_arity     : <u32 | max: 1024>
@slab fn_pstart    : <u32 | max: 1024>
@slab fn_code_off  : <u32 | max: 1024>
@slab fn_param_ty  : <u32 | max: 8192>

@slab loc_sym      : <u32 | max: 2048>
@slab loc_ty       : <u32 | max: 2048>
@slab loc_disp     : <i64 | max: 2048>
@slab loc_depth    : <u32 | max: 2048>

@slab lp_cont_tgt  : <i64 | max: 64>
@slab lp_brk_head  : <i64 | max: 64>
@slab lp_cont_head : <i64 | max: 64>
@slab lp_tile_base : <i64 | max: 64>

@slab rec_jmp_head : <i64 | max: 64>
@slab rec_tile_base: <i64 | max: 64>

@slab patch_loc    : <u32 | max: 8192>
@slab patch_next   : <i64 | max: 8192>

@slab out_buf      : <u8  | max: 1048576>
@slab tgt_ro_buf   : <u8  | max: 262144>
@slab ro_fix_code  : <u32 | max: 16384>
@slab ro_fix_off   : <u32 | max: 16384>
@slab call_fix_off : <u32 | max: 32768>
@slab call_fix_fn  : <u32 | max: 32768>

// --- Fatal Diagnostics & Host Syscall Helpers ---

fn write_stderr_str(s: str) {
    @syscall(SYS_WRITE, 2, s.base, s.len)
}

fn write_stderr_u64(val: u64) {
    if val == 0 {
        write_stderr_str("0")
        return
    }
    n: u64 = val
    pos: i64 = 31
    loop <max: 32 | until: n == 0> {
        path_scratch[pos] = (n % 10) + '0'
        n /= 10
        pos -= 1
    }
    start: i64 = pos + 1
    cnt: i64 = 32 - start
    @syscall(SYS_WRITE, 2, path_scratch.base + start, cnt)
}

fn die_msg(msg: str) {
    write_stderr_str(msg)
    write_stderr_str("\n")
    @syscall(SYS_EXIT, 1)
}

fn die_line(msg: str, line: i64) {
    write_stderr_str(msg)
    if line > 0 {
        write_stderr_str(" at line ")
        write_stderr_u64(line)
    }
    write_stderr_str("\n")
    @syscall(SYS_EXIT, 1)
}

fn die_cur(msg: str) {
    idx := g[G_TOK_IDX]
    die_line(msg, tok_line[idx])
}

fn cstr_len(ptr: u64) u64 {
    v := @view<u8>(ptr, 4096)
    for i in 0..4096 {
        if v[i] == 0 {
            return i
        }
    }
    return 4096
}

fn cstr_eq_str(ptr: u64, s: str) i64 {
    n: u64 = cstr_len(ptr)
    if n != s.len {
        return 0
    }
    v := @view<u8>(ptr, n)
    for i in 0..n {
        if v[i] != s[i] {
            return 0
        }
    }
    return 1
}

// --- Hardware SSE4.2 `@crc32c` String / Symbol Interner ---

fn hash_bytes_pool(off: i64, len: i64) u64 {
    acc: u64 = 0xFFFF_FFFF
    for i in 0..len {
        b: u64 = str_pool[off + i]
        acc = @crc32c(acc, b)
    }
    if acc == 0 {
        return 1
    }
    return acc
}

fn pool_append_bytes(ptr: u64, len: u64) i64 {
    start := g[G_STR_OFF]
    if len > 0 {
        v := @view<u8>(ptr, len)
        for i in 0..len {
            str_pool[start + i] = v[i]
        }
        g[G_STR_OFF] = start + len
    }
    return start
}

fn sym_intern_pool(off: i64, len: i64) i64 {
    h: u64 = hash_bytes_pool(off, len)
    slot: u64 = h & 16383
    for probe in 0..16384 {
        id: u64 = sym_ht[slot]
        if id == 0 {
            new_id := g[G_SYM_CNT] + 1
            g[G_SYM_CNT] = new_id
            sym_off[new_id] = off
            sym_len[new_id] = len
            sym_ht[slot] = new_id
            return new_id
        }
        s_len: i64 = sym_len[id]
        if s_len == len {
            s_off: i64 = sym_off[id]
            same := 1
            for k in 0..len {
                if str_pool[s_off + k] != str_pool[off + k] {
                    same = 0
                    break
                }
            }
            if same == 1 {
                return id
            }
        }
        slot = (slot + 1) & 16383
    }
    die_msg("error: symbol table full")
    return 0
}

fn sym_intern_str(s: str) i64 {
    off := pool_append_bytes(s.base, s.len)
    return sym_intern_pool(off, s.len)
}

fn reg_kw(s: str, kw_id: i64) {
    id := sym_intern_str(s)
    sym_kw[id] = kw_id
}
