// --- Static `@slab` Arenas (Zero-Initialized in `Phdr[1]` `.bss`, 0 disk bytes) ---
@slab g             : <i64 | max: 512>

@slab src_buf       : <u8  | max: 2097152>
@slab imp_syms      : <u32 | max: 256>
@slab path_scratch  : <u8  | max: 4096>
@slab canon_buf     : <u8  | max: 4096>

@slab str_pool      : <u8  | max: 1048576>
@slab sym_off       : <u32 | max: 16384>
@slab sym_len       : <u32 | max: 16384>
@slab sym_kw        : <u8  | max: 16384>
@slab sym_ht        : <u32 | max: 32768>    // power-of-2 open-addressing table (& 32767)

@slab tok_kind      : <u8  | max: 262144>
@slab tok_kw        : <u8  | max: 262144>
@slab tok_line      : <u32 | max: 262144>
@slab tok_val       : <i64 | max: 262144>
@slab tok_aux       : <u32 | max: 262144>

@slab cst_sym       : <u32 | max: 4096>
@slab cst_tok       : <u32 | max: 4096>
@slab cst_line      : <u32 | max: 4096>
@slab cst_done      : <u8  | max: 4096>
@slab cst_val       : <i64 | max: 4096>

// Unified User Type table (`0 .. g[G_UT_CNT] - 1`):
//   - BitPack  -> `TY_BP_BASE + ut_idx`     (also mirrored in `bp_*[ut_idx]`)
//   - Struct   -> `TY_STRUCT_BASE + ut_idx` (`ut_kind == UKIND_STRUCT` or `UKIND_CELL64`)
//   - CustomPtr-> `TY_PTR_BASE + ut_idx`    (metadata in `ptr_*[ut_idx]`)
@slab ut_sym        : <u32 | max: 512>
@slab ut_kind       : <u8  | max: 512>
@slab ut_size       : <u32 | max: 512>      // 0 until resolved; byte size once resolved
@slab ut_align      : <u32 | max: 512>      // alignment in bytes (1 for <packed>, 64 for @cell64)
@slab ut_packed     : <u8  | max: 512>      // 1 if <packed>, else 0
@slab ut_fstart     : <u32 | max: 512>      // start in `fld_*` (structs) or `bpf_*` (bitpacks)
@slab ut_fcnt       : <u32 | max: 512>      // field count
@slab ut_tok        : <u32 | max: 512>      // prescan saved token index
@slab ut_line       : <u32 | max: 512>      // declaration line

// BitPack tables (indexed by `ut_idx = base - TY_BP_BASE`)
@slab bp_sym        : <u32 | max: 512>
@slab bp_bytes      : <u32 | max: 512>
@slab bp_fstart     : <u32 | max: 512>
@slab bp_fcnt       : <u32 | max: 512>
@slab bpf_sym       : <u32 | max: 2048>
@slab bpf_shift     : <u32 | max: 2048>
@slab bpf_width     : <u32 | max: 2048>

// Struct / `@cell64` field tables (indexed by `ut_fstart[ut_idx] .. +ut_fcnt[ut_idx]`)
@slab fld_sym       : <u32 | max: 4096>
@slab fld_ty        : <u32 | max: 4096>
@slab fld_off       : <u32 | max: 4096>
@slab fld_sz        : <u32 | max: 4096>

// Custom `@ptr<...>` metadata tables (indexed by `ut_idx = base - TY_PTR_BASE`)
@slab ptr_elem_ty   : <u32 | max: 512>
@slab ptr_stride    : <u32 | max: 512>      // byte stride (defaults to elem_size)
@slab ptr_mask      : <i64 | max: 512>      // 0 if unmasked; M if `mask: M`
@slab ptr_wrap_mask : <i64 | max: 512>      // 0 if unwrapped; (N - 1) if `wrap: N`
@slab ptr_bswap     : <u8  | max: 512>      // 1 if `bswap`, else 0
@slab ptr_has_mask  : <u8  | max: 512>      // 1 if `mask: M`, else 0
@slab ptr_has_wrap  : <u8  | max: 512>      // 1 if `wrap: N`, else 0

// Topological `@slab` / `@arena` / `@capsule` / `@ring` / `@dma_queue` / `@port` spaces
@slab sp_sym        : <u32 | max: 512>
@slab sp_kind       : <u32 | max: 512>      // SKIND_*
@slab sp_elem_ty    : <u32 | max: 512>
@slab sp_elem_sz    : <u32 | max: 512>
@slab sp_cap        : <u64 | max: 512>
@slab sp_vaddr      : <u64 | max: 512>      // ELF_DATA_BASE + sp_bss_off (or port_num for SKIND_PORT)
@slab sp_bss_off    : <u64 | max: 512>      // byte offset in `.bss` (4KiB-aligned)
@slab sp_port_num   : <u32 | max: 512>      // 0..0xFFFF for SKIND_PORT
@slab sp_align      : <u32 | max: 512>      // 4096 for `.bss` spaces, 0 for SKIND_PORT
@slab sp_tok        : <u32 | max: 512>      // prescan saved `<` token index
@slab sp_line       : <u32 | max: 512>      // prescan saved line

// Function symbol, parameter, `@isr`/`@isr_ok` attribute, & `@code_bytes` tables
@slab fn_sym        : <u32 | max: 2048>
@slab fn_defined    : <u8  | max: 2048>
@slab fn_isr_attr   : <u8  | max: 2048>     // 0 = normal, 1 = @isr, 2 = @isr_ok
@slab fn_ret_ty     : <u32 | max: 2048>
@slab fn_arity      : <u32 | max: 2048>
@slab fn_pstart     : <u32 | max: 2048>
@slab fn_code_off   : <u32 | max: 2048>
@slab fn_code_len   : <u32 | max: 2048>     // byte length of compiled fn
@slab fn_param_ty   : <u32 | max: 16384>

@slab loc_sym       : <u32 | max: 4096>
@slab loc_ty        : <u32 | max: 4096>
@slab loc_disp      : <i64 | max: 4096>
@slab loc_depth     : <u32 | max: 4096>

@slab lp_cont_tgt   : <i64 | max: 64>
@slab lp_brk_head   : <i64 | max: 64>
@slab lp_cont_head  : <i64 | max: 64>
@slab lp_tile_base  : <i64 | max: 64>

@slab rec_jmp_head  : <i64 | max: 64>
@slab rec_tile_base : <i64 | max: 64>

@slab patch_loc     : <u32 | max: 16384>
@slab patch_next    : <i64 | max: 16384>

@slab out_buf       : <u8  | max: 4194304>
@slab tgt_ro_buf    : <u8  | max: 262144>
@slab ro_fix_code   : <u32 | max: 16384>
@slab ro_fix_off    : <u32 | max: 16384>
@slab call_fix_off  : <u32 | max: 65536>
@slab call_fix_fn   : <u32 | max: 65536>
@slab fnlen_fix_off : <u32 | max: 4096>     // out_buf patch pos for `@code_bytes(fn)` len imm32
@slab fnlen_fix_fn  : <u32 | max: 4096>     // target fn_idx for `@code_bytes(fn)`
@slab bss_fix_code  : <u32 | max: 32768>    // out_buf patch pos for EFI RIP-rel `.bss` disp32
@slab bss_fix_off   : <i64 | max: 32768>    // signed `.bss` byte offset (`target_rva = bss_rva + bss_fix_off`)

// --- Fatal Diagnostics & Host Syscall Helpers ---

fn write_stderr_str(s: str) {
    @syscall(SYS_WRITE, 2, s.base, s.len)
}

fn write_stderr_u64(val: u64) {
    if val == 0 {
        write_stderr_str("0")
        return
    }
    n: u64 = val
    pos: i64 = 31
    loop <max: 32 | until: n == 0> {
        path_scratch[pos] = (n % 10) + '0'
        n /= 10
        pos -= 1
    }
    start: i64 = pos + 1
    cnt: i64 = 32 - start
    @syscall(SYS_WRITE, 2, path_scratch.base + start, cnt)
}

fn die_msg(msg: str) {
    write_stderr_str(msg)
    write_stderr_str("\n")
    @syscall(SYS_EXIT, 1)
}

fn die_line(msg: str, line: i64) {
    write_stderr_str(msg)
    if line > 0 {
        write_stderr_str(" at line ")
        write_stderr_u64(line)
    }
    write_stderr_str("\n")
    @syscall(SYS_EXIT, 1)
}

fn die_cur(msg: str) {
    idx := g[G_TOK_IDX]
    die_line(msg, tok_line[idx])
}

fn cstr_len(ptr: u64) u64 {
    v := @view<u8>(ptr, 4096)
    for i in 0..4096 {
        if v[i] == 0 {
            return i
        }
    }
    return 4096
}

fn cstr_eq_str(ptr: u64, s: str) i64 {
    n: u64 = cstr_len(ptr)
    if n != s.len {
        return 0
    }
    v := @view<u8>(ptr, n)
    for i in 0..n {
        if v[i] != s[i] {
            return 0
        }
    }
    return 1
}

// --- Hardware SSE4.2 `@crc32c` String / Symbol Interner ---

fn hash_bytes_pool(off: i64, len: i64) u64 {
    acc: u64 = 0xFFFF_FFFF
    for i in 0..len {
        b: u64 = str_pool[off + i]
        acc = @crc32c(acc, b)
    }
    if acc == 0 {
        return 1
    }
    return acc
}

fn pool_append_bytes(ptr: u64, len: u64) i64 {
    start := g[G_STR_OFF]
    if len > 0 {
        v := @view<u8>(ptr, len)
        for i in 0..len {
            str_pool[start + i] = v[i]
        }
        g[G_STR_OFF] = start + len
    }
    return start
}

fn sym_intern_pool(off: i64, len: i64) i64 {
    h: u64 = hash_bytes_pool(off, len)
    slot: u64 = h & 32767
    for probe in 0..32768 {
        id: u64 = sym_ht[slot]
        if id == 0 {
            new_id := g[G_SYM_CNT] + 1
            g[G_SYM_CNT] = new_id
            sym_off[new_id] = off
            sym_len[new_id] = len
            sym_ht[slot] = new_id
            return new_id
        }
        s_len: i64 = sym_len[id]
        if s_len == len {
            s_off: i64 = sym_off[id]
            same := 1
            for k in 0..len {
                if str_pool[s_off + k] != str_pool[off + k] {
                    same = 0
                    break
                }
            }
            if same == 1 {
                return id
            }
        }
        slot = (slot + 1) & 32767
    }
    die_msg("error: symbol table full")
    return 0
}

fn sym_intern_str(s: str) i64 {
    off := pool_append_bytes(s.base, s.len)
    return sym_intern_pool(off, s.len)
}

fn reg_kw(s: str, kw_id: i64) {
    id := sym_intern_str(s)
    sym_kw[id] = kw_id
}
