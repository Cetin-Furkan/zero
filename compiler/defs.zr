// =============================================================================
// Zero Stage-1 Self-Hosted Compiler — Core Tables & Host I/O (`compiler/defs.zr`)
// =============================================================================
// Pure `.zr`, zero C, zero LLVM, zero libc, zero heap/malloc: all compiler tables
// live in disjoint static `@slab` spaces inside `Phdr[1]` (`PF_R | PF_W` `.bss`).
// =============================================================================

// --- Linux x86-64 Syscall Numbers & Flags ---
SYS_READ        :: 0
SYS_WRITE       :: 1
SYS_CLOSE       :: 3
SYS_LSEEK       :: 8
SYS_EXIT        :: 60
SYS_FCHMOD      :: 91
SYS_OPENAT      :: 257

AT_FDCWD        :: -100
O_WR_TRUNC_CR   :: 577      // O_WRONLY(1) | O_CREAT(64) | O_TRUNC(512)
MODE_0755       :: 493      // 0o755
SEEK_END        :: 2

// --- Target Container & Bare-Metal UEFI Layout Constants ---
ELF_HDR_LEN           :: 176        // 64B Ehdr + 2 * 56B Phdr
ELF_TEXT_BASE         :: 0x400000
ELF_DATA_BASE         :: 0x10000000
ZCAP_HDR_LEN          :: 64

PE_HDR_FILE_SIZE      :: 0x00200    // 512B PE32+ header
PE_TEXT_RVA           :: 0x01000    // .text RVA in PE32+ image
EFI_BSS_HANDOFF_OFF   :: 0x00040
EFI_BSS_MEMMAP_OFF    :: 0x00100
EFI_BSS_RAW_MMAP_OFF  :: 0x04000
EFI_BSS_RAW_MMAP_CAP  :: 0x08000
EFI_BSS_STACK_TOP_OFF :: 0x1C000
EFI_BSS_ISR_LINE_OFF  :: 0x1C040
EFI_BSS_REACTOR_OFF   :: 0x1E000
EFI_BSS_USER_START    :: 0x20000

