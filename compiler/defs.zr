G_RO_FIX_CNT    :: 19
G_CALL_FIX_CNT  :: 20
G_RT_WRITE_OFF  :: 21
G_TOTAL_OUT     :: 22
G_LOC_CNT       :: 23
G_SCOPE_DEPTH   :: 24
G_FRAME_QW      :: 25
