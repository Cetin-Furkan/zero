// =============================================================================
// Zero Stage-1 Self-Hosted Compiler — x86-64 Code Emitter (`compiler/emit_x64.zr`)
// =============================================================================

fn emit_u8(b: i64) {
    off := g[G_CODE_OFF]
    out_buf[off] = b & 0xFF
    g[G_CODE_OFF] = off + 1
}

fn emit_u16(w: i64) {
    emit_u8(w & 0xFF)
    emit_u8((w >> 8) & 0xFF)
}

fn emit_u32(d: i64) {
    emit_u8(d & 0xFF)
    emit_u8((d >> 8) & 0xFF)
    emit_u8((d >> 16) & 0xFF)
    emit_u8((d >> 24) & 0xFF)
}

fn emit_u64(q: i64) {
    emit_u32(q)
    emit_u32(q >> 32)
}

fn patch_u32_at(pos: i64, val: i64) {
    out_buf[pos + 0] = val & 0xFF
    out_buf[pos + 1] = (val >> 8) & 0xFF
    out_buf[pos + 2] = (val >> 16) & 0xFF
    out_buf[pos + 3] = (val >> 24) & 0xFF
}

fn patch_u64_at(pos: i64, val: i64) {
    patch_u32_at(pos, val)
    patch_u32_at(pos + 4, val >> 32)
}

fn emit_mov_rax_imm64(val: i64) {
    if val == 0 {
        emit_u8(0x31)
        emit_u8(0xC0)   // xor eax, eax
        return
    }
    u: u64 = val
    if (u >> 32) == 0 {
        emit_u8(0xB8)   // mov eax, imm32 (zero-extends to 64-bit)
        emit_u32(val)
        return
    }
    emit_u8(0x48)
    emit_u8(0xB8)       // movabs rax, imm64
    emit_u64(val)
}

fn emit_mov_rcx_imm64(val: i64) {
    u: u64 = val
    if (u >> 32) == 0 {
        emit_u8(0xB9)   // mov ecx, imm32 (zero-extends to 64-bit, preserves RFLAGS)
        emit_u32(val)
        return
    }
    emit_u8(0x48)
    emit_u8(0xB9)       // movabs rcx, imm64
    emit_u64(val)
}

// --- Target-Aware `.bss` Space Base & `@isr_stub_base` Emitters ---

// Records a 4-byte RIP-relative `.bss` displacement at current `g[G_CODE_OFF]`
fn emit_efi_bss_disp32(bss_off: i64) {
    fx := g[G_BSS_FIX_CNT]
    bss_fix_code[fx] = g[G_CODE_OFF]
    bss_fix_off[fx]  = bss_off
    g[G_BSS_FIX_CNT] = fx + 1
    emit_u32(0)
}

// Loads topological space `si` base address into `rax` (`RIP`-rel on EFI, `imm` on ELF64)
fn emit_load_space_base_rax(si: i64) {
    if g[G_MODE_EFI] == 1 && g[G_MODE_CAPSULE] == 0 {
        emit_u8(0x48)  emit_u8(0x8D)  emit_u8(0x05) // lea rax, [rip + disp32]
        emit_efi_bss_disp32(sp_bss_off[si])
        return
    }
    emit_mov_rax_imm64(sp_vaddr[si])
}

// Loads topological space `si` base address into `rcx` (preserves `rax`!)
fn emit_load_space_base_rcx(si: i64) {
    if g[G_MODE_EFI] == 1 && g[G_MODE_CAPSULE] == 0 {
        emit_u8(0x48)  emit_u8(0x8D)  emit_u8(0x0D) // lea rcx, [rip + disp32]
        emit_efi_bss_disp32(sp_bss_off[si])
        return
    }
    emit_mov_rcx_imm64(sp_vaddr[si])
}

// Convenience vaddr-taking variants (`vaddr = ELF_DATA_BASE + bss_off`)
fn emit_load_bss_vaddr_rax(vaddr: i64) {
    if g[G_MODE_EFI] == 1 && g[G_MODE_CAPSULE] == 0 {
        emit_u8(0x48)  emit_u8(0x8D)  emit_u8(0x05)
        emit_efi_bss_disp32(vaddr - ELF_DATA_BASE)
        return
    }
    emit_mov_rax_imm64(vaddr)
}

fn emit_load_bss_vaddr_rcx(vaddr: i64) {
    if g[G_MODE_EFI] == 1 && g[G_MODE_CAPSULE] == 0 {
        emit_u8(0x48)  emit_u8(0x8D)  emit_u8(0x0D)
        emit_efi_bss_disp32(vaddr - ELF_DATA_BASE)
        return
    }
    emit_mov_rcx_imm64(vaddr)
}

// Emits `lea rax, [rip + disp32]` targeting the 256-entry ISR stub table in `.text`
fn emit_isr_stub_base_rax() {
    emit_u8(0x48)  emit_u8(0x8D)  emit_u8(0x05)
    disp := g[G_EFI_ISR_STUBS_OFF] - (g[G_CODE_OFF] + 4)
    emit_u32(disp)
}

// --- Frame-Allocated Temporaries & `[rbp + disp]` Local Accessors ---

fn alloc_temp_qword() i64 {
    g[G_TEMP_DEPTH] += 1
    total := g[G_FRAME_QW] + g[G_TEMP_DEPTH]
    if total > g[G_MAX_FRAME_QW] {
        g[G_MAX_FRAME_QW] = total
    }
    return -(total * 8)
}

fn free_temp_qwords(cnt: i64) {
    g[G_TEMP_DEPTH] -= cnt
}

fn alloc_anon_qwords(cnt: i64) i64 {
    cur := g[G_FRAME_QW] + g[G_TEMP_DEPTH] + cnt
    g[G_FRAME_QW] = cur
    if cur > g[G_MAX_FRAME_QW] {
        g[G_MAX_FRAME_QW] = cur
    }
    return -(cur * 8)
}

fn emit_load_local(disp: i64) {
    if disp >= -128 && disp <= 127 {
        emit_u8(0x48)
        emit_u8(0x8B)
        emit_u8(0x45)
        emit_u8(disp)
    } else {
        emit_u8(0x48)
        emit_u8(0x8B)
        emit_u8(0x85)
        emit_u32(disp)
    }
}

fn emit_load_local_rcx(disp: i64) {
    if disp >= -128 && disp <= 127 {
        emit_u8(0x48)
        emit_u8(0x8B)
        emit_u8(0x4D)
        emit_u8(disp)
    } else {
        emit_u8(0x48)
        emit_u8(0x8B)
        emit_u8(0x8D)
        emit_u32(disp)
    }
}

fn emit_store_local(disp: i64) {
    if disp >= -128 && disp <= 127 {
        emit_u8(0x48)
        emit_u8(0x89)
        emit_u8(0x45)
        emit_u8(disp)
    } else {
        emit_u8(0x48)
        emit_u8(0x89)
        emit_u8(0x85)
        emit_u32(disp)
    }
}

fn emit_inc_local_qword(disp: i64) {
    if disp >= -128 && disp <= 127 {
        emit_u8(0x48)  emit_u8(0xFF)  emit_u8(0x45)  emit_u8(disp)
    } else {
        emit_u8(0x48)  emit_u8(0xFF)  emit_u8(0x85)  emit_u32(disp)
    }
}

fn emit_lea_local(disp: i64) {
    if disp >= -128 && disp <= 127 {
        emit_u8(0x48)
        emit_u8(0x8D)
        emit_u8(0x45)
        emit_u8(disp)
    } else {
        emit_u8(0x48)
        emit_u8(0x8D)
        emit_u8(0x85)
        emit_u32(disp)
    }
}

fn emit_lea_local_rcx(disp: i64) {
    if disp >= -128 && disp <= 127 {
        emit_u8(0x48)
        emit_u8(0x8D)
        emit_u8(0x4D)
        emit_u8(disp)
    } else {
        emit_u8(0x48)
        emit_u8(0x8D)
        emit_u8(0x8D)
        emit_u32(disp)
    }
}

// Width-exact load of scalar / bitpack / pointer local `[rbp + disp]` directly into `rcx`
fn emit_load_local_typed_rcx(disp: i64, ty: i64) {
    if (ty & (TY_FLAG_VIEW1 | TY_FLAG_ATOMIC)) != 0 {
        emit_load_local_rcx(disp)
        return
    }
    base := ty & TY_BASE_MASK
    if base >= TY_PTR_BASE {
        emit_load_local_rcx(disp)
        return
    }
    if base >= TY_BP_BASE && base < TY_STRUCT_BASE {
        bsz: i64 = bp_bytes[base - TY_BP_BASE]
        if bsz == 1 { base = TY_U8 }
        if bsz == 2 { base = TY_U16 }
        if bsz == 4 { base = TY_U32 }
        if bsz == 8 { base = TY_U64 }
    }
    is_d8 := 0
    if disp >= -128 && disp <= 127 { is_d8 = 1 }

    if base == TY_U8 {
        emit_u8(0x0F)  emit_u8(0xB6)
        if is_d8 == 1 { emit_u8(0x4D)  emit_u8(disp) } else { emit_u8(0x8D)  emit_u32(disp) }
        return
    }
    if base == TY_I8 {
        emit_u8(0x48)  emit_u8(0x0F)  emit_u8(0xBE)
        if is_d8 == 1 { emit_u8(0x4D)  emit_u8(disp) } else { emit_u8(0x8D)  emit_u32(disp) }
        return
    }
    if base == TY_U16 {
        emit_u8(0x0F)  emit_u8(0xB7)
        if is_d8 == 1 { emit_u8(0x4D)  emit_u8(disp) } else { emit_u8(0x8D)  emit_u32(disp) }
        return
    }
    if base == TY_I16 {
        emit_u8(0x48)  emit_u8(0x0F)  emit_u8(0xBF)
        if is_d8 == 1 { emit_u8(0x4D)  emit_u8(disp) } else { emit_u8(0x8D)  emit_u32(disp) }
        return
    }
    if base == TY_U32 {
        emit_u8(0x8B)
        if is_d8 == 1 { emit_u8(0x4D)  emit_u8(disp) } else { emit_u8(0x8D)  emit_u32(disp) }
        return
    }
    if base == TY_I32 {
        emit_u8(0x48)  emit_u8(0x63)
        if is_d8 == 1 { emit_u8(0x4D)  emit_u8(disp) } else { emit_u8(0x8D)  emit_u32(disp) }
        return
    }
    emit_load_local_rcx(disp)
}

// --- Relative Branches, Calls, `@code_bytes`, & Patch Chains ---

fn emit_jmp_rel32() i64 {
    emit_u8(0xE9)
    pos := g[G_CODE_OFF]
    emit_u32(0)
    return pos
}

fn emit_jz_rel32() i64 {
    emit_u8(0x48)
    emit_u8(0x85)
    emit_u8(0xC0)       // test rax, rax
    emit_u8(0x0F)
    emit_u8(0x84)       // jz rel32
    pos := g[G_CODE_OFF]
    emit_u32(0)
    return pos
}

fn emit_jnz_rel32() i64 {
    emit_u8(0x48)
    emit_u8(0x85)
    emit_u8(0xC0)       // test rax, rax
    emit_u8(0x0F)
    emit_u8(0x85)       // jnz rel32
    pos := g[G_CODE_OFF]
    emit_u32(0)
    return pos
}

fn patch_rel32_here(pos: i64) {
    disp_rel := g[G_CODE_OFF] - (pos + 4)
    patch_u32_at(pos, disp_rel)
}

fn emit_jmp_to(target_off: i64) {
    emit_u8(0xE9)
    disp_rel := target_off - (g[G_CODE_OFF] + 4)
    emit_u32(disp_rel)
}

fn emit_call_direct_off(target_off: i64) {
    emit_u8(0xE8)
    disp_rel := target_off - (g[G_CODE_OFF] + 4)
    emit_u32(disp_rel)
}

fn emit_call_fn_idx(fn_idx: i64) {
    if g[G_IN_ISR_MODE] != 0 {
        if g[G_IN_ISR_MODE] == 2 || fn_isr_attr[fn_idx] != 2 {
            die_cur("error: @isr/@isr_ok forbids non-@isr_ok function calls")
        }
    }
    emit_u8(0xE8)
    fx := g[G_CALL_FIX_CNT]
    call_fix_off[fx] = g[G_CODE_OFF]
    call_fix_fn[fx]  = fn_idx
    g[G_CALL_FIX_CNT] = fx + 1
    emit_u32(0)
}

// Records a 4-byte imm32 patch for compiled function `fn_idx`'s byte length (`@code_bytes`)
fn record_fnlen_fixup(fn_idx: i64) {
    fx := g[G_FNLEN_FIX_CNT]
    fnlen_fix_off[fx] = g[G_CODE_OFF]
    fnlen_fix_fn[fx]  = fn_idx
    g[G_FNLEN_FIX_CNT] = fx + 1
    emit_u32(0)
}

// Materializes `@code_bytes(fn)` 16B `bytes` span `{ fn_addr, fn_byte_len }` -> `rax = &slot`
fn emit_code_bytes_expr(fn_idx: i64) {
    slot := alloc_anon_qwords(2)
    emit_u8(0x48)  emit_u8(0x8D)  emit_u8(0x05) // lea rax, [rip + rel32]
    fx := g[G_CALL_FIX_CNT]
    call_fix_off[fx] = g[G_CODE_OFF]
    call_fix_fn[fx]  = fn_idx
    g[G_CALL_FIX_CNT] = fx + 1
    emit_u32(0)
    emit_store_local(slot)

    emit_u8(0xB8)                                // mov eax, <fn_code_len>
    record_fnlen_fixup(fn_idx)
    emit_store_local(slot + 8)

    emit_lea_local(slot)
    g[G_LAST_EXPR_TY] = TY_U8 | TY_FLAG_SPAN
}

fn push_patch_node(head: i64, pos: i64) i64 {
    idx := g[G_PATCH_CNT]
    patch_loc[idx]  = pos
    patch_next[idx] = head
    g[G_PATCH_CNT] = idx + 1
    return idx
}

fn resolve_patch_chain(head: i64) {
    cur := head
    loop <max: 16384 | until: cur < 0> {
        patch_rel32_here(patch_loc[cur])
        cur = patch_next[cur]
    }
}

// --- Type Width Helpers, Narrow Truncation, & Memory Load/Store ---

fn is_ty_unsigned(ty: i64) i64 {
    if (ty & (TY_FLAG_VIEW1 | TY_FLAG_SPAN)) != 0 { return 1 }
    base := ty & TY_BASE_MASK
    if base == TY_U64 || base == TY_U32 || base == TY_U16 || base == TY_U8 {
        return 1
    }
    if base == TY_U32X16 || base == TY_U64X8 {
        return 1
    }
    if base >= TY_BP_BASE && base < TY_STRUCT_BASE {
        return 1
    }
    return 0
}

fn ty_byte_size(ty: i64) i64 {
    if (ty & TY_FLAG_SPAN) != 0 { return 16 }
    if (ty & (TY_FLAG_VIEW1 | TY_FLAG_ATOMIC)) != 0 { return 8 }
    base := ty & TY_BASE_MASK
    if base == TY_U8  || base == TY_I8  { return 1 }
    if base == TY_U16 || base == TY_I16 { return 2 }
    if base == TY_U32 || base == TY_I32 { return 4 }
    if base == TY_U32X16 || base == TY_U64X8 { return 64 }
    if base >= TY_PTR_BASE    { return 8 }
    if base >= TY_STRUCT_BASE { return ut_size[base - TY_STRUCT_BASE] }
    if base >= TY_BP_BASE     { return bp_bytes[base - TY_BP_BASE] }
    return 8
}

fn emit_narrow_rax(ty: i64) {
    if (ty & (TY_FLAG_VIEW1 | TY_FLAG_SPAN | TY_FLAG_ATOMIC)) != 0 { return }
    base := ty & TY_BASE_MASK
    if base == TY_U32X16 || base == TY_U64X8 { return }
    if base >= TY_STRUCT_BASE { return }
    if base >= TY_BP_BASE {
        bsz: i64 = bp_bytes[base - TY_BP_BASE]
        if bsz == 1 { base = TY_U8 }
        if bsz == 2 { base = TY_U16 }
        if bsz == 4 { base = TY_U32 }
        if bsz == 8 { return }
    }
    if base == TY_U8  { emit_u8(0x0F)  emit_u8(0xB6)  emit_u8(0xC0)  return }
    if base == TY_I8  { emit_u8(0x48)  emit_u8(0x0F)  emit_u8(0xBE)  emit_u8(0xC0)  return }
    if base == TY_U16 { emit_u8(0x0F)  emit_u8(0xB7)  emit_u8(0xC0)  return }
    if base == TY_I16 { emit_u8(0x48)  emit_u8(0x0F)  emit_u8(0xBF)  emit_u8(0xC0)  return }
    if base == TY_U32 { emit_u8(0x89)  emit_u8(0xC0)  return }
    if base == TY_I32 { emit_u8(0x48)  emit_u8(0x63)  emit_u8(0xC0)  return }
}

// Guest `rax` = source address -> loads into `rax` (`zmm0` for 512b vectors, `&struct` for structs)
fn emit_load_mem_typed(ty: i64) {
    if (ty & (TY_FLAG_VIEW1 | TY_FLAG_ATOMIC)) != 0 {
        emit_u8(0x48)  emit_u8(0x8B)  emit_u8(0x00)
        return
    }
    base := ty & TY_BASE_MASK
    if base == TY_U32X16 {
        emit_zmm0_load32_rax()
        return
    }
    if base == TY_U64X8 {
        emit_zmm0_load64_rax()
        return
    }
    if base >= TY_PTR_BASE {
        emit_u8(0x48)  emit_u8(0x8B)  emit_u8(0x00)
        return
    }
    if base >= TY_STRUCT_BASE {
        // Structs / `@cell64` leave their address in `rax`
        return
    }
    if base >= TY_BP_BASE {
        bsz: i64 = bp_bytes[base - TY_BP_BASE]
        if bsz == 1 { base = TY_U8 }
        if bsz == 2 { base = TY_U16 }
        if bsz == 4 { base = TY_U32 }
        if bsz == 8 { base = TY_U64 }
    }
    if base == TY_U8  { emit_u8(0x0F)  emit_u8(0xB6)  emit_u8(0x00)  return }
    if base == TY_I8  { emit_u8(0x48)  emit_u8(0x0F)  emit_u8(0xBE)  emit_u8(0x00)  return }
    if base == TY_U16 { emit_u8(0x0F)  emit_u8(0xB7)  emit_u8(0x00)  return }
    if base == TY_I16 { emit_u8(0x48)  emit_u8(0x0F)  emit_u8(0xBF)  emit_u8(0x00)  return }
    if base == TY_U32 { emit_u8(0x8B)  emit_u8(0x00)  return }
    if base == TY_I32 { emit_u8(0x48)  emit_u8(0x63)  emit_u8(0x00)  return }
    emit_u8(0x48)  emit_u8(0x8B)  emit_u8(0x00)
}

// Guest `rcx` = destination address, `rax` = value (`zmm0` for 512b vectors, `&src` for structs)
fn emit_store_mem_typed(ty: i64) {
    if (ty & (TY_FLAG_VIEW1 | TY_FLAG_ATOMIC)) != 0 {
        emit_u8(0x48)  emit_u8(0x89)  emit_u8(0x01)
        return
    }
    if (ty & TY_FLAG_STREAM) != 0 {
        sbase := ty & TY_BASE_MASK
        if sbase == TY_U32X16 || sbase == TY_U64X8 {
            emit_zmm0_stream_rcx()
            return
        }
        bsz := ty_byte_size(sbase)
        if bsz != 4 {
            emit_u8(0x48)
        }
        emit_u8(0x0F)  emit_u8(0xC3)  emit_u8(0x01) // movnti [rcx], eax / rax
        return
    }
    base := ty & TY_BASE_MASK
    if base == TY_U32X16 {
        emit_zmm0_store32_rcx()
        return
    }
    if base == TY_U64X8 {
        emit_zmm0_store64_rcx()
        return
    }
    if base >= TY_PTR_BASE {
        emit_u8(0x48)  emit_u8(0x89)  emit_u8(0x01)
        return
    }
    if base >= TY_STRUCT_BASE {
        sz: i64 = ut_size[base - TY_STRUCT_BASE]
        if sz > 0 {
            emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC6) // mov rsi, rax (src)
            emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xCF) // mov rdi, rcx (dst)
            emit_u8(0xB9)  emit_u32(sz)                 // mov ecx, byte_size
            emit_u8(0xF3)  emit_u8(0xA4)                // rep movsb
        }
        return
    }
    if base >= TY_BP_BASE {
        bsz: i64 = bp_bytes[base - TY_BP_BASE]
        if bsz == 1 { base = TY_U8 }
        if bsz == 2 { base = TY_U16 }
        if bsz == 4 { base = TY_U32 }
        if bsz == 8 { base = TY_U64 }
    }
    if base == TY_U8  || base == TY_I8  { emit_u8(0x88)  emit_u8(0x01)  return }
    if base == TY_U16 || base == TY_I16 { emit_u8(0x66)  emit_u8(0x89)  emit_u8(0x01)  return }
    if base == TY_U32 || base == TY_I32 { emit_u8(0x89)  emit_u8(0x01)  return }
    emit_u8(0x48)  emit_u8(0x89)  emit_u8(0x01)
}

// --- 2-Register `RAX:RDX` Span Return & `@isr` Hardware Interrupt Gate ---

// Callee side: loads `{ base, len }` pointed to by `rax` into `RAX:RDX` before `leave; ret`
fn emit_pack_span_ret_rax_rdx() {
    emit_u8(0x48)  emit_u8(0x8B)  emit_u8(0x50)  emit_u8(0x08) // mov rdx, [rax + 8]
    emit_u8(0x48)  emit_u8(0x8B)  emit_u8(0x00)                // mov rax, [rax]
}

// Caller side: spills `RAX:RDX` returned from a span-returning call into a 16B local slot -> `rax = &slot`
fn emit_unpack_span_ret_rax_rdx() {
    emit_u8(0x49)  emit_u8(0x89)  emit_u8(0xD0) // mov r8, rdx (`len`)
    slot := alloc_anon_qwords(2)
    emit_store_local(slot)                      // [rbp + slot] = base (`rax`)
    emit_u8(0x4C)  emit_u8(0x89)  emit_u8(0xC0) // mov rax, r8
    emit_store_local(slot + 8)                  // [rbp + slot + 8] = len
    emit_lea_local(slot)
}

// `@isr` GPR-only interrupt prologue (0 XSAVE!): returns `sub rsp, <imm32>` patch offset
fn emit_isr_prologue() i64 {
    emit_u8(0x55)                               // push rbp
    emit_u8(0x50)  emit_u8(0x51)  emit_u8(0x52) // push rax; push rcx; push rdx
    emit_u8(0x56)  emit_u8(0x57)                // push rsi; push rdi
    emit_u8(0x41)  emit_u8(0x50)                // push r8
    emit_u8(0x41)  emit_u8(0x51)                // push r9
    emit_u8(0x41)  emit_u8(0x52)                // push r10
    emit_u8(0x41)  emit_u8(0x53)                // push r11
    emit_u8(0xFC)                               // cld
    emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xE5) // mov rbp, rsp
    emit_u8(0x48)  emit_u8(0x81)  emit_u8(0xEC) // sub rsp, <imm32>
    patch_pos := g[G_CODE_OFF]
    emit_u32(0)
    emit_u8(0x48)  emit_u8(0x83)  emit_u8(0xE4)  emit_u8(0xF0) // and rsp, -16
    return patch_pos
}

// `@isr` GPR-only interrupt epilogue (`iretq`)
fn emit_isr_epilogue() {
    emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xEC) // mov rsp, rbp
    emit_u8(0x41)  emit_u8(0x5B)                // pop r11
    emit_u8(0x41)  emit_u8(0x5A)                // pop r10
    emit_u8(0x41)  emit_u8(0x59)                // pop r9
    emit_u8(0x41)  emit_u8(0x58)                // pop r8
    emit_u8(0x5F)  emit_u8(0x5E)                // pop rdi; pop rsi
    emit_u8(0x5A)  emit_u8(0x59)  emit_u8(0x58) // pop rdx; pop rcx; pop rax
    emit_u8(0x5D)                               // pop rbp
    emit_u8(0x48)  emit_u8(0xCF)                // iretq
}

// --- Target-Aware Scalar Fault Word, `<tile>` Unwind (`vzeroupper`), & Bounds/Null Guards ---

fn emit_tile_enter_seq() {
    if g[G_IN_ISR_MODE] != 0 {
        die_cur("error: @isr/@isr_ok forbids tile blocks")
    }
    // cmp qword [gs:8], 0; jne +18; pushfq; pop rax; shr eax, 9; and eax, 1; mov [gs:16], rax; cli; inc qword [gs:8]
    emit_u8(0x65)  emit_u8(0x48)  emit_u8(0x83)  emit_u8(0x3C)  emit_u8(0x25)
    emit_u32(8)    emit_u8(0)
    emit_u8(0x75)  emit_u8(0x12)
    emit_u8(0x9C)  emit_u8(0x58)
    emit_u8(0xC1)  emit_u8(0xE8)  emit_u8(9)
    emit_u8(0x83)  emit_u8(0xE0)  emit_u8(1)
    emit_u8(0x65)  emit_u8(0x48)  emit_u8(0x89)  emit_u8(0x04)  emit_u8(0x25)
    emit_u32(16)
    emit_u8(0xFA)
    emit_u8(0x65)  emit_u8(0x48)  emit_u8(0xFF)  emit_u8(0x04)  emit_u8(0x25)
    emit_u32(8)
}

fn emit_tile_exit_seq() {
    // dec qword [gs:8]; jnz .still; [vzeroupper if G_TILE_USED_ZMM]; cmp qword [gs:16], 0; je .still; sti
    emit_u8(0x65)  emit_u8(0x48)  emit_u8(0xFF)  emit_u8(0x0C)  emit_u8(0x25)
    emit_u32(8)
    if g[G_TILE_USED_ZMM] == 1 {
        emit_u8(0x75)  emit_u8(0x10)
        emit_vzeroupper()
    } else {
        emit_u8(0x75)  emit_u8(0x0D)
    }
    emit_u8(0x65)  emit_u8(0x48)  emit_u8(0x83)  emit_u8(0x3C)  emit_u8(0x25)
    emit_u32(16)   emit_u8(0)
    emit_u8(0x74)  emit_u8(0x01)
    emit_u8(0xFB)
}

fn emit_tile_unwind_count(cnt: i64) {
    if cnt <= 0 { return }
    // sub qword [gs:8], cnt; jnz .still; [vzeroupper if G_TILE_USED_ZMM]; cmp qword [gs:16], 0; je .still; sti
    emit_u8(0x65)  emit_u8(0x48)  emit_u8(0x83)  emit_u8(0x2C)  emit_u8(0x25)
    emit_u32(8)    emit_u8(cnt & 0xFF)
    if g[G_TILE_USED_ZMM] == 1 {
        emit_u8(0x75)  emit_u8(0x10)
        emit_vzeroupper()
    } else {
        emit_u8(0x75)  emit_u8(0x0D)
    }
    emit_u8(0x65)  emit_u8(0x48)  emit_u8(0x83)  emit_u8(0x3C)  emit_u8(0x25)
    emit_u32(16)   emit_u8(0)
    emit_u8(0x74)  emit_u8(0x01)
    emit_u8(0xFB)
}

fn emit_fault_store_imm(code: i64) {
    if g[G_IN_ISR_MODE] != 0 {
        die_cur("error: @isr/@isr_ok forbids fault raising")
    }
    if g[G_MODE_EFI] == 1 || g[G_MODE_CAPSULE] == 1 {
        emit_u8(0x65)  emit_u8(0x48)  emit_u8(0xC7)  emit_u8(0x04)  emit_u8(0x25)
        emit_u32(0)
        emit_u32(code)
    } else {
        emit_u8(0xBA)  emit_u32(ELF_DATA_BASE)
        emit_u8(0x48)  emit_u8(0xC7)  emit_u8(0x02)
        emit_u32(code)
    }
}

fn emit_fault_store_rax() {
    if g[G_IN_ISR_MODE] != 0 {
        die_cur("error: @isr/@isr_ok forbids fault raising")
    }
    if g[G_MODE_EFI] == 1 || g[G_MODE_CAPSULE] == 1 {
        emit_u8(0x65)  emit_u8(0x48)  emit_u8(0x89)  emit_u8(0x04)  emit_u8(0x25)
        emit_u32(0)
    } else {
        emit_u8(0xB9)  emit_u32(ELF_DATA_BASE)
        emit_u8(0x48)  emit_u8(0x89)  emit_u8(0x01)
    }
}

fn emit_fault_cmp_zero() {
    if g[G_MODE_EFI] == 1 || g[G_MODE_CAPSULE] == 1 {
        emit_u8(0x65)  emit_u8(0x48)  emit_u8(0x83)  emit_u8(0x3C)  emit_u8(0x25)
        emit_u32(0)    emit_u8(0)
    } else {
        emit_u8(0xB9)  emit_u32(ELF_DATA_BASE)
        emit_u8(0x48)  emit_u8(0x83)  emit_u8(0x39)  emit_u8(0)
    }
}

fn emit_fault_take_rax() {
    if g[G_MODE_EFI] == 1 || g[G_MODE_CAPSULE] == 1 {
        emit_u8(0x65)  emit_u8(0x48)  emit_u8(0x8B)  emit_u8(0x04)  emit_u8(0x25)
        emit_u32(0)
        emit_u8(0x65)  emit_u8(0x48)  emit_u8(0xC7)  emit_u8(0x04)  emit_u8(0x25)
        emit_u32(0)    emit_u32(0)
    } else {
        emit_u8(0xB9)  emit_u32(ELF_DATA_BASE)
        emit_u8(0x48)  emit_u8(0x8B)  emit_u8(0x01)
        emit_u8(0x31)  emit_u8(0xD2)
        emit_u8(0x48)  emit_u8(0x89)  emit_u8(0x11)
    }
}

fn emit_unwind_or_return_fault() {
    rd := g[G_REC_DEPTH]
    if rd > 0 {
        top := rd - 1
        emit_tile_unwind_count(g[G_TILE_DEPTH] - rec_tile_base[top])
        jpos := emit_jmp_rel32()
        rec_jmp_head[top] = push_patch_node(rec_jmp_head[top], jpos)
    } else {
        emit_tile_unwind_count(g[G_TILE_DEPTH])
        emit_u8(0x31)  emit_u8(0xC0)   // xor eax, eax
        emit_u8(0xC9)  emit_u8(0xC3)   // leave; ret
    }
}

fn emit_raise_fault_imm(code: i64) {
    emit_fault_store_imm(code)
    emit_unwind_or_return_fault()
}

fn emit_check_call_fault() {
    if g[G_IN_ISR_MODE] != 0 {
        return
    }
    emit_fault_cmp_zero()
    emit_u8(0x0F)  emit_u8(0x84)       // jz .ok
    ok_pos := g[G_CODE_OFF]
    emit_u32(0)
    emit_unwind_or_return_fault()
    patch_rel32_here(ok_pos)
}

// Unsigned bounds check `rax >= cap -> fail 2` (preserves `rax`)
fn emit_bounds_check_rax(cap: i64) {
    emit_mov_rcx_imm64(cap)
    emit_u8(0x48)  emit_u8(0x39)  emit_u8(0xC8) // cmp rax, rcx
    emit_u8(0x0F)  emit_u8(0x82)                // jb .ok
    ok_pos := g[G_CODE_OFF]
    emit_u32(0)
    emit_raise_fault_imm(2)
    patch_rel32_here(ok_pos)
}

// Unsigned span bounds check `rax >= [rbp + span_disp + 8] -> fail 2` (preserves `rax`)
fn emit_span_bounds_check_rax(span_disp: i64) {
    emit_load_local_rcx(span_disp + 8)
    emit_u8(0x48)  emit_u8(0x39)  emit_u8(0xC8) // cmp rax, rcx
    emit_u8(0x0F)  emit_u8(0x82)                // jb .ok
    ok_pos := g[G_CODE_OFF]
    emit_u32(0)
    emit_raise_fault_imm(2)
    patch_rel32_here(ok_pos)
}

// Non-null check `rax == 0 -> fail 3` (preserves `rax`)
fn emit_null_check_rax() {
    emit_u8(0x48)  emit_u8(0x85)  emit_u8(0xC0) // test rax, rax
    emit_u8(0x0F)  emit_u8(0x85)                // jnz .ok
    ok_pos := g[G_CODE_OFF]
    emit_u32(0)
    emit_raise_fault_imm(3)
    patch_rel32_here(ok_pos)
}

fn emit_move_rax_to_arg3() {
    if g[G_MODE_EFI] == 1 || g[G_MODE_CAPSULE] == 1 {
        emit_u8(0x49)  emit_u8(0x89)  emit_u8(0xC2) // mov r10, rax (Reactor ABI)
    } else {
        emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC1) // mov rcx, rax (abi-host)
    }
}

// --- Immediate-RHS & Local-RHS Register Elision Instruction Selectors ---

fn imm_next_binop_prec(idx: i64) i64 {
    k := tok_kind[idx]
    if k == TOK_PIPE_GT { return 1 }
    if k == TOK_OR2     { return 2 }
    if k == TOK_AND2    { return 3 }
    if k == TOK_PIPE    { return 4 }
    if k == TOK_CARET   { return 5 }
    if k == TOK_AMP     { return 6 }
    if k == TOK_EQ || k == TOK_NE { return 7 }
    if k == TOK_LT || k == TOK_LE || k == TOK_GT || k == TOK_GE { return 8 }
    if k == TOK_SHL || k == TOK_SHR || k == TOK_ROL || k == TOK_ROR { return 9 }
    if k == TOK_PLUS || k == TOK_MINUS { return 10 }
    if k == TOK_STAR || k == TOK_SLASH || k == TOK_PERCENT { return 11 }
    return 0
}

fn emit_add_rax_imm32(imm: i64) {
    if imm == 0 { return }
    if imm >= -128 && imm <= 127 {
        emit_u8(0x48)  emit_u8(0x83)  emit_u8(0xC0)  emit_u8(imm)
    } else {
        emit_u8(0x48)  emit_u8(0x05)  emit_u32(imm)
    }
}

fn emit_sub_rax_imm32(imm: i64) {
    if imm == 0 { return }
    if imm >= -128 && imm <= 127 {
        emit_u8(0x48)  emit_u8(0x83)  emit_u8(0xE8)  emit_u8(imm)
    } else {
        emit_u8(0x48)  emit_u8(0x2D)  emit_u32(imm)
    }
}

fn emit_shl_rax_imm(sh: i64) {
    if sh <= 0 { return }
    if sh == 1 {
        emit_u8(0x48)  emit_u8(0xD1)  emit_u8(0xE0)
    } else {
        emit_u8(0x48)  emit_u8(0xC1)  emit_u8(0xE0)  emit_u8(sh)
    }
}

// Called right after consuming binary operator `op` (`prec`, `lhs_ty`):
// Returns `1` if handled as compact immediate x86-64 instruction (advancing `g[G_TOK_IDX]`
// and updating `g[G_LAST_EXPR_TY]`), or `0` to fall back to general RHS evaluation.
fn try_emit_imm_rhs_binop(op: i64, prec: i64, lhs_ty: i64) i64 {
    if (lhs_ty & TY_FLAG_SPAN) != 0 { return 0 }
    lbase := lhs_ty & TY_BASE_MASK
    if (lhs_ty & (TY_FLAG_VIEW1 | TY_FLAG_ATOMIC)) == 0 {
        if lbase == TY_U32X16 || lbase == TY_U64X8 { return 0 }
        if lbase >= TY_STRUCT_BASE && lbase < TY_PTR_BASE { return 0 }
    }

    idx := g[G_TOK_IDX]
    tk  := tok_kind[idx]
    nk  := tok_kind[idx + 1]
    imm: i64 = 0

    // Reject if followed by postfix call/index/slice/member/struct/descriptor token
    if nk == TOK_LPAREN || nk == TOK_LBRACK || nk == TOK_DOT || nk == TOK_LBRACE {
        return 0
    }

    if tk == TOK_INT || tk == TOK_CHAR {
        imm = tok_val[idx]
    } else {
        if tk != TOK_IDENT { return 0 }
        if nk == TOK_LT    { return 0 }
        sym := tok_val[idx]

        // Respect local and space shadowing before resolving compile-time constant
        l_cnt := g[G_LOC_CNT]
        for li in 0..l_cnt {
            if loc_sym[li] == sym { return 0 }
        }
        s_cnt := g[G_SP_CNT]
        for si in 0..s_cnt {
            if sp_sym[si] == sym { return 0 }
        }
        c_cnt := g[G_CST_CNT]
        c_hit := -1
        for ci in 0..c_cnt {
            if cst_sym[ci] == sym {
                c_hit = ci
                break
            }
        }
        if c_hit < 0 || cst_done[c_hit] == 0 {
            return 0
        }
        imm = cst_val[c_hit]
    }

    // Precedence guard: bail if the operator after `idx` binds tighter than `op`
    if imm_next_binop_prec(idx + 1) > prec {
        return 0
    }

    if op == TOK_PLUS {
        if imm < -0x8000_0000 || imm > 0x7FFF_FFFF { return 0 }
        emit_add_rax_imm32(imm)
        g[G_LAST_EXPR_TY] = TY_I64
        g[G_TOK_IDX] = idx + 1
        return 1
    }

    if op == TOK_MINUS {
        if imm < -0x8000_0000 || imm > 0x7FFF_FFFF { return 0 }
        emit_sub_rax_imm32(imm)
        g[G_LAST_EXPR_TY] = TY_I64
        g[G_TOK_IDX] = idx + 1
        return 1
    }

    if op == TOK_SHL {
        if imm < 0 || imm > 63 { return 0 }
        emit_shl_rax_imm(imm)
        if is_ty_unsigned(lhs_ty) == 1 {
            g[G_LAST_EXPR_TY] = TY_U64
        } else {
            g[G_LAST_EXPR_TY] = TY_I64
        }
        g[G_TOK_IDX] = idx + 1
        return 1
    }

    if op == TOK_SHR {
        if imm < 0 || imm > 63 { return 0 }
        if is_ty_unsigned(lhs_ty) == 1 {
            if imm == 1 {
                emit_u8(0x48)  emit_u8(0xD1)  emit_u8(0xE8) // shr rax, 1
            } else {
                if imm > 1 {
                    emit_u8(0x48)  emit_u8(0xC1)  emit_u8(0xE8)  emit_u8(imm)
                }
            }
            g[G_LAST_EXPR_TY] = TY_U64
        } else {
            if imm == 1 {
                emit_u8(0x48)  emit_u8(0xD1)  emit_u8(0xF8) // sar rax, 1
            } else {
                if imm > 1 {
                    emit_u8(0x48)  emit_u8(0xC1)  emit_u8(0xF8)  emit_u8(imm)
                }
            }
            g[G_LAST_EXPR_TY] = TY_I64
        }
        g[G_TOK_IDX] = idx + 1
        return 1
    }

    if op == TOK_AMP {
        if imm >= 0 && imm <= 0x7FFF_FFFF {
            if imm <= 127 {
                emit_u8(0x83)  emit_u8(0xE0)  emit_u8(imm) // and eax, imm8 (zero-extends to 64b)
            } else {
                emit_u8(0x25)  emit_u32(imm)               // and eax, imm32 (zero-extends to 64b)
            }
            g[G_LAST_EXPR_TY] = TY_I64
            g[G_TOK_IDX] = idx + 1
            return 1
        }
        if imm >= -0x8000_0000 && imm < 0 {
            if imm >= -128 {
                emit_u8(0x48)  emit_u8(0x83)  emit_u8(0xE0)  emit_u8(imm) // and rax, sign_ext_imm8
            } else {
                emit_u8(0x48)  emit_u8(0x25)  emit_u32(imm)               // and rax, sign_ext_imm32
            }
            g[G_LAST_EXPR_TY] = TY_I64
            g[G_TOK_IDX] = idx + 1
            return 1
        }
        return 0
    }

    if op == TOK_STAR {
        if imm <= 0 || (imm & (imm - 1)) != 0 { return 0 }
        sh := @tzcnt(imm)
        emit_shl_rax_imm(sh)
        g[G_LAST_EXPR_TY] = TY_I64
        g[G_TOK_IDX] = idx + 1
        return 1
    }

    return 0
}

fn emit_scalar_div_mod_rcx(is_mod: i64, is_uns: i64) {
    emit_u8(0x48)  emit_u8(0x85)  emit_u8(0xC9) // test rcx, rcx
    emit_u8(0x0F)  emit_u8(0x85)                // jnz .ok
    nz_pos := g[G_CODE_OFF]
    emit_u32(0)
    emit_raise_fault_imm(1)
    patch_rel32_here(nz_pos)

    if is_uns == 1 {
        emit_u8(0x31)  emit_u8(0xD2)                // xor edx, edx
        emit_u8(0x48)  emit_u8(0xF7)  emit_u8(0xF1) // div rcx
        if is_mod == 1 {
            emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xD0)
        }
    } else {
        emit_u8(0x48)  emit_u8(0x83)  emit_u8(0xF9)  emit_u8(0xFF) // cmp rcx, -1
        emit_u8(0x0F)  emit_u8(0x85)                               // jne .do_idiv
        idiv_p := g[G_CODE_OFF]
        emit_u32(0)
        if is_mod == 1 {
            emit_mov_rax_imm64(0)
        } else {
            emit_u8(0x48)  emit_u8(0xF7)  emit_u8(0xD8)            // neg rax
        }
        done_p := emit_jmp_rel32()
        patch_rel32_here(idiv_p)
        emit_u8(0x48)  emit_u8(0x99)                               // cqo
        emit_u8(0x48)  emit_u8(0xF7)  emit_u8(0xF9)                // idiv rcx
        if is_mod == 1 {
            emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xD0)
        }
        patch_rel32_here(done_p)
    }
}

// Elides LHS stack spill when RHS of a scalar binary op is a simple scalar local variable:
// loads RHS directly into `rcx` via `emit_load_local_typed_rcx` and emits the op in registers!
fn try_emit_local_rhs_binop(op: i64, prec: i64, lhs_ty: i64) i64 {
    if op == TOK_PIPE_GT || op == TOK_AND2 || op == TOK_OR2 { return 0 }
    if (lhs_ty & TY_FLAG_SPAN) != 0 { return 0 }
    lbase := lhs_ty & TY_BASE_MASK
    if (lhs_ty & (TY_FLAG_VIEW1 | TY_FLAG_ATOMIC)) == 0 {
        if lbase == TY_U32X16 || lbase == TY_U64X8 { return 0 }
        if lbase >= TY_STRUCT_BASE && lbase < TY_PTR_BASE { return 0 }
    }

    idx := g[G_TOK_IDX]
    if tok_kind[idx] != TOK_IDENT { return 0 }
    nk := tok_kind[idx + 1]
    if nk == TOK_LPAREN || nk == TOK_LBRACK || nk == TOK_DOT || nk == TOK_LT || nk == TOK_LBRACE {
        return 0
    }
    if imm_next_binop_prec(idx + 1) > prec {
        return 0
    }

    // Lookup innermost local matching `sym`
    sym := tok_val[idx]
    li  := g[G_LOC_CNT] - 1
    loop <max: 4096 | until: li < 0> {
        if loc_sym[li] == sym { break }
        li -= 1
    }
    if li < 0 { return 0 }

    rhs_ty: i64   = loc_ty[li]
    rhs_disp: i64 = loc_disp[li]
    if (rhs_ty & TY_FLAG_SPAN) != 0 { return 0 }
    rbase := rhs_ty & TY_BASE_MASK
    if (rhs_ty & (TY_FLAG_VIEW1 | TY_FLAG_ATOMIC)) == 0 {
        if rbase == TY_U32X16 || rbase == TY_U64X8 { return 0 }
        if rbase >= TY_STRUCT_BASE && rbase < TY_PTR_BASE { return 0 }
    }

    // Direct register load into `rcx` (`rax` = LHS preserved, zero stack spill!)
    emit_load_local_typed_rcx(rhs_disp, rhs_ty)

    lhs_u  := is_ty_unsigned(lhs_ty)
    rhs_u  := is_ty_unsigned(rhs_ty)
    both_u := 0
    if lhs_u == 1 && rhs_u == 1 { both_u = 1 }
    out_ty := TY_I64
    if both_u == 1 { out_ty = TY_U64 }

    g[G_TOK_IDX] = idx + 1

    if op == TOK_PLUS  { emit_u8(0x48)  emit_u8(0x01)  emit_u8(0xC8)  g[G_LAST_EXPR_TY] = out_ty  return 1 }
    if op == TOK_MINUS { emit_u8(0x48)  emit_u8(0x29)  emit_u8(0xC8)  g[G_LAST_EXPR_TY] = out_ty  return 1 }
    if op == TOK_STAR  { emit_u8(0x48)  emit_u8(0x0F)  emit_u8(0xAF)  emit_u8(0xC1)  g[G_LAST_EXPR_TY] = out_ty  return 1 }
    if op == TOK_SLASH {
        emit_scalar_div_mod_rcx(0, lhs_u)
        if lhs_u == 1 { g[G_LAST_EXPR_TY] = TY_U64 } else { g[G_LAST_EXPR_TY] = TY_I64 }
        return 1
    }
    if op == TOK_PERCENT {
        emit_scalar_div_mod_rcx(1, lhs_u)
        if lhs_u == 1 { g[G_LAST_EXPR_TY] = TY_U64 } else { g[G_LAST_EXPR_TY] = TY_I64 }
        return 1
    }
    if op == TOK_AMP   { emit_u8(0x48)  emit_u8(0x21)  emit_u8(0xC8)  g[G_LAST_EXPR_TY] = out_ty  return 1 }
    if op == TOK_PIPE  { emit_u8(0x48)  emit_u8(0x09)  emit_u8(0xC8)  g[G_LAST_EXPR_TY] = out_ty  return 1 }
    if op == TOK_CARET { emit_u8(0x48)  emit_u8(0x31)  emit_u8(0xC8)  g[G_LAST_EXPR_TY] = out_ty  return 1 }
    if op == TOK_SHL {
        emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xE0)
        if lhs_u == 1 { g[G_LAST_EXPR_TY] = TY_U64 } else { g[G_LAST_EXPR_TY] = TY_I64 }
        return 1
    }
    if op == TOK_SHR {
        if lhs_u == 1 {
            emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xE8)
            g[G_LAST_EXPR_TY] = TY_U64
        } else {
            emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xF8)
            g[G_LAST_EXPR_TY] = TY_I64
        }
        return 1
    }
    if op == TOK_ROL {
        emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xC0)
        g[G_LAST_EXPR_TY] = TY_U64
        return 1
    }
    if op == TOK_ROR {
        emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xC8)
        g[G_LAST_EXPR_TY] = TY_U64
        return 1
    }

    emit_u8(0x48)  emit_u8(0x39)  emit_u8(0xC8)
    set_op: i64 = 0x94
    if op == TOK_EQ { set_op = 0x94 }
    if op == TOK_NE { set_op = 0x95 }
    if op == TOK_LT { if both_u == 1 { set_op = 0x92 } else { set_op = 0x9C } }
    if op == TOK_LE { if both_u == 1 { set_op = 0x96 } else { set_op = 0x9E } }
    if op == TOK_GT { if both_u == 1 { set_op = 0x97 } else { set_op = 0x9F } }
    if op == TOK_GE { if both_u == 1 { set_op = 0x93 } else { set_op = 0x9D } }
    emit_u8(0x0F)  emit_u8(set_op)  emit_u8(0xC0)
    emit_u8(0x0F)  emit_u8(0xB6)    emit_u8(0xC0)
    g[G_LAST_EXPR_TY] = TY_I64
    return 1
}

// --- Inline Position-Independent String Span & Host `.rodata` Write ---

fn emit_str_literal_expr(pool_off: i64, slen: i64) {
    slot := alloc_anon_qwords(2)
    if slen > 0 {
        emit_u8(0xE9)
        emit_u32(slen)
        for i in 0..slen {
            emit_u8(str_pool[pool_off + i])
        }
        // lea rax, [rip - (slen + 7)]
        emit_u8(0x48)  emit_u8(0x8D)  emit_u8(0x05)
        emit_u32(-(slen + 7))
        emit_store_local(slot)
        emit_mov_rax_imm64(slen)
        emit_store_local(slot + 8)
    } else {
        emit_mov_rax_imm64(1)
        emit_store_local(slot)
        emit_mov_rax_imm64(0)
        emit_store_local(slot + 8)
    }
    emit_lea_local(slot)
    g[G_LAST_EXPR_TY] = TY_U8 | TY_FLAG_SPAN
}

fn emit_write_ro_slice(pool_off: i64, slen: i64, add_nl: i64) {
    total_len := slen + add_nl
    if total_len == 0 { return }
    ro_start := g[G_TGT_RO_OFF]
    for i in 0..slen {
        tgt_ro_buf[ro_start + i] = str_pool[pool_off + i]
    }
    if add_nl == 1 {
        tgt_ro_buf[ro_start + slen] = 10
    }
    g[G_TGT_RO_OFF] = ro_start + total_len

    emit_u8(0xB8)  emit_u32(1)          // mov eax, 1 (SYS_WRITE)
    emit_u8(0xBF)  emit_u32(1)          // mov edi, 1 (stdout)
    emit_u8(0xBE)                       // mov esi, <rodata_vaddr>
    fx := g[G_RO_FIX_CNT]
    ro_fix_code[fx] = g[G_CODE_OFF]
    ro_fix_off[fx]  = ro_start
    g[G_RO_FIX_CNT] = fx + 1
    emit_u32(0)
    emit_u8(0xBA)  emit_u32(total_len)  // mov edx, len
    emit_u8(0x0F)  emit_u8(0x05)        // syscall
}
