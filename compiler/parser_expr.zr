// =============================================================================
// Zero Stage-1 Self-Hosted Compiler — Expressions & Postfix (`compiler/parser_expr.zr`)
// =============================================================================

fn peek_kind() i64 => tok_kind[g[G_TOK_IDX]]
fn peek_kw() i64   => tok_kw[g[G_TOK_IDX]]
fn peek_val() i64  => tok_val[g[G_TOK_IDX]]
fn peek_aux() i64  => tok_aux[g[G_TOK_IDX]]
fn peek_line() i64 => tok_line[g[G_TOK_IDX]]

fn expect_kind(k: i64) {
    if peek_kind() != k {
        die_cur("error: parse fault (unexpected token)")
    }
    g[G_TOK_IDX] += 1
}

fn expect_kw(kw: i64) {
    if peek_kind() != TOK_KW || peek_kw() != kw {
        die_cur("error: parse fault (unexpected keyword)")
    }
    g[G_TOK_IDX] += 1
}

fn expect_ident() i64 {
    if peek_kind() != TOK_IDENT {
        die_cur("error: parse fault (expected identifier)")
    }
    id := peek_val()
    g[G_TOK_IDX] += 1
    return id
}

// --- Lookup Helpers (`const`, `bitpack`, `space`, `fn`, `local`) ---

fn find_const(sym: i64) i64 {
    cnt := g[G_CST_CNT]
    for i in 0..cnt {
        if cst_sym[i] == sym { return i }
    }
    return -1
}

fn find_bitpack(sym: i64) i64 {
    ut_cnt := g[G_UT_CNT]
    for i in 0..ut_cnt {
        if ut_sym[i] == sym && ut_kind[i] == UKIND_BITPACK {
            return i
        }
    }
    cnt := g[G_BP_CNT]
    for i in 0..cnt {
        if bp_sym[i] == sym { return i }
    }
    return -1
}

fn find_bp_field(bp_idx: i64, target_fsym: i64) i64 {
    fstart: i64 = bp_fstart[bp_idx]
    fcnt: i64   = bp_fcnt[bp_idx]
    for i in 0..fcnt {
        if bpf_sym[fstart + i] == target_fsym {
            return fstart + i
        }
    }
    return -1
}

fn find_space(sym: i64) i64 {
    cnt := g[G_SP_CNT]
    for i in 0..cnt {
        if sp_sym[i] == sym { return i }
    }
    return -1
}

fn find_or_add_fn(sym: i64) i64 {
    cnt := g[G_FN_CNT]
    for i in 0..cnt {
        if fn_sym[i] == sym { return i }
    }
    fn_sym[cnt]      = sym
    fn_defined[cnt]  = 0
    fn_isr_attr[cnt] = 0
    fn_ret_ty[cnt]   = TY_VOID
    fn_arity[cnt]    = 0
    fn_code_len[cnt] = 0
    g[G_FN_CNT]      = cnt + 1
    return cnt
}

fn find_local(sym: i64) i64 {
    i := g[G_LOC_CNT] - 1
    loop <max: 4096 | until: i < 0> {
        if loc_sym[i] == sym { return i }
        i -= 1
    }
    return -1
}

fn alloc_local(sym: i64, ty: i64, line: i64) i64 {
    // Reject duplicate declaration in the same lexical `{}` block
    cur_depth := g[G_SCOPE_DEPTH]
    i := g[G_LOC_CNT] - 1
    loop <max: 4096 | until: i < 0> {
        if loc_depth[i] < cur_depth { break }
        if loc_sym[i] == sym {
            die_line("error: duplicate variable in same block", line)
        }
        i -= 1
    }

    if is_ty_vec(ty) == 1 {
        check_avx512_context(line)
        rem_qw := (g[G_FRAME_QW] + g[G_TEMP_DEPTH]) & 7
        if rem_qw != 0 {
            g[G_FRAME_QW] += (8 - rem_qw)
        }
    }

    sz     := ty_byte_size(ty)
    qwords := (sz + 7) >> 3
    if qwords < 1 { qwords = 1 }
    disp := alloc_anon_qwords(qwords)

    idx := g[G_LOC_CNT]
    loc_sym[idx]           = sym
    loc_ty[idx]            = ty
    loc_disp[idx]          = disp
    loc_depth[idx]         = cur_depth
    loc_oneshot_state[idx] = 0
    loc_oneshot_reg[idx]   = 0
    g[G_LOC_CNT]           = idx + 1
    return disp
}

// --- Builtin & User Type Parser & Compile-Time Constant Delegation ---

fn sym_eq_str(sym: i64, s: str) i64 {
    slen: i64 = sym_len[sym]
    if slen != s.len { return 0 }
    soff: i64 = sym_off[sym]
    for i in 0..slen {
        if str_pool[soff + i] != s[i] { return 0 }
    }
    return 1
}

fn parse_type_tag() i64 => parse_full_type_tag()

fn parse_bitwidth_ident(sym: i64) i64 {
    slen: i64 = sym_len[sym]
    soff: i64 = sym_off[sym]
    if slen < 2 || str_pool[soff] != 'u' {
        die_cur("error: parse fault (expected u1..u64 width in bit-layout)")
    }
    w: i64 = 0
    for i in 1..slen {
        c: u8 = str_pool[soff + i]
        if c < '0' || c > '9' {
            die_cur("error: parse fault (invalid bit-layout width)")
        }
        w = w * 10 + (c - '0')
    }
    if w < 1 || w > 64 {
        die_cur("error: parse fault (bit-layout field width out of 1..64)")
    }
    return w
}

fn eval_const_expr(min_prec: i64) i64 => eval_ts_const_expr(min_prec)

// --- Context-Exact `< ... >` Clause Delimiter Helpers (§5.4) ---

fn is_descriptor_lt_at(idx: i64) i64 {
    if tok_kind[idx] != TOK_LT { return 0 }
    k1 := tok_kind[idx + 1]
    if k1 != TOK_IDENT && k1 != TOK_KW { return 0 }
    k2 := tok_kind[idx + 2]
    if k2 == TOK_COLON || k2 == TOK_PIPE { return 1 }
    if k2 == TOK_GT && tok_kind[idx + 3] == TOK_LBRACE { return 1 }
    return 0
}

fn is_field_sep_pipe_at(idx: i64) i64 {
    if tok_kind[idx] == TOK_PIPE && tok_kind[idx + 1] == TOK_IDENT && tok_kind[idx + 2] == TOK_COLON {
        return 1
    }
    return 0
}

fn gt_starts_same_line_rhs(idx: i64) i64 {
    if tok_line[idx] != tok_line[idx + 1] { return 0 }
    k1 := tok_kind[idx + 1]
    if k1 == TOK_INT || k1 == TOK_CHAR || k1 == TOK_LPAREN { return 1 }
    if k1 == TOK_MINUS || k1 == TOK_TILDE || k1 == TOK_BANG || k1 == TOK_AT { return 1 }
    if k1 == TOK_KW {
        kw1 := tok_kw[idx + 1]
        if kw1 == KW_TRUE || kw1 == KW_FALSE { return 1 }
        return 0
    }
    if k1 == TOK_IDENT {
        k2 := tok_kind[idx + 2]
        if k2 == TOK_WALRUS || k2 == TOK_ASSIGN { return 0 }
        return 1
    }
    return 0
}

fn scan_bitpack_clause_end() i64 {
    pdepth := 0
    idx := g[G_TOK_IDX]
    loop <max: 65536 | until: 0 == 1> {
        k := tok_kind[idx]
        if k == TOK_EOF { die_cur("error: parse fault (unclosed bitpack literal)") }
        if k == TOK_LPAREN { pdepth += 1  idx += 1  continue }
        if k == TOK_RPAREN { pdepth -= 1  idx += 1  continue }
        if pdepth == 0 {
            if k == TOK_PIPE && is_field_sep_pipe_at(idx) == 1 { return idx }
            if k == TOK_GT && gt_starts_same_line_rhs(idx) == 0 { return idx }
        }
        idx += 1
    }
    return idx
}

fn scan_loop_lens_clause_end() i64 {
    pdepth := 0
    idx := g[G_TOK_IDX]
    loop <max: 65536 | until: 0 == 1> {
        k := tok_kind[idx]
        if k == TOK_EOF { die_cur("error: parse fault (unclosed loop lens)") }
        if k == TOK_LPAREN { pdepth += 1  idx += 1  continue }
        if k == TOK_RPAREN { pdepth -= 1  idx += 1  continue }
        if pdepth == 0 {
            if k == TOK_PIPE && is_field_sep_pipe_at(idx) == 1 { return idx }
            if k == TOK_GT && tok_kind[idx + 1] == TOK_LBRACE { return idx }
        }
        idx += 1
    }
    return idx
}

fn parse_bounded_expr(end_idx: i64) {
    saved_k := tok_kind[end_idx]
    tok_kind[end_idx] = TOK_EOF
    parse_expr(1)
    tok_kind[end_idx] = saved_k
    if g[G_TOK_IDX] != end_idx {
        die_cur("error: parse fault (trailing tokens inside <...> clause)")
    }
}

fn width_mask64(w: i64) i64 {
    if w >= 64 { return -1 }
    return (1 << w) - 1
}

fn emit_extract_bits(shift: i64, width: i64) {
    if shift > 0 {
        emit_u8(0x48)  emit_u8(0xC1)  emit_u8(0xE8)  emit_u8(shift) // shr rax, imm8
    }
    if width < 64 {
        emit_mov_rcx_imm64(width_mask64(width))
        emit_u8(0x48)  emit_u8(0x21)  emit_u8(0xC8)                 // and rax, rcx
    }
    g[G_LAST_EXPR_TY] = TY_U64
}

// --- Runtime Expression Compiler (`parse_expr` -> `rax` + `g[G_LAST_EXPR_TY]`) ---

fn binop_prec(idx: i64) i64 {
    k := tok_kind[idx]
    if k == TOK_PIPE_GT { return 1 }
    if k == TOK_OR2     { return 2 }
    if k == TOK_AND2    { return 3 }
    if k == TOK_PIPE    { return 4 }
    if k == TOK_CARET   { return 5 }
    if k == TOK_AMP     { return 6 }
    if k == TOK_EQ || k == TOK_NE { return 7 }
    if k == TOK_LT {
        if is_descriptor_lt_at(idx) == 1 { return 0 }
        return 8
    }
    if k == TOK_LE || k == TOK_GT || k == TOK_GE { return 8 }
    if k == TOK_SHL || k == TOK_SHR || k == TOK_ROL || k == TOK_ROR { return 9 }
    if k == TOK_PLUS || k == TOK_MINUS { return 10 }
    if k == TOK_STAR || k == TOK_SLASH || k == TOK_PERCENT { return 11 }
    return 0
}

fn emit_load_arg_regs_lo(cnt: i64, d0: i64, d1: i64, d2: i64) {
    if cnt >= 1 { emit_load_local(d0)  emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC7) } // rdi
    if cnt >= 2 { emit_load_local(d1)  emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC6) } // rsi
    if cnt >= 3 { emit_load_local(d2)  emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC2) } // rdx
}

fn emit_load_arg_regs_hi(cnt: i64, d3: i64, d4: i64, d5: i64) {
    if cnt >= 4 { emit_load_local(d3)  emit_move_rax_to_arg3() }                     // rcx / r10
    if cnt >= 5 { emit_load_local(d4)  emit_u8(0x49)  emit_u8(0x89)  emit_u8(0xC0) } // r8
    if cnt >= 6 { emit_load_local(d5)  emit_u8(0x49)  emit_u8(0x89)  emit_u8(0xC1) } // r9
}

fn emit_finish_fn_call(fn_idx: i64) {
    emit_call_fn_idx(fn_idx)
    emit_check_call_fault()
    rty: i64 = fn_ret_ty[fn_idx]
    if rty == TY_VOID { rty = TY_I64 }
    if is_ty_vec(rty) == 1 {
        check_avx512_context(peek_line())
    }
    if (rty & TY_FLAG_SPAN) != 0 {
        emit_unpack_span_ret_rax_rdx()
    }
    g[G_LAST_EXPR_TY] = rty
}

fn parse_fn_call_expr(fn_idx: i64) {
    check_no_live_oneshot_for_call(peek_line())
    expect_kind(TOK_LPAREN)
    d0: i64 = 0  d1: i64 = 0  d2: i64 = 0
    d3: i64 = 0  d4: i64 = 0  d5: i64 = 0
    acnt: i64 = 0
    is_def: i64 = fn_defined[fn_idx]
    f_ar: i64   = fn_arity[fn_idx]
    f_ps: i64   = fn_pstart[fn_idx]

    if peek_kind() != TOK_RPAREN {
        loop <max: 8 | until: 0 == 1> {
            if acnt >= 6 { die_cur("error: parse fault (maximum 6 call arguments)") }
            arg_ln := peek_line()
            want_ref_ty: i64 = 0
            if is_def == 1 && acnt < f_ar {
                pty_k: i64 = fn_param_ty[f_ps + acnt]
                if (pty_k & TY_FLAG_REF) != 0 {
                    want_ref_ty = pty_k & (~TY_FLAG_REF)
                }
            }
            if want_ref_ty != 0 {
                parse_ref_lval_addr(want_ref_ty, arg_ln)
            } else {
                parse_expr(1)
                if (g[G_LAST_EXPR_TY] & TY_FLAG_ONESHOT) != 0 {
                    die_line("error: @oneshot pointer cannot be passed to a function", arg_ln)
                }
                if is_ty_vec(g[G_LAST_EXPR_TY]) == 1 {
                    check_avx512_context(peek_line())
                    varg := alloc_anon_qwords(8)
                    emit_zmm0_store_rbp(varg)
                    emit_lea_local(varg)
                }
            }
            slot := alloc_temp_qword()
            emit_store_local(slot)
            if acnt == 0 { d0 = slot }
            if acnt == 1 { d1 = slot }
            if acnt == 2 { d2 = slot }
            if acnt == 3 { d3 = slot }
            if acnt == 4 { d4 = slot }
            if acnt == 5 { d5 = slot }
            acnt += 1
            if peek_kind() != TOK_COMMA { break }
            g[G_TOK_IDX] += 1
        }
    }
    expect_kind(TOK_RPAREN)
    if is_def == 1 && acnt != f_ar {
        die_cur("error: function call argument count mismatch")
    }

    emit_load_arg_regs_lo(acnt, d0, d1, d2)
    emit_load_arg_regs_hi(acnt, d3, d4, d5)
    if acnt > 0 { free_temp_qwords(acnt) }

    emit_finish_fn_call(fn_idx)
    g[G_EXPR_SET_FLAG] = 0
}

fn parse_primary() {
    g[G_EXPR_SET_FLAG] = 0
    k := peek_kind()

    if k == TOK_INT || k == TOK_CHAR {
        v := peek_val()
        g[G_TOK_IDX] += 1
        emit_mov_rax_imm64(v)
        g[G_LAST_EXPR_TY] = TY_I64
        return
    }

    if k == TOK_STR {
        poff := peek_val()
        slen := peek_aux()
        g[G_TOK_IDX] += 1
        emit_str_literal_expr(poff, slen)
        return
    }

    if k == TOK_KW {
        kw := peek_kw()
        if kw == KW_TRUE {
            g[G_TOK_IDX] += 1
            emit_mov_rax_imm64(1)
            g[G_LAST_EXPR_TY] = TY_U8
            return
        }
        if kw == KW_FALSE {
            g[G_TOK_IDX] += 1
            emit_mov_rax_imm64(0)
            g[G_LAST_EXPR_TY] = TY_U8
            return
        }
        die_cur("error: parse fault (unexpected keyword in expression)")
    }

    if k == TOK_LPAREN {
        g[G_TOK_IDX] += 1
        parse_expr(1)
        expect_kind(TOK_RPAREN)
        return
    }

    if k == TOK_AT {
        parse_at_expr()
        return
    }

    if k == TOK_IDENT {
        id_line := peek_line()
        sym     := expect_ident()

        // 0a. Explicit typed pointer cast `ptr* ElemType (expr)`
        if sym == g[G_SYM_PTR] && peek_kind() == TOK_STAR {
            g[G_TOK_IDX] += 1
            if peek_kind() == TOK_AT && tok_kind[g[G_TOK_IDX] + 1] == TOK_IDENT && tok_val[g[G_TOK_IDX] + 1] == g[G_SYM_ONESHOT] {
                die_line("error: @oneshot capability can only be created in a register-bound variable declaration", id_line)
            }
            elem := parse_full_type_tag()
            if (elem & (TY_FLAG_SPAN | TY_FLAG_VIEW1 | TY_FLAG_ATOMIC | TY_FLAG_PTR | TY_FLAG_REF | TY_FLAG_ONESHOT)) != 0 {
                die_line("error: invalid target element type in ptr* cast", id_line)
            }
            expect_kind(TOK_LPAREN)
            parse_expr(1)
            if (g[G_LAST_EXPR_TY] & TY_FLAG_ONESHOT) != 0 {
                die_line("error: cannot cast @oneshot pointer to persistent ptr*", id_line)
            }
            expect_kind(TOK_RPAREN)
            g[G_LAST_EXPR_TY]  = (elem & TY_BASE_MASK) | TY_FLAG_PTR
            g[G_EXPR_SET_FLAG] = 0
            return
        }

        // 0b. Hardware `mask<target | M [ | until !ZF ; max N ]>` engine
        if sym == g[G_SYM_MASK] && peek_kind() == TOK_LT && find_local(sym) < 0 {
            parse_mask_expr(0)
            return
        }

        // 1. Direct call (`publish(...)`, `wait(...)`, or `fn_name(...)`)
        if peek_kind() == TOK_LPAREN {
            if sym == g[G_SYM_PUBLISH] {
                parse_publish_call(id_line)
                return
            }
            if sym == g[G_SYM_WAIT] {
                parse_wait_call(id_line)
                return
            }
            fidx := find_or_add_fn(sym)
            parse_fn_call_expr(fidx)
            return
        }

        // 2. User Type Literals: `Struct{ ... }` or `BitPack<f0: e0 | ...>`
        ut_idx := find_user_type(sym)
        if ut_idx >= 0 {
            uk: i64 = ut_kind[ut_idx]
            if (uk == UKIND_STRUCT || uk == UKIND_CELL64) && peek_kind() == TOK_LBRACE {
                parse_struct_literal_expr(ut_idx)
                return
            }
            if uk == UKIND_BITPACK && is_descriptor_lt_at(g[G_TOK_IDX]) == 1 {
                expect_kind(TOK_LT)
                acc_slot := alloc_temp_qword()
                emit_mov_rax_imm64(0)
                emit_store_local(acc_slot)
                loop <max: 64 | until: 0 == 1> {
                    fsym := expect_ident()
                    expect_kind(TOK_COLON)
                    fidx := find_bp_field(ut_idx, fsym)
                    if fidx < 0 { die_cur("error: parse fault (unknown bitpack field)") }
                    end_i := scan_bitpack_clause_end()
                    parse_bounded_expr(end_i)
                    f_w: i64  = bpf_width[fidx]
                    f_sh: i64 = bpf_shift[fidx]
                    if f_w < 64 {
                        emit_mov_rcx_imm64(width_mask64(f_w))
                        emit_u8(0x48)  emit_u8(0x21)  emit_u8(0xC8)
                    }
                    if f_sh > 0 {
                        emit_u8(0x48)  emit_u8(0xC1)  emit_u8(0xE0)  emit_u8(f_sh)
                    }
                    emit_load_local_rcx(acc_slot)
                    emit_u8(0x48)  emit_u8(0x09)  emit_u8(0xC8) // or rax, rcx
                    emit_store_local(acc_slot)
                    if peek_kind() != TOK_PIPE { break }
                    g[G_TOK_IDX] += 1
                }
                expect_kind(TOK_GT)
                emit_load_local(acc_slot)
                free_temp_qwords(1)
                g[G_LAST_EXPR_TY] = TY_BP_BASE + ut_idx
                return
            }
        }

        // 3. Lexically scoped local variable (respects shadowing over spaces & constants)
        li := find_local(sym)
        if li >= 0 {
            lty: i64   = loc_ty[li]
            ldisp: i64 = loc_disp[li]

            // 3a. Register-only `ptr* @oneshot T`: single terminal `[idx]` load + immediate `xor` wipe!
            if (lty & TY_FLAG_ONESHOT) != 0 {
                if peek_kind() != TOK_LBRACK {
                    die_line("error: @oneshot pointer cannot be copied, cast, or escaped; only 1 @oneshot relay or 1 [idx] dereference is legal", id_line)
                }
                g[G_TOK_IDX] += 1
                rslot := consume_oneshot_local(li, id_line)
                ety   := lty & TY_BASE_MASK
                esz   := ty_byte_size(ety)
                if (ety == TY_U64 || ety == TY_I64) && peek_kind() == TOK_INT && peek_val() == 0 && tok_kind[g[G_TOK_IDX] + 1] == TOK_RBRACK {
                    g[G_TOK_IDX] += 2
                    emit_oneshot_load_zero_u64_and_wipe(rslot)
                } else {
                    parse_expr(1)
                    expect_kind(TOK_RBRACK)
                    emit_scale_rax(esz)
                    emit_oneshot_add_rax_and_wipe(rslot)
                    if is_ty_vec(ety) == 1 {
                        check_avx512_context(id_line)
                    }
                    emit_load_mem_typed(ety)
                    if ety >= TY_STRUCT_BASE && ety < TY_PTR_BASE && peek_kind() != TOK_DOT {
                        die_line("error: @oneshot struct pointer dereference must immediately read a field", id_line)
                    }
                }
                g[G_LAST_EXPR_TY]  = ety
                g[G_EXPR_SET_FLAG] = 0
                return
            }

            // 3b. Zero-copy `ref& T` alias: transparently dereference caller slot!
            if (lty & TY_FLAG_REF) != 0 {
                emit_load_local(ldisp)
                rbase := lty & (~TY_FLAG_REF)
                if is_ty_vec(rbase) == 1 {
                    check_avx512_context(id_line)
                }
                if (rbase & TY_FLAG_SPAN) == 0 {
                    emit_load_mem_typed(rbase)
                }
                g[G_LAST_EXPR_TY] = rbase
                return
            }

            if is_ty_vec(lty) == 1 {
                check_avx512_context(id_line)
                emit_zmm0_load_rbp(ldisp)
                g[G_LAST_EXPR_TY] = lty
                return
            }
            if (lty & TY_FLAG_SPAN) != 0 || is_struct_value_ty(lty) == 1 {
                emit_lea_local(ldisp)
                g[G_LAST_EXPR_TY] = lty
                return
            }
            emit_load_local(ldisp)
            g[G_LAST_EXPR_TY] = lty
            return
        }

        // 4. Topological Space (`@slab`, `@arena`, `@capsule`, `@ring`, `@dma_queue`, `@port`)
        si := find_space(sym)
        if si >= 0 {
            parse_space_rval_expr(si)
            return
        }

        // 5. Compile-time `::` constant
        ci := find_const(sym)
        if ci >= 0 {
            emit_mov_rax_imm64(cst_val[ci])
            g[G_LAST_EXPR_TY] = TY_I64
            return
        }

        die_line("error: parse fault (undefined identifier)", id_line)
    }

    die_cur("error: parse fault in primary expression")
}

// Walks one `.field` (and `[idx]` if inline array `T[N]`) step on a struct address in `rax`
fn pe_emit_struct_field_step(ut_idx: i64, fsym: i64) {
    fi := find_struct_field(ut_idx, fsym)
    if fi < 0 {
        die_cur("error: parse fault (unknown struct field)")
    }
    foff: i64 = fld_off[fi]
    fty: i64  = fld_ty[fi]
    acnt: i64 = fld_arr_cnt[fi]
    if foff != 0 {
        emit_add_rax_imm(foff)
    }
    if acnt > 0 {
        if peek_kind() != TOK_LBRACK {
            die_cur("error: fixed-array struct field requires [index]")
        }
        arr_b := alloc_temp_qword()
        emit_store_local(arr_b)
        g[G_TOK_IDX] += 1
        parse_expr(1)
        expect_kind(TOK_RBRACK)
        emit_bounds_check_rax(acnt)
        emit_scale_rax(ty_byte_size(fty))
        emit_load_local_rcx(arr_b)
        free_temp_qwords(1)
        emit_u8(0x48)  emit_u8(0x01)  emit_u8(0xC8) // add rax, rcx
    }
    if is_ty_vec(fty) == 1 {
        check_avx512_context(peek_line())
    }
    if (fty & TY_FLAG_SPAN) == 0 {
        emit_load_mem_typed(fty)
    }
    g[G_LAST_EXPR_TY] = fty
}

// Lookahead for inline `@view<Struct>(addr).field = ...` statement lvalues
fn pe_is_dot_chain_assign_ahead() i64 {
    idx: i64 = g[G_TOK_IDX]
    cnt: i64 = g[G_TOK_CNT]
    if idx >= cnt || tok_kind[idx] != TOK_DOT { return 0 }
    loop <max: 64 | until: idx >= cnt> {
        tk: i64 = tok_kind[idx]
        if tk == TOK_DOT {
            idx += 1
            if idx >= cnt { return 0 }
            tk2: i64 = tok_kind[idx]
            if tk2 != TOK_IDENT && tk2 != TOK_KW { return 0 }
            idx += 1
            continue
        }
        if tk == TOK_LBRACK {
            bdep: i64 = 1
            idx += 1
            loop <max: 256 | until: idx >= cnt || bdep == 0> {
                bk: i64 = tok_kind[idx]
                if bk == TOK_LBRACK { bdep += 1 }
                if bk == TOK_RBRACK { bdep -= 1 }
                idx += 1
            }
            if bdep != 0 { return 0 }
            continue
        }
        if tk == TOK_ASSIGN || (tk >= TOK_PLUS_EQ && tk <= TOK_ROR_EQ) {
            return 1
        }
        return 0
    }
    return 0
}

fn parse_postfix() {
    parse_primary()
    loop <max: 64 | until: 0 == 1> {
        ty   := g[G_LAST_EXPR_TY]
        base := ty & TY_BASE_MASK
        k    := peek_kind()

        if k == TOK_DOT {
            g[G_EXPR_SET_FLAG] = 0
            if (ty & TY_FLAG_VIEW1) != 0 && base >= TY_STRUCT_BASE && base < TY_PTR_BASE {
                if pe_is_dot_chain_assign_ahead() == 1 {
                    return
                }
            }
            g[G_TOK_IDX] += 1

            // 1. `@atomic<T>` method (`.load()`, `.store(v)`, `.swap(v)`, `.add(v)`, `.sub(v)`, `.cas(e, d)`)
            if (ty & TY_FLAG_ATOMIC) != 0 {
                parse_atomic_method_from_rax(ty)
                continue
            }

            fsym := expect_ident()

            // 2. Bounded span (`str`, `bytes`, `[]T`, `@view(a,n)`, `@mmio(a,n)`, `@stream(a,n)`)
            if (ty & TY_FLAG_SPAN) != 0 {
                if fsym == g[G_SYM_PTR] || fsym == g[G_SYM_BASE] {
                    emit_u8(0x48)  emit_u8(0x8B)  emit_u8(0x00) // mov rax, [rax]
                    g[G_LAST_EXPR_TY] = TY_U64
                    continue
                }
                if fsym == g[G_SYM_LEN] || fsym == g[G_SYM_MAX] || fsym == g[G_SYM_CAP] {
                    emit_u8(0x48)  emit_u8(0x8B)  emit_u8(0x40)  emit_u8(8) // mov rax, [rax+8]
                    g[G_LAST_EXPR_TY] = TY_U64
                    continue
                }
                die_cur("error: parse fault (unknown span property)")
            }

            // 3. 1-arg `@Type` / `@view<T>(addr)` / `@mmio<T>(addr)` overlay
            if (ty & TY_FLAG_VIEW1) != 0 {
                if (ty & TY_FLAG_MMIO) == 0 {
                    emit_null_check_rax()
                }
                if base >= TY_STRUCT_BASE && base < TY_PTR_BASE {
                    pe_emit_struct_field_step(base - TY_STRUCT_BASE, fsym)
                    continue
                }
                if fsym == g[G_SYM_READ] {
                    expect_kind(TOK_LPAREN)
                    expect_kind(TOK_RPAREN)
                    if is_ty_vec(base) == 1 {
                        check_avx512_context(peek_line())
                    }
                    emit_load_mem_typed(base)
                    g[G_LAST_EXPR_TY] = base
                    continue
                }
                if fsym == g[G_SYM_WRITE] {
                    if is_ty_vec(base) == 1 {
                        check_avx512_context(peek_line())
                    }
                    addr_t := alloc_temp_qword()
                    emit_store_local(addr_t)
                    expect_kind(TOK_LPAREN)
                    parse_expr(1)
                    expect_kind(TOK_RPAREN)
                    emit_load_local_rcx(addr_t)
                    free_temp_qwords(1)
                    emit_store_mem_typed(base)
                    g[G_LAST_EXPR_TY] = TY_U64
                    continue
                }
                die_cur("error: parse fault (unknown @view/@mmio method)")
            }

            // 4. Custom `@ptr<...>` `.raw`
            if base >= TY_PTR_BASE {
                if fsym != g[G_SYM_RAW] {
                    die_cur("error: parse fault (unknown @ptr property)")
                }
                g[G_LAST_EXPR_TY] = TY_U64
                continue
            }

            // 5. Struct / `@cell64` value `.field` (`rax` = `&struct`)
            if base >= TY_STRUCT_BASE {
                pe_emit_struct_field_step(base - TY_STRUCT_BASE, fsym)
                continue
            }

            // 6. BitPack `.field` extraction
            if base >= TY_BP_BASE {
                fidx := find_bp_field(base - TY_BP_BASE, fsym)
                if fidx < 0 { die_cur("error: parse fault (unknown bitpack field)") }
                emit_extract_bits(bpf_shift[fidx], bpf_width[fidx])
                continue
            }

            die_cur("error: parse fault (invalid member access)")
        }

        if k == TOK_LBRACK {
            g[G_EXPR_SET_FLAG] = 0
            // 0. Classic 64-bit `ptr* T` indexed load (`p[0]` zero-overhead fast path + `p[idx]`)
            if (ty & TY_FLAG_PTR) != 0 {
                if tok_kind[g[G_TOK_IDX] + 1] == TOK_INT && tok_val[g[G_TOK_IDX] + 1] == 0 && tok_kind[g[G_TOK_IDX] + 2] == TOK_RBRACK {
                    g[G_TOK_IDX] += 3
                } else {
                    ptr_s := alloc_temp_qword()
                    emit_store_local(ptr_s)
                    g[G_TOK_IDX] += 1
                    parse_expr(1)
                    expect_kind(TOK_RBRACK)
                    emit_scale_rax(ty_byte_size(base))
                    emit_load_local_rcx(ptr_s)
                    free_temp_qwords(1)
                    emit_u8(0x48)  emit_u8(0x01)  emit_u8(0xC8) // add rax, rcx
                }
                if is_ty_vec(base) == 1 {
                    check_avx512_context(peek_line())
                }
                emit_load_mem_typed(base)
                g[G_LAST_EXPR_TY] = base
                continue
            }

            // 1. Span element `span[idx]` or sub-slice `span[lo..hi]`
            if (ty & TY_FLAG_SPAN) != 0 {
                span_ptr_t := alloc_temp_qword()
                emit_store_local(span_ptr_t)
                g[G_TOK_IDX] += 1
                parse_expr(1)
                if peek_kind() == TOK_DOT2 {
                    parse_span_subslice_from_slot(span_ptr_t, ty)
                    continue
                }
                expect_kind(TOK_RBRACK)

                emit_load_local_rcx(span_ptr_t)
                emit_u8(0x48)  emit_u8(0x3B)  emit_u8(0x41)  emit_u8(8) // cmp rax, [rcx+8]
                emit_u8(0x0F)  emit_u8(0x82)                            // jb .ok
                ok_b := g[G_CODE_OFF]
                emit_u32(0)
                emit_raise_fault_imm(2)
                patch_rel32_here(ok_b)

                esz := ty_byte_size(base)
                emit_scale_rax(esz)
                emit_load_local_rcx(span_ptr_t)
                free_temp_qwords(1)
                emit_u8(0x48)  emit_u8(0x8B)  emit_u8(0x09) // mov rcx, [rcx]
                emit_u8(0x48)  emit_u8(0x01)  emit_u8(0xC8) // add rax, rcx
                if is_ty_vec(base) == 1 {
                    check_avx512_context(peek_line())
                }
                if (base & TY_FLAG_SPAN) == 0 {
                    emit_load_mem_typed(base)
                }
                g[G_LAST_EXPR_TY] = base
                continue
            }

            // 2. 1-arg `@view<T>(addr)` / `@mmio<T>(addr)` indexed access
            if (ty & TY_FLAG_VIEW1) != 0 {
                if (ty & TY_FLAG_MMIO) == 0 {
                    emit_null_check_rax()
                }
                ptr_t := alloc_temp_qword()
                emit_store_local(ptr_t)
                g[G_TOK_IDX] += 1
                parse_expr(1)
                expect_kind(TOK_RBRACK)
                esz := ty_byte_size(base)
                emit_scale_rax(esz)
                emit_load_local_rcx(ptr_t)
                free_temp_qwords(1)
                emit_u8(0x48)  emit_u8(0x01)  emit_u8(0xC8)
                if is_ty_vec(base) == 1 {
                    check_avx512_context(peek_line())
                }
                emit_load_mem_typed(base)
                g[G_LAST_EXPR_TY] = base
                continue
            }

            // 3. Custom `@ptr<...>` indexed load (`mask` + `wrap` + `stride` + `bswap`)
            if is_custom_ptr_ty(ty) == 1 {
                ut_p := base - TY_PTR_BASE
                emit_custom_ptr_elem_addr_from_rax(ut_p)
                ety: i64 = ptr_elem_ty[ut_p]
                if is_ty_vec(ety) == 1 {
                    check_avx512_context(peek_line())
                }
                emit_load_mem_typed(ety)
                if is_struct_value_ty(ety) == 0 && is_ty_vec(ety) == 0 && ptr_bswap[ut_p] == 1 {
                    emit_bswap_for_ty(ety)
                }
                g[G_LAST_EXPR_TY] = ety
                continue
            }

            // 4. Reject `[...]` on bare structs, SIMD vectors, or `@atomic`
            if (ty & TY_FLAG_ATOMIC) != 0 || base >= TY_STRUCT_BASE || is_ty_vec(ty) == 1 {
                die_cur("error: parse fault (cannot index struct, SIMD vector, or @atomic)")
            }

            // 5. Hardware scalar bit-slice `val[hi:lo]`
            val_t := alloc_temp_qword()
            emit_store_local(val_t)
            packed_bs := parse_bitslice_bounds()
            emit_load_local(val_t)
            free_temp_qwords(1)
            emit_extract_bits(packed_bs & 0xFF, packed_bs >> 8)
            continue
        }

        break
    }
}

fn parse_unary() {
    k := peek_kind()
    if k == TOK_MINUS {
        uline := peek_line()
        g[G_TOK_IDX] += 1
        parse_unary()
        g[G_EXPR_SET_FLAG] = 0
        uty := g[G_LAST_EXPR_TY]
        if is_ty_vec(uty) == 1 {
            check_avx512_context(uline)
            is_64 := 0
            if uty == TY_U64X8 { is_64 = 1 }
            emit_zmm1_from_zmm0()
            emit_zmm_binop(TOK_CARET, 1, 0, 0, 0) // vpxorq zmm0, zmm0, zmm0
            emit_zmm0_binop(TOK_MINUS, is_64)     // zmm0 = 0 - zmm1
            g[G_LAST_EXPR_TY] = uty
            return
        }
        emit_u8(0x48)  emit_u8(0xF7)  emit_u8(0xD8) // neg rax
        g[G_LAST_EXPR_TY] = TY_I64
        return
    }
    if k == TOK_TILDE {
        uline := peek_line()
        g[G_TOK_IDX] += 1
        parse_unary()
        g[G_EXPR_SET_FLAG] = 0
        uty := g[G_LAST_EXPR_TY]
        if is_ty_vec(uty) == 1 {
            check_avx512_context(uline)
            emit_zmm1_from_zmm0()
            emit_mov_rax_imm64(-1)
            emit_zmm0_splat64_rax()
            emit_zmm0_binop(TOK_CARET, 1)         // vpxorq zmm0, all1s, zmm1
            g[G_LAST_EXPR_TY] = uty
            return
        }
        emit_u8(0x48)  emit_u8(0xF7)  emit_u8(0xD0) // not rax (preserves signedness)
        return
    }
    if k == TOK_BANG {
        g[G_TOK_IDX] += 1
        parse_unary()
        g[G_EXPR_SET_FLAG] = 0
        if is_ty_vec(g[G_LAST_EXPR_TY]) == 1 {
            die_cur("error: parse fault (logical '!' unsupported on SIMD vector)")
        }
        emit_u8(0x48)  emit_u8(0x85)  emit_u8(0xC0) // test rax, rax
        emit_u8(0x0F)  emit_u8(0x94)  emit_u8(0xC0) // sete al
        emit_u8(0x0F)  emit_u8(0xB6)  emit_u8(0xC0) // movzx eax, al
        g[G_LAST_EXPR_TY] = TY_I64
        return
    }
    parse_postfix()
}

fn emit_div_or_mod(is_mod: i64, both_uns: i64) {
    // `rax` = dividend, `rcx` = divisor; `rcx == 0 -> fail 1`
    emit_u8(0x48)  emit_u8(0x85)  emit_u8(0xC9) // test rcx, rcx
    emit_u8(0x0F)  emit_u8(0x85)                // jnz .ok
    nz_pos := g[G_CODE_OFF]
    emit_u32(0)
    emit_raise_fault_imm(1)
    patch_rel32_here(nz_pos)

    if both_uns == 1 {
        emit_u8(0x31)  emit_u8(0xD2)                // xor edx, edx
        emit_u8(0x48)  emit_u8(0xF7)  emit_u8(0xF1) // div rcx
        if is_mod == 1 {
            emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xD0) // mov rax, rdx
        }
    } else {
        emit_u8(0x48)  emit_u8(0x83)  emit_u8(0xF9)  emit_u8(0xFF) // cmp rcx, -1
        emit_u8(0x0F)  emit_u8(0x85)                               // jne .do_idiv
        idiv_p := g[G_CODE_OFF]
        emit_u32(0)
        if is_mod == 1 {
            emit_mov_rax_imm64(0)
        } else {
            emit_u8(0x48)  emit_u8(0xF7)  emit_u8(0xD8) // neg rax
        }
        done_p := emit_jmp_rel32()
        patch_rel32_here(idiv_p)
        emit_u8(0x48)  emit_u8(0x99)                    // cqo
        emit_u8(0x48)  emit_u8(0xF7)  emit_u8(0xF9)     // idiv rcx
        if is_mod == 1 {
            emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xD0) // mov rax, rdx
        }
        patch_rel32_here(done_p)
    }
}

fn pe_try_vec_shift_imm(op: i64, prec: i64, is_64: i64) i64 {
    idx := g[G_TOK_IDX]
    tk  := tok_kind[idx]
    nk  := tok_kind[idx + 1]
    imm: i64 = 0

    if nk == TOK_LPAREN || nk == TOK_LBRACK || nk == TOK_DOT || nk == TOK_LBRACE {
        return 0
    }
    if tk == TOK_INT || tk == TOK_CHAR {
        imm = tok_val[idx]
    } else {
        if tk != TOK_IDENT || nk == TOK_LT { return 0 }
        sym := tok_val[idx]
        if find_local(sym) >= 0 { return 0 }
        if find_space(sym) >= 0 { return 0 }
        ci := find_const(sym)
        if ci < 0 || cst_done[ci] == 0 { return 0 }
        imm = cst_val[ci]
    }
    if binop_prec(idx + 1) > prec { return 0 }
    if imm < 0 || imm > 63 { return 0 }

    if op == TOK_SHL {
        emit_zmm0_shl_imm(imm, is_64)
    } else {
        emit_zmm0_shr_imm(imm, is_64)
    }
    g[G_TOK_IDX] = idx + 1
    return 1
}

fn pe_emit_vec_binop_step(op: i64, prec: i64, lhs_ty: i64) {
    is_64 := 0
    if lhs_ty == TY_U64X8 { is_64 = 1 }

    // 1. Shifts `<<` / `>>`: immediate `0..63`, per-lane vector, or dynamic scalar count
    if op == TOK_SHL || op == TOK_SHR {
        if pe_try_vec_shift_imm(op, prec, is_64) == 1 {
            g[G_LAST_EXPR_TY] = lhs_ty
            return
        }
        vslot := alloc_temp_vec()
        emit_zmm0_store_rbp(vslot)
        parse_expr(prec + 1)
        rty := g[G_LAST_EXPR_TY]
        if rty == lhs_ty {
            emit_zmm1_from_zmm0()
            emit_zmm0_load_rbp(vslot)
            free_temp_vec()
            if op == TOK_SHL { emit_zmm0_shlv(is_64) } else { emit_zmm0_shrv(is_64) }
            g[G_LAST_EXPR_TY] = lhs_ty
            return
        }
        if is_ty_vec(rty) == 1 || (rty & TY_FLAG_SPAN) != 0 || is_struct_value_ty(rty) == 1 {
            die_cur("error: parse fault (invalid SIMD vector shift count type)")
        }
        emit_zmm0_load_rbp(vslot)
        free_temp_vec()
        if op == TOK_SHL { emit_zmm0_shl_rax(is_64) } else { emit_zmm0_shr_rax(is_64) }
        g[G_LAST_EXPR_TY] = lhs_ty
        return
    }

    // 2. Lane-wise vector ALU (`+`, `-`, `*`, `&`, `|`, `^`)
    if op == TOK_PLUS || op == TOK_MINUS || op == TOK_STAR || op == TOK_AMP || op == TOK_PIPE || op == TOK_CARET {
        idx := g[G_TOK_IDX]
        if tok_kind[idx] == TOK_IDENT {
            nk := tok_kind[idx + 1]
            if nk != TOK_LPAREN && nk != TOK_LBRACK && nk != TOK_DOT && nk != TOK_LBRACE && nk != TOK_LT {
                if binop_prec(idx + 1) <= prec {
                    rli := find_local(tok_val[idx])
                    if rli >= 0 && loc_ty[rli] == lhs_ty {
                        g[G_TOK_IDX] = idx + 1
                        emit_zmm1_load_rbp(loc_disp[rli])
                        emit_zmm0_binop(op, is_64)
                        g[G_LAST_EXPR_TY] = lhs_ty
                        return
                    }
                }
            }
        }
        vslot := alloc_temp_vec()
        emit_zmm0_store_rbp(vslot)
        parse_expr(prec + 1)
        if g[G_LAST_EXPR_TY] != lhs_ty {
            die_cur("error: parse fault (mismatched SIMD vector types in binary expression)")
        }
        emit_zmm1_from_zmm0()
        emit_zmm0_load_rbp(vslot)
        free_temp_vec()
        emit_zmm0_binop(op, is_64)
        g[G_LAST_EXPR_TY] = lhs_ty
        return
    }

    die_cur("error: parse fault (unsupported binary operator on SIMD vector)")
}

fn parse_expr(min_prec: i64) {
    parse_unary()
    loop <max: 1024 | until: 0 == 1> {
        cur_i := g[G_TOK_IDX]
        prec  := binop_prec(cur_i)
        if prec < min_prec { break }

        op       := tok_kind[cur_i]
        lhs_ty   := g[G_LAST_EXPR_TY]
        lhs_flag := g[G_EXPR_SET_FLAG]
        g[G_EXPR_SET_FLAG] = 0
        g[G_TOK_IDX] = cur_i + 1

        // 0. Zero-`cmp` `mask<...> == 0` and `mask<...> != 0` in expression context!
        if lhs_flag == FLAG_ZF && (op == TOK_EQ || op == TOK_NE) {
            if peek_kind() == TOK_INT && peek_val() == 0 && imm_next_binop_prec(g[G_TOK_IDX] + 1) <= prec {
                g[G_TOK_IDX] += 1
                z_op: i64 = 0x94
                if op == TOK_NE { z_op = 0x95 }
                emit_u8(0x0F)  emit_u8(z_op)  emit_u8(0xC0) // sete / setne al (NO cmp!)
                emit_u8(0x0F)  emit_u8(0xB6)  emit_u8(0xC0) // movzx eax, al
                g[G_LAST_EXPR_TY] = TY_I64
                continue
            }
        }

        // 1. Pipeline `lhs |> fn_name[(arg1, ...)]`
        if op == TOK_PIPE_GT {
            check_no_live_oneshot_for_call(tok_line[cur_i])
            if (lhs_ty & TY_FLAG_ONESHOT) != 0 {
                die_line("error: @oneshot pointer cannot be piped into a function", tok_line[cur_i])
            }
            if is_ty_vec(lhs_ty) == 1 {
                check_avx512_context(tok_line[cur_i])
                vp0 := alloc_anon_qwords(8)
                emit_zmm0_store_rbp(vp0)
                emit_lea_local(vp0)
            }
            d0 := alloc_temp_qword()
            emit_store_local(d0)
            d1: i64 = 0  d2: i64 = 0  d3: i64 = 0  d4: i64 = 0  d5: i64 = 0
            acnt: i64 = 1
            fsym := expect_ident()
            fidx := find_or_add_fn(fsym)
            p_def: i64 = fn_defined[fidx]
            p_ar: i64  = fn_arity[fidx]
            p_ps: i64  = fn_pstart[fidx]
            if peek_kind() == TOK_LPAREN {
                g[G_TOK_IDX] += 1
                if peek_kind() != TOK_RPAREN {
                    loop <max: 8 | until: 0 == 1> {
                        if acnt >= 6 { die_cur("error: parse fault (maximum 6 |> arguments)") }
                        p_arg_ln := peek_line()
                        p_ref_ty: i64 = 0
                        if p_def == 1 && acnt < p_ar {
                            p_pty: i64 = fn_param_ty[p_ps + acnt]
                            if (p_pty & TY_FLAG_REF) != 0 {
                                p_ref_ty = p_pty & (~TY_FLAG_REF)
                            }
                        }
                        if p_ref_ty != 0 {
                            parse_ref_lval_addr(p_ref_ty, p_arg_ln)
                        } else {
                            parse_expr(2)
                            if (g[G_LAST_EXPR_TY] & TY_FLAG_ONESHOT) != 0 {
                                die_line("error: @oneshot pointer cannot be passed to a function", p_arg_ln)
                            }
                            if is_ty_vec(g[G_LAST_EXPR_TY]) == 1 {
                                check_avx512_context(peek_line())
                                vpa := alloc_anon_qwords(8)
                                emit_zmm0_store_rbp(vpa)
                                emit_lea_local(vpa)
                            }
                        }
                        slot := alloc_temp_qword()
                        emit_store_local(slot)
                        if acnt == 1 { d1 = slot }
                        if acnt == 2 { d2 = slot }
                        if acnt == 3 { d3 = slot }
                        if acnt == 4 { d4 = slot }
                        if acnt == 5 { d5 = slot }
                        acnt += 1
                        if peek_kind() != TOK_COMMA { break }
                        g[G_TOK_IDX] += 1
                    }
                }
                expect_kind(TOK_RPAREN)
            }
            emit_load_arg_regs_lo(acnt, d0, d1, d2)
            emit_load_arg_regs_hi(acnt, d3, d4, d5)
            free_temp_qwords(acnt)
            emit_finish_fn_call(fidx)
            g[G_EXPR_SET_FLAG] = 0
            continue
        }

        // 1b. 512-bit AVX-512 (`u32x16` / `u64x8`) vector binary operators
        if is_ty_vec(lhs_ty) == 1 {
            check_avx512_context(tok_line[cur_i])
            pe_emit_vec_binop_step(op, prec, lhs_ty)
            continue
        }

        // 2. Short-circuit `&&`
        if op == TOK_AND2 {
            false_p := emit_jz_rel32()
            parse_expr(prec + 1)
            emit_u8(0x48)  emit_u8(0x85)  emit_u8(0xC0)
            emit_u8(0x0F)  emit_u8(0x95)  emit_u8(0xC0)
            emit_u8(0x0F)  emit_u8(0xB6)  emit_u8(0xC0)
            end_p := emit_jmp_rel32()
            patch_rel32_here(false_p)
            emit_mov_rax_imm64(0)
            patch_rel32_here(end_p)
            g[G_LAST_EXPR_TY] = TY_I64
            continue
        }

        // 3. Short-circuit `||`
        if op == TOK_OR2 {
            true_p := emit_jnz_rel32()
            parse_expr(prec + 1)
            emit_u8(0x48)  emit_u8(0x85)  emit_u8(0xC0)
            emit_u8(0x0F)  emit_u8(0x95)  emit_u8(0xC0)
            emit_u8(0x0F)  emit_u8(0xB6)  emit_u8(0xC0)
            end_p := emit_jmp_rel32()
            patch_rel32_here(true_p)
            emit_mov_rax_imm64(1)
            patch_rel32_here(end_p)
            g[G_LAST_EXPR_TY] = TY_I64
            continue
        }

        // 4. Precedence-safe compact immediate-RHS & local-RHS instruction selectors
        if try_emit_imm_rhs_binop(op, prec, lhs_ty) == 1 {
            continue
        }
        if try_emit_local_rhs_binop(op, prec, lhs_ty) == 1 {
            continue
        }

        // 5. General binary operator: save LHS in temp slot, evaluate RHS -> `rcx`, reload LHS -> `rax`
        if (lhs_ty & TY_FLAG_ONESHOT) != 0 {
            die_cur("error: @oneshot pointer cannot participate in arithmetic or comparisons")
        }
        lhs_slot := alloc_temp_qword()
        emit_store_local(lhs_slot)
        parse_expr(prec + 1)
        rhs_ty := g[G_LAST_EXPR_TY]
        if (rhs_ty & TY_FLAG_ONESHOT) != 0 {
            die_cur("error: @oneshot pointer cannot participate in arithmetic or comparisons")
        }
        if is_ty_vec(rhs_ty) == 1 {
            die_cur("error: parse fault (cannot mix scalar LHS and SIMD vector RHS)")
        }

        // Typed `ptr* T` pointer arithmetic (`ptr + idx`, `ptr - idx`) scales `idx` by `sizeof(T)`!
        if (lhs_ty & TY_FLAG_PTR) != 0 && (rhs_ty & TY_FLAG_PTR) == 0 && (op == TOK_PLUS || op == TOK_MINUS) {
            p_esz := ty_byte_size(lhs_ty & TY_BASE_MASK)
            emit_scale_rax(p_esz)
            emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC1) // mov rcx, rax (scaled offset)
            emit_load_local(lhs_slot)                   // rax = ptr base
            free_temp_qwords(1)
            if op == TOK_PLUS {
                emit_u8(0x48)  emit_u8(0x01)  emit_u8(0xC8) // add rax, rcx
            } else {
                emit_u8(0x48)  emit_u8(0x29)  emit_u8(0xC8) // sub rax, rcx
            }
            g[G_LAST_EXPR_TY] = lhs_ty
            continue
        }

        emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC1) // mov rcx, rax (RHS)
        emit_load_local(lhs_slot)                   // rax = LHS
        free_temp_qwords(1)

        lhs_u  := is_ty_unsigned(lhs_ty)
        rhs_u  := is_ty_unsigned(rhs_ty)
        both_u := 0
        if lhs_u == 1 && rhs_u == 1 { both_u = 1 }

        out_ty := TY_I64
        if both_u == 1 { out_ty = TY_U64 }

        if op == TOK_PLUS {
            emit_u8(0x48)  emit_u8(0x01)  emit_u8(0xC8)
            g[G_LAST_EXPR_TY] = out_ty
            continue
        }
        if op == TOK_MINUS {
            emit_u8(0x48)  emit_u8(0x29)  emit_u8(0xC8)
            g[G_LAST_EXPR_TY] = out_ty
            continue
        }
        if op == TOK_STAR {
            emit_u8(0x48)  emit_u8(0x0F)  emit_u8(0xAF)  emit_u8(0xC1)
            g[G_LAST_EXPR_TY] = out_ty
            continue
        }
        if op == TOK_SLASH {
            emit_div_or_mod(0, lhs_u)
            if lhs_u == 1 { g[G_LAST_EXPR_TY] = TY_U64 } else { g[G_LAST_EXPR_TY] = TY_I64 }
            continue
        }
        if op == TOK_PERCENT {
            emit_div_or_mod(1, lhs_u)
            if lhs_u == 1 { g[G_LAST_EXPR_TY] = TY_U64 } else { g[G_LAST_EXPR_TY] = TY_I64 }
            continue
        }
        if op == TOK_AMP {
            emit_u8(0x48)  emit_u8(0x21)  emit_u8(0xC8)
            g[G_LAST_EXPR_TY] = out_ty
            continue
        }
        if op == TOK_PIPE {
            emit_u8(0x48)  emit_u8(0x09)  emit_u8(0xC8)
            g[G_LAST_EXPR_TY] = out_ty
            continue
        }
        if op == TOK_CARET {
            emit_u8(0x48)  emit_u8(0x31)  emit_u8(0xC8)
            g[G_LAST_EXPR_TY] = out_ty
            continue
        }
        if op == TOK_SHL {
            emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xE0)
            if lhs_u == 1 { g[G_LAST_EXPR_TY] = TY_U64 } else { g[G_LAST_EXPR_TY] = TY_I64 }
            continue
        }
        if op == TOK_SHR {
            if lhs_u == 1 {
                emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xE8) // shr rax, cl
                g[G_LAST_EXPR_TY] = TY_U64
            } else {
                emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xF8) // sar rax, cl
                g[G_LAST_EXPR_TY] = TY_I64
            }
            continue
        }
        if op == TOK_ROL {
            emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xC0)
            g[G_LAST_EXPR_TY] = TY_U64
            continue
        }
        if op == TOK_ROR {
            emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xC8)
            g[G_LAST_EXPR_TY] = TY_U64
            continue
        }

        // Relational & Equality (`cmp rax, rcx` + `setcc al` + `movzx eax, al`)
        emit_u8(0x48)  emit_u8(0x39)  emit_u8(0xC8)
        set_op: i64 = 0x94
        if op == TOK_EQ { set_op = 0x94 }
        if op == TOK_NE { set_op = 0x95 }
        if op == TOK_LT {
            if both_u == 1 { set_op = 0x92 } else { set_op = 0x9C }
        }
        if op == TOK_LE {
            if both_u == 1 { set_op = 0x96 } else { set_op = 0x9E }
        }
        if op == TOK_GT {
            if both_u == 1 { set_op = 0x97 } else { set_op = 0x9F }
        }
        if op == TOK_GE {
            if both_u == 1 { set_op = 0x93 } else { set_op = 0x9D }
        }
        emit_u8(0x0F)  emit_u8(set_op)  emit_u8(0xC0)
        emit_u8(0x0F)  emit_u8(0xB6)    emit_u8(0xC0)
        g[G_LAST_EXPR_TY] = TY_I64
    }
}
