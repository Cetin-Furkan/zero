// =============================================================================
// Zero Stage-1 Self-Hosted Compiler — Statements, Driver, & CLI (`compiler/zero1.zr`)
// =============================================================================
// Compiles itself deterministically (`zero0 -> zero1 -> zero2 -> zero3`, proving
// byte-identical `zero2 == zero3` fixed point) while emitting strict 2-segment
// `W^X` `ELF64` binaries and `CRC32C`-signed `--target=capsule` `.zcap` capsules.
// =============================================================================

use "defs.zr"
use "lexer.zr"
use "emit_x64.zr"
use "containers.zr"
use "parser_expr.zr"

// --- Compound Assignment & Span Store Helpers ---

fn is_assign_op(k: i64) i64 {
    if k == TOK_ASSIGN { return 1 }
    if k >= TOK_PLUS_EQ && k <= TOK_ROR_EQ { return 1 }
    return 0
}

fn emit_store_span_local(disp: i64) {
    emit_u8(0x49)  emit_u8(0x89)  emit_u8(0xC3)                 // mov r11, rax
    emit_u8(0x49)  emit_u8(0x8B)  emit_u8(0x03)                 // mov rax, [r11]
    emit_store_local(disp)
    emit_u8(0x49)  emit_u8(0x8B)  emit_u8(0x43)  emit_u8(0x08)  // mov rax, [r11 + 8]
    emit_store_local(disp + 8)
}

// Input: `rax` = old LHS value, `rcx` = RHS value
fn emit_compound_op(op: i64, lhs_ty: i64, rhs_ty: i64) {
    both_u := 0
    lhs_u  := is_ty_unsigned(lhs_ty)
    if lhs_u == 1 && is_ty_unsigned(rhs_ty) == 1 { both_u = 1 }

    if op == TOK_PLUS_EQ    { emit_u8(0x48)  emit_u8(0x01)  emit_u8(0xC8)  return }
    if op == TOK_MINUS_EQ   { emit_u8(0x48)  emit_u8(0x29)  emit_u8(0xC8)  return }
    if op == TOK_STAR_EQ    { emit_u8(0x48)  emit_u8(0x0F)  emit_u8(0xAF)  emit_u8(0xC1)  return }
    if op == TOK_SLASH_EQ   { emit_div_or_mod(0, lhs_u)  return }
    if op == TOK_PERCENT_EQ { emit_div_or_mod(1, lhs_u)  return }
    if op == TOK_PIPE_EQ    { emit_u8(0x48)  emit_u8(0x09)  emit_u8(0xC8)  return }
    if op == TOK_AMP_EQ     { emit_u8(0x48)  emit_u8(0x21)  emit_u8(0xC8)  return }
    if op == TOK_CARET_EQ   { emit_u8(0x48)  emit_u8(0x31)  emit_u8(0xC8)  return }
    if op == TOK_SHL_EQ     { emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xE0)  return }
    if op == TOK_SHR_EQ {
        if lhs_u == 1 {
            emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xE8)
        } else {
            emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xF8)
        }
        return
    }
    if op == TOK_ROL_EQ     { emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xC0)  return }
    if op == TOK_ROR_EQ     { emit_u8(0x48)  emit_u8(0xD3)  emit_u8(0xC8)  return }
    die_cur("error: invalid assignment operator")
}

// --- Guarded Block / Loop Trailing `recover` Detector ---

fn block_has_trailing_recover(lbrace_idx: i64) i64 {
    if tok_kind[lbrace_idx] != TOK_LBRACE { return 0 }
    depth := 0
    idx   := lbrace_idx
    loop <max: 131072 | until: 0 == 1> {
        k := tok_kind[idx]
        if k == TOK_EOF { return 0 }
        if k == TOK_LBRACE { depth += 1 }
        if k == TOK_RBRACE {
            depth -= 1
            if depth == 0 {
                if tok_kind[idx + 1] == TOK_KW && tok_kw[idx + 1] == KW_RECOVER {
                    return 1
                }
                return 0
            }
        }
        idx += 1
    }
    return 0
}

fn finish_recover_clause(rec_slot: i64) {
    g[G_REC_DEPTH] = rec_slot
    jhead := rec_jmp_head[rec_slot]
    skip_rec := emit_jmp_rel32()
    resolve_patch_chain(jhead)

    expect_kw(KW_RECOVER)
    err_line := peek_line()
    err_sym  := expect_ident()

    saved_loc := g[G_LOC_CNT]
    g[G_SCOPE_DEPTH] += 1
    err_disp := alloc_local(err_sym, TY_I64, err_line)
    emit_fault_take_rax()
    emit_store_local(err_disp)

    parse_raw_brace_stmts()

    g[G_SCOPE_DEPTH] -= 1
    g[G_LOC_CNT] = saved_loc
    patch_rel32_here(skip_rec)
}

// --- Statement Compiler ---

fn parse_raw_brace_stmts() {
    expect_kind(TOK_LBRACE)
    loop <max: 65536 | until: peek_kind() == TOK_RBRACE> {
        if peek_kind() == TOK_EOF {
            die_cur("error: unclosed '{' block")
        }
        if peek_kind() == TOK_SEMI {
            g[G_TOK_IDX] += 1
            continue
        }
        parse_stmt()
    }
    expect_kind(TOK_RBRACE)
}

fn parse_scoped_block() {
    saved_loc := g[G_LOC_CNT]
    g[G_SCOPE_DEPTH] += 1
    parse_raw_brace_stmts()
    g[G_SCOPE_DEPTH] -= 1
    g[G_LOC_CNT] = saved_loc
}

fn parse_guarded_block_stmt() {
    has_rec := block_has_trailing_recover(g[G_TOK_IDX])
    rec_slot: i64 = 0
    if has_rec == 1 {
        rec_slot = g[G_REC_DEPTH]
        rec_jmp_head[rec_slot]  = -1
        rec_tile_base[rec_slot] = g[G_TILE_DEPTH]
        g[G_REC_DEPTH] = rec_slot + 1
    }
    parse_scoped_block()
    if has_rec == 1 {
        finish_recover_clause(rec_slot)
    }
}

fn parse_stmt_if() {
    expect_kw(KW_IF)
    parse_expr(1)
    else_patch := emit_jz_rel32()
    parse_scoped_block()

    if peek_kind() == TOK_KW && peek_kw() == KW_ELSE {
        g[G_TOK_IDX] += 1
        end_patch := emit_jmp_rel32()
        patch_rel32_here(else_patch)
        if peek_kind() == TOK_KW && peek_kw() == KW_IF {
            parse_stmt_if()
        } else {
            parse_scoped_block()
        }
        patch_rel32_here(end_patch)
    } else {
        patch_rel32_here(else_patch)
    }
}

fn parse_stmt_for() {
    expect_kw(KW_FOR)
    v_line := peek_line()
    v_sym  := expect_ident()
    expect_kw(KW_IN)

    parse_expr(1)

    // Case A: `for v in lo..hi { ... } [recover e { ... }]`
    if peek_kind() == TOK_DOT2 {
        lo_slot := alloc_temp_qword()
        emit_store_local(lo_slot)
        g[G_TOK_IDX] += 1
        parse_expr(1)
        hi_slot := alloc_anon_qwords(1)
        emit_store_local(hi_slot)

        if peek_kind() == TOK_LT && is_descriptor_lt_at(g[G_TOK_IDX]) == 1 {
            die_cur("error: unimplemented or invalid loop lens")
        }

        has_rec := block_has_trailing_recover(g[G_TOK_IDX])
        rec_slot: i64 = 0
        if has_rec == 1 {
            rec_slot = g[G_REC_DEPTH]
            rec_jmp_head[rec_slot]  = -1
            rec_tile_base[rec_slot] = g[G_TILE_DEPTH]
            g[G_REC_DEPTH] = rec_slot + 1
        }

        saved_loc := g[G_LOC_CNT]
        g[G_SCOPE_DEPTH] += 1
        v_disp := alloc_local(v_sym, TY_I64, v_line)
        emit_load_local(lo_slot)
        free_temp_qwords(1)
        emit_store_local(v_disp)

        head_off := g[G_CODE_OFF]
        emit_load_local(v_disp)
        emit_load_local_rcx(hi_slot)
        emit_u8(0x48)  emit_u8(0x39)  emit_u8(0xC8) // cmp rax, rcx
        emit_u8(0x0F)  emit_u8(0x8D)                // jge .exit
        exit_patch := g[G_CODE_OFF]
        emit_u32(0)

        ld := g[G_LP_DEPTH]
        lp_cont_tgt[ld]  = -1
        lp_brk_head[ld]  = -1
        lp_cont_head[ld] = -1
        lp_tile_base[ld] = g[G_TILE_DEPTH]
        g[G_LP_DEPTH]    = ld + 1

        parse_raw_brace_stmts()

        g[G_LP_DEPTH] = ld
        resolve_patch_chain(lp_cont_head[ld])
        emit_load_local(v_disp)
        emit_u8(0x48)  emit_u8(0x83)  emit_u8(0xC0)  emit_u8(1) // add rax, 1
        emit_store_local(v_disp)
        emit_jmp_to(head_off)

        patch_rel32_here(exit_patch)
        resolve_patch_chain(lp_brk_head[ld])

        g[G_SCOPE_DEPTH] -= 1
        g[G_LOC_CNT] = saved_loc

        if has_rec == 1 {
            finish_recover_clause(rec_slot)
        }
        return
    }

    // Case B: `for slot in mask <bits> { ... }`
    if peek_kind() == TOK_LT && is_descriptor_lt_at(g[G_TOK_IDX]) == 1 {
        expect_kind(TOK_LT)
        lsym := expect_ident()
        if lsym != g[G_SYM_BITS] {
            die_cur("error: unimplemented or invalid loop lens")
        }
        expect_kind(TOK_GT)

        mask_slot := alloc_anon_qwords(1)
        emit_store_local(mask_slot)

        saved_loc := g[G_LOC_CNT]
        g[G_SCOPE_DEPTH] += 1
        v_disp := alloc_local(v_sym, TY_I64, v_line)

        head_off := g[G_CODE_OFF]
        emit_load_local(mask_slot)
        exit_patch := emit_jz_rel32()
        // `tzcnt rax, rax`
        emit_u8(0xF3)  emit_u8(0x48)  emit_u8(0x0F)  emit_u8(0xBC)  emit_u8(0xC0)
        emit_store_local(v_disp)

        ld := g[G_LP_DEPTH]
        lp_cont_tgt[ld]  = -1
        lp_brk_head[ld]  = -1
        lp_cont_head[ld] = -1
        lp_tile_base[ld] = g[G_TILE_DEPTH]
        g[G_LP_DEPTH]    = ld + 1

        parse_raw_brace_stmts()

        g[G_LP_DEPTH] = ld
        resolve_patch_chain(lp_cont_head[ld])
        // Clear lowest set bit: `mask = mask & (mask - 1)`
        emit_load_local(mask_slot)
        emit_u8(0x48)  emit_u8(0x8D)  emit_u8(0x48)  emit_u8(0xFF) // lea rcx, [rax - 1]
        emit_u8(0x48)  emit_u8(0x21)  emit_u8(0xC8)                // and rax, rcx
        emit_store_local(mask_slot)
        emit_jmp_to(head_off)

        patch_rel32_here(exit_patch)
        resolve_patch_chain(lp_brk_head[ld])

        g[G_SCOPE_DEPTH] -= 1
        g[G_LOC_CNT] = saved_loc
        return
    }

    die_cur("error: expected '..' or '<bits>' in for loop")
}

fn parse_stmt_loop() {
    expect_kw(KW_LOOP)
    has_max: i64       = 0
    max_slot: i64      = 0
    cnt_slot: i64      = 0
    until_tok_start: i64 = -1
    until_tok_end: i64   = -1
    is_tile_loop: i64  = 0

    if peek_kind() == TOK_LT {
        expect_kind(TOK_LT)
        loop <max: 16 | until: 0 == 1> {
            csym := expect_ident()
            if csym == g[G_SYM_TILE] {
                if g[G_MODE_CAPSULE] == 0 {
                    die_cur("error: <tile> requires --target=capsule")
                }
                is_tile_loop = 1
            } else {
                expect_kind(TOK_COLON)
                end_i := scan_loop_lens_clause_end()
                if csym == g[G_SYM_MAX] {
                    parse_bounded_expr(end_i)
                    max_slot = alloc_anon_qwords(1)
                    emit_store_local(max_slot)
                    cnt_slot = alloc_anon_qwords(1)
                    emit_mov_rax_imm64(0)
                    emit_store_local(cnt_slot)
                    has_max = 1
                } else {
                    if csym == g[G_SYM_UNTIL] {
                        until_tok_start = g[G_TOK_IDX]
                        until_tok_end   = end_i
                        g[G_TOK_IDX]    = end_i
                    } else {
                        die_cur("error: unimplemented or invalid loop lens")
                    }
                }
            }
            if peek_kind() != TOK_PIPE { break }
            g[G_TOK_IDX] += 1
        }
        expect_kind(TOK_GT)
    }

    has_rec := block_has_trailing_recover(g[G_TOK_IDX])
    rec_slot: i64 = 0
    if has_rec == 1 {
        rec_slot = g[G_REC_DEPTH]
        rec_jmp_head[rec_slot]  = -1
        rec_tile_base[rec_slot] = g[G_TILE_DEPTH]
        g[G_REC_DEPTH] = rec_slot + 1
    }

    head_off := g[G_CODE_OFF]
    exit_max_p: i64   = -1
    exit_until_p: i64 = -1

    if has_max == 1 {
        emit_load_local(cnt_slot)
        emit_load_local_rcx(max_slot)
        emit_u8(0x48)  emit_u8(0x39)  emit_u8(0xC8) // cmp rax, rcx
        emit_u8(0x0F)  emit_u8(0x8D)                // jge .exit
        exit_max_p = g[G_CODE_OFF]
        emit_u32(0)
        emit_u8(0x48)  emit_u8(0x83)  emit_u8(0xC0)  emit_u8(1)
        emit_store_local(cnt_slot)
    }

    if until_tok_start >= 0 {
        saved_cur := g[G_TOK_IDX]
        g[G_TOK_IDX] = until_tok_start
        parse_bounded_expr(until_tok_end)
        g[G_TOK_IDX] = saved_cur
        exit_until_p = emit_jnz_rel32()
    }

    if is_tile_loop == 1 {
        emit_tile_enter_seq()
        g[G_TILE_DEPTH] += 1
    }

    ld := g[G_LP_DEPTH]
    lp_cont_tgt[ld]  = -1
    lp_brk_head[ld]  = -1
    lp_cont_head[ld] = -1
    lp_tile_base[ld] = g[G_TILE_DEPTH] - is_tile_loop
    g[G_LP_DEPTH]    = ld + 1

    parse_scoped_block()

    g[G_LP_DEPTH] = ld
    if is_tile_loop == 1 {
        g[G_TILE_DEPTH] -= 1
        emit_tile_unwind_count(1)
    }

    resolve_patch_chain(lp_cont_head[ld])
    emit_jmp_to(head_off)

    if exit_max_p >= 0   { patch_rel32_here(exit_max_p) }
    if exit_until_p >= 0 { patch_rel32_here(exit_until_p) }
    resolve_patch_chain(lp_brk_head[ld])

    if has_rec == 1 {
        finish_recover_clause(rec_slot)
    }
}

fn parse_stmt_print() {
    if g[G_MODE_CAPSULE] == 1 {
        die_cur("error: host print unavailable in --target=capsule")
    }
    expect_kw(KW_PRINT)
    expect_kind(TOK_LPAREN)

    if peek_kind() != TOK_STR {
        parse_expr(1)
        emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC7) // mov rdi, rax
        emit_call_direct_off(g[G_RT_WRITE_OFF])
        emit_write_ro_slice(0, 0, 1)
        expect_kind(TOK_RPAREN)
        return
    }

    poff := peek_val()
    slen := peek_aux()
    line := peek_line()
    g[G_TOK_IDX] += 1
    expect_kind(TOK_RPAREN)

    seg_start: i64 = 0
    pos: i64       = 0
    loop <max: 262144 | until: pos >= slen> {
        if str_pool[poff + pos] != '{' {
            pos += 1
            continue
        }
        // Flush literal prefix before `{`
        if pos > seg_start {
            emit_write_ro_slice(poff + seg_start, pos - seg_start, 0)
        }
        pos += 1
        expr_start := pos
        loop <max: 65536 | until: pos >= slen || str_pool[poff + pos] == '}'> {
            pos += 1
        }
        if pos >= slen {
            die_line("error: unclosed '{' in print string", line)
        }
        expr_len := pos - expr_start

        // Tokenize `{expr}` slice at tail of `src_buf` & `tok_*`
        sub_src := g[G_SRC_OFF]
        for k in 0..expr_len {
            src_buf[sub_src + k] = str_pool[poff + expr_start + k]
        }
        src_buf[sub_src + expr_len] = 0
        g[G_SRC_OFF] = sub_src + expr_len + 1

        saved_idx := g[G_TOK_IDX]
        saved_cnt := g[G_TOK_CNT]
        g[G_TOK_IDX] = saved_cnt
        tokenize_range(sub_src, sub_src + expr_len, 0, 0, 0)
        push_tok(TOK_EOF, 0, line, 0, 0)

        parse_expr(1)
        expect_kind(TOK_EOF)

        g[G_TOK_CNT] = saved_cnt
        g[G_TOK_IDX] = saved_idx

        emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC7) // mov rdi, rax
        emit_call_direct_off(g[G_RT_WRITE_OFF])

        pos += 1
        seg_start = pos
    }

    // Flush trailing slice + newline
    emit_write_ro_slice(poff + seg_start, slen - seg_start, 1)
}

fn parse_ident_stmt() {
    decl_line := peek_line()
    sym       := expect_ident()
    k         := peek_kind()

    // 1. `name := expr`
    if k == TOK_WALRUS {
        g[G_TOK_IDX] += 1
        parse_expr(1)
        ty := g[G_LAST_EXPR_TY]
        if (ty & TY_FLAG_SPAN) == 0 && (ty & TY_FLAG_VIEW1) == 0 {
            if (ty & TY_BASE_MASK) < TY_BP_BASE {
                if is_ty_unsigned(ty) == 1 { ty = TY_U64 } else { ty = TY_I64 }
            }
        }
        disp := alloc_local(sym, ty, decl_line)
        if (ty & TY_FLAG_SPAN) != 0 {
            emit_store_span_local(disp)
        } else {
            emit_narrow_rax(ty)
            emit_store_local(disp)
        }
        return
    }

    // 2. `name: Type = expr`
    if k == TOK_COLON {
        g[G_TOK_IDX] += 1
        ty := parse_type_tag()
        expect_kind(TOK_ASSIGN)
        parse_expr(1)
        disp := alloc_local(sym, ty, decl_line)
        if (ty & TY_FLAG_SPAN) != 0 {
            emit_store_span_local(disp)
        } else {
            emit_narrow_rax(ty)
            emit_store_local(disp)
        }
        return
    }

    // 3. Void / discarded function call `fn_name(args...)`
    if k == TOK_LPAREN {
        fidx := find_or_add_fn(sym)
        parse_fn_call_expr(fidx)
        return
    }

    // 4. Local lvalue (`x = ...`, `x += ...`, `v[idx] = ...`, `tok.fld = ...`)
    li := find_local(sym)
    if li >= 0 {
        lty: i64   = loc_ty[li]
        ldisp: i64 = loc_disp[li]

        // 4a. Indexed span or single-view local `v[idx] op= rhs`
        if peek_kind() == TOK_LBRACK {
            g[G_TOK_IDX] += 1
            parse_expr(1)
            expect_kind(TOK_RBRACK)
            ety := lty & TY_BASE_MASK
            esz := ty_byte_size(ety)

            if (lty & TY_FLAG_SPAN) != 0 {
                // `rax` = idx; check `rax < [rbp + ldisp + 8]`
                emit_load_local_rcx(ldisp + 8)
                emit_u8(0x48)  emit_u8(0x39)  emit_u8(0xC8)
                emit_u8(0x0F)  emit_u8(0x82)
                ok_p := g[G_CODE_OFF]
                emit_u32(0)
                emit_raise_fault_imm(2)
                patch_rel32_here(ok_p)
                if esz == 2 { emit_u8(0x48)  emit_u8(0xD1)  emit_u8(0xE0) }
                if esz == 4 { emit_u8(0x48)  emit_u8(0xC1)  emit_u8(0xE0)  emit_u8(2) }
                if esz == 8 { emit_u8(0x48)  emit_u8(0xC1)  emit_u8(0xE0)  emit_u8(3) }
                emit_load_local_rcx(ldisp)
                emit_u8(0x48)  emit_u8(0x01)  emit_u8(0xC8)
            } else {
                if esz == 2 { emit_u8(0x48)  emit_u8(0xD1)  emit_u8(0xE0) }
                if esz == 4 { emit_u8(0x48)  emit_u8(0xC1)  emit_u8(0xE0)  emit_u8(2) }
                if esz == 8 { emit_u8(0x48)  emit_u8(0xC1)  emit_u8(0xE0)  emit_u8(3) }
                emit_load_local_rcx(ldisp)
                emit_u8(0x48)  emit_u8(0x01)  emit_u8(0xC8)
            }

            addr_slot := alloc_temp_qword()
            emit_store_local(addr_slot)

            op := peek_kind()
            if is_assign_op(op) == 0 { die_cur("error: expected assignment operator") }
            g[G_TOK_IDX] += 1

            if op == TOK_ASSIGN {
                parse_expr(1)
                emit_load_local_rcx(addr_slot)
                free_temp_qwords(1)
                emit_store_mem_typed(ety)
                return
            }
            old_slot := alloc_temp_qword()
            emit_load_local(addr_slot)
            emit_load_mem_typed(ety)
            emit_store_local(old_slot)
            parse_expr(1)
            rhs_ty := g[G_LAST_EXPR_TY]
            emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC1)
            emit_load_local(old_slot)
            emit_compound_op(op, ety, rhs_ty)
            emit_load_local_rcx(addr_slot)
            free_temp_qwords(2)
            emit_store_mem_typed(ety)
            return
        }

        // 4b. BitPack field mutation `tok.field op= rhs`
        if peek_kind() == TOK_DOT {
            g[G_TOK_IDX] += 1
            fsym := expect_ident()
            base := lty & TY_BASE_MASK
            if base < TY_BP_BASE { die_cur("error: field assignment requires bitpack") }
            fidx := find_bp_field(base - TY_BP_BASE, fsym)
            if fidx < 0 { die_cur("error: unknown bitpack field") }
            f_sh: i64 = bpf_shift[fidx]
            f_w: i64  = bpf_width[fidx]
            f_msk := width_mask64(f_w)

            op := peek_kind()
            if is_assign_op(op) == 0 { die_cur("error: expected assignment operator") }
            g[G_TOK_IDX] += 1

            if op == TOK_ASSIGN {
                parse_expr(1)
            } else {
                old_slot := alloc_temp_qword()
                emit_load_local(ldisp)
                emit_extract_bits(f_sh, f_w)
                emit_store_local(old_slot)
                parse_expr(1)
                rhs_ty := g[G_LAST_EXPR_TY]
                emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC1)
                emit_load_local(old_slot)
                free_temp_qwords(1)
                emit_compound_op(op, TY_U64, rhs_ty)
            }
            if f_w < 64 {
                emit_mov_rcx_imm64(f_msk)
                emit_u8(0x48)  emit_u8(0x21)  emit_u8(0xC8)
            }
            if f_sh > 0 {
                emit_u8(0x48)  emit_u8(0xC1)  emit_u8(0xE0)  emit_u8(f_sh)
            }
            new_bits := alloc_temp_qword()
            emit_store_local(new_bits)
            emit_load_local(ldisp)
            emit_mov_rcx_imm64(~(f_msk << f_sh))
            emit_u8(0x48)  emit_u8(0x21)  emit_u8(0xC8)
            emit_load_local_rcx(new_bits)
            free_temp_qwords(1)
            emit_u8(0x48)  emit_u8(0x09)  emit_u8(0xC8)
            emit_narrow_rax(lty)
            emit_store_local(ldisp)
            return
        }

        // 4c. Direct local assignment `x = rhs` / `x op= rhs`
        op := peek_kind()
        if is_assign_op(op) == 0 { die_cur("error: expected assignment operator") }
        g[G_TOK_IDX] += 1

        if (lty & TY_FLAG_SPAN) != 0 {
            parse_expr(1)
            emit_store_span_local(ldisp)
            return
        }
        if op == TOK_ASSIGN {
            parse_expr(1)
            emit_narrow_rax(lty)
            emit_store_local(ldisp)
            return
        }
        parse_expr(1)
        rhs_ty := g[G_LAST_EXPR_TY]
        emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC1)
        emit_load_local(ldisp)
        emit_compound_op(op, lty, rhs_ty)
        emit_narrow_rax(lty)
        emit_store_local(ldisp)
        return
    }

    // 5. `@slab` / `@arena` element assignment `sp[idx] op= rhs`
    si := find_space(sym)
    if si >= 0 {
        expect_kind(TOK_LBRACK)
        parse_expr(1)
        expect_kind(TOK_RBRACK)
        // Unsigned bounds check `idx >= sp_cap -> fail 2`
        emit_mov_rcx_imm64(sp_cap[si])
        emit_u8(0x48)  emit_u8(0x39)  emit_u8(0xC8)
        emit_u8(0x0F)  emit_u8(0x82)
        ok_p := g[G_CODE_OFF]
        emit_u32(0)
        emit_raise_fault_imm(2)
        patch_rel32_here(ok_p)

        esz: i64 = sp_elem_sz[si]
        if esz == 2 { emit_u8(0x48)  emit_u8(0xD1)  emit_u8(0xE0) }
        if esz == 4 { emit_u8(0x48)  emit_u8(0xC1)  emit_u8(0xE0)  emit_u8(2) }
        if esz == 8 { emit_u8(0x48)  emit_u8(0xC1)  emit_u8(0xE0)  emit_u8(3) }
        emit_mov_rcx_imm64(sp_vaddr[si])
        emit_u8(0x48)  emit_u8(0x01)  emit_u8(0xC8)

        addr_slot := alloc_temp_qword()
        emit_store_local(addr_slot)

        op := peek_kind()
        if is_assign_op(op) == 0 { die_cur("error: expected assignment operator") }
        g[G_TOK_IDX] += 1
        ety: i64 = sp_elem_ty[si]

        if op == TOK_ASSIGN {
            parse_expr(1)
            emit_load_local_rcx(addr_slot)
            free_temp_qwords(1)
            emit_store_mem_typed(ety)
            return
        }
        old_slot := alloc_temp_qword()
        emit_load_local(addr_slot)
        emit_load_mem_typed(ety)
        emit_store_local(old_slot)
        parse_expr(1)
        rhs_ty := g[G_LAST_EXPR_TY]
        emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC1)
        emit_load_local(old_slot)
        emit_compound_op(op, ety, rhs_ty)
        emit_load_local_rcx(addr_slot)
        free_temp_qwords(2)
        emit_store_mem_typed(ety)
        return
    }

    die_cur("error: undefined identifier in statement")
}

fn parse_stmt() {
    k := peek_kind()

    if k == TOK_LBRACE {
        parse_guarded_block_stmt()
        return
    }

    if k == TOK_AT {
        parse_at_expr()
        return
    }

    if k == TOK_KW {
        kw := peek_kw()
        if kw == KW_IF    { parse_stmt_if()     return }
        if kw == KW_FOR   { parse_stmt_for()    return }
        if kw == KW_LOOP  { parse_stmt_loop()   return }
        if kw == KW_PRINT { parse_stmt_print()  return }

        if kw == KW_RETURN {
            ret_line := peek_line()
            g[G_TOK_IDX] += 1
            if g[G_CUR_RET_TY] == TY_VOID {
                emit_mov_rax_imm64(0)
            } else {
                if peek_kind() == TOK_RBRACE {
                    emit_mov_rax_imm64(0)
                } else {
                    parse_expr(1)
                    emit_narrow_rax(g[G_CUR_RET_TY])
                }
            }
            emit_tile_unwind_count(g[G_TILE_DEPTH])
            emit_u8(0xC9)  emit_u8(0xC3) // leave; ret
            ret_line += 0
            return
        }

        if kw == KW_BREAK {
            g[G_TOK_IDX] += 1
            ld := g[G_LP_DEPTH]
            if ld <= 0 { die_cur("error: break outside loop") }
            top := ld - 1
            emit_tile_unwind_count(g[G_TILE_DEPTH] - lp_tile_base[top])
            jpos := emit_jmp_rel32()
            lp_brk_head[top] = push_patch_node(lp_brk_head[top], jpos)
            return
        }

        if kw == KW_CONTINUE {
            g[G_TOK_IDX] += 1
            ld := g[G_LP_DEPTH]
            if ld <= 0 { die_cur("error: continue outside loop") }
            top := ld - 1
            emit_tile_unwind_count(g[G_TILE_DEPTH] - lp_tile_base[top])
            jpos := emit_jmp_rel32()
            lp_cont_head[top] = push_patch_node(lp_cont_head[top], jpos)
            return
        }

        if kw == KW_FAIL {
            g[G_TOK_IDX] += 1
            parse_expr(1)
            // Rewrite dynamic `0` to `1` (§5.3)
            emit_u8(0x48)  emit_u8(0x85)  emit_u8(0xC0)
            emit_u8(0x75)  emit_u8(0x05)
            emit_u8(0xB8)  emit_u32(1)
            emit_fault_store_rax()
            emit_unwind_or_return_fault()
            return
        }

        die_cur("error: unexpected keyword statement")
    }

    if k == TOK_IDENT {
        // Contextual `tile { ... }` atomic run-to-completion block
        if peek_val() == g[G_SYM_TILE] && tok_kind[g[G_TOK_IDX] + 1] == TOK_LBRACE {
            if g[G_MODE_CAPSULE] == 0 {
                die_cur("error: tile block requires --target=capsule")
            }
            g[G_TOK_IDX] += 1
            emit_tile_enter_seq()
            g[G_TILE_DEPTH] += 1
            parse_scoped_block()
            g[G_TILE_DEPTH] -= 1
            emit_tile_unwind_count(1)
            return
        }
        parse_ident_stmt()
        return
    }

    die_cur("error: parse fault in statement")
}

// --- Top-Level Prescan, Constant Fixed-Point, Space Layout, & Function Codegen ---

fn skip_balanced_braces() {
    expect_kind(TOK_LBRACE)
    depth := 1
    loop <max: 262144 | until: depth == 0> {
        k := peek_kind()
        if k == TOK_EOF { die_cur("error: unclosed '{'") }
        if k == TOK_LBRACE { depth += 1 }
        if k == TOK_RBRACE { depth -= 1 }
        g[G_TOK_IDX] += 1
    }
}

fn skip_arrow_expr() {
    // Advance across `=> expr` until next top-level declaration (`fn`, `@`, `IDENT ::`, or `EOF`)
    pdepth := 0
    bdepth := 0
    loop <max: 65536 | until: 0 == 1> {
        k := peek_kind()
        if k == TOK_EOF { break }
        if pdepth == 0 && bdepth == 0 {
            if k == TOK_KW && peek_kw() == KW_FN { break }
            if k == TOK_AT && (tok_kind[g[G_TOK_IDX] + 1] == TOK_KW) { break }
            if k == TOK_IDENT && tok_kind[g[G_TOK_IDX] + 1] == TOK_COLON2 { break }
        }
        if k == TOK_LPAREN { pdepth += 1 }
        if k == TOK_RPAREN && pdepth > 0 { pdepth -= 1 }
        if k == TOK_LBRACE { bdepth += 1 }
        if k == TOK_RBRACE && bdepth > 0 { bdepth -= 1 }
        g[G_TOK_IDX] += 1
    }
}

fn prescan_pass1_decls() {
    // Pass 1a: collect BitPack types (`Name :: <...>`) and `NAME :: expr` constants
    g[G_TOK_IDX] = 0
    loop <max: 131072 | until: peek_kind() == TOK_EOF> {
        k := peek_kind()
        if k == TOK_IDENT && tok_kind[g[G_TOK_IDX] + 1] == TOK_COLON2 {
            line := peek_line()
            sym  := expect_ident()
            expect_kind(TOK_COLON2)

            if find_const(sym) >= 0 || find_bitpack(sym) >= 0 {
                die_line("error: duplicate top-level symbol", line)
            }

            // BitPack `Name :: <f0: uW0 | f1: uW1 | ...>`
            if is_descriptor_lt_at(g[G_TOK_IDX]) == 1 {
                expect_kind(TOK_LT)
                bp_i := g[G_BP_CNT]
                bp_sym[bp_i]    = sym
                bp_fstart[bp_i] = g[G_BPF_CNT]
                fcnt: i64       = 0
                total_bits: i64 = 0

                // Collect fields MSB -> LSB so first declared field sits at highest bits!
                loop <max: 64 | until: 0 == 1> {
                    fsym := expect_ident()
                    expect_kind(TOK_COLON)
                    wsym := expect_ident()
                    fw   := parse_bitwidth_ident(wsym)
                    fi   := g[G_BPF_CNT]
                    bpf_sym[fi]   = fsym
                    bpf_width[fi] = fw
                    bpf_shift[fi] = 0
                    g[G_BPF_CNT]  = fi + 1
                    fcnt += 1
                    total_bits += fw
                    if peek_kind() != TOK_PIPE { break }
                    g[G_TOK_IDX] += 1
                }
                expect_kind(TOK_GT)
                if total_bits != 8 && total_bits != 16 && total_bits != 32 && total_bits != 64 {
                    die_line("error: bit-layout width must sum to 8, 16, 32, or 64", line)
                }
                // Compute MSB-first bit shifts (`gen: u32 | slot: u16 | op: u16` -> shifts 32, 16, 0)
                rem := total_bits
                fbase: i64 = bp_fstart[bp_i]
                for j in 0..fcnt {
                    rem -= bpf_width[fbase + j]
                    bpf_shift[fbase + j] = rem
                }
                bp_fcnt[bp_i]  = fcnt
                bp_bytes[bp_i] = total_bits >> 3
                g[G_BP_CNT]    = bp_i + 1
                continue
            }

            // Constant `NAME :: const_expr`
            ci := g[G_CST_CNT]
            cst_sym[ci]  = sym
            cst_tok[ci]  = g[G_TOK_IDX]
            cst_done[ci] = 0
            cst_val[ci]  = 0
            g[G_CST_CNT] = ci + 1

            // Advance past constant expression tokens
            skip_arrow_expr()
            continue
        }

        if k == TOK_AT {
            g[G_TOK_IDX] += 1
            if peek_kind() == TOK_KW {
                g[G_TOK_IDX] += 1
                expect_ident()
                expect_kind(TOK_COLON)
                expect_kind(TOK_LT)
                d := 1
                loop <max: 1024 | until: d == 0> {
                    tk := peek_kind()
                    if tk == TOK_EOF { die_cur("error: unclosed space <...>") }
                    if tk == TOK_LT { d += 1 }
                    if tk == TOK_GT { d -= 1 }
                    g[G_TOK_IDX] += 1
                }
                continue
            }
            die_cur("error: unexpected top-level '@'")
        }

        if k == TOK_KW && peek_kw() == KW_FN {
            g[G_TOK_IDX] += 1
            expect_ident()
            expect_kind(TOK_LPAREN)
            loop <max: 256 | until: peek_kind() == TOK_RPAREN> {
                if peek_kind() == TOK_EOF { die_cur("error: unclosed '('") }
                g[G_TOK_IDX] += 1
            }
            expect_kind(TOK_RPAREN)
            loop <max: 16 | until: peek_kind() == TOK_LBRACE || peek_kind() == TOK_FAT_ARROW> {
                if peek_kind() == TOK_EOF { die_cur("error: expected function body") }
                g[G_TOK_IDX] += 1
            }
            if peek_kind() == TOK_FAT_ARROW {
                g[G_TOK_IDX] += 1
                skip_arrow_expr()
            } else {
                skip_balanced_braces()
            }
            continue
        }

        die_cur("error: unexpected top-level token")
    }
}

fn resolve_constants_fixed_point() {
    cnt := g[G_CST_CNT]
    if cnt == 0 { return }
    for round in 0..(cnt + 1) {
        rem      := 0
        progress := 0
        for i in 0..cnt {
            if cst_done[i] == 1 { continue }
            rem += 1
            g[G_CST_TRIAL] = 1
            g[G_CST_UNRES] = 0
            g[G_TOK_IDX]   = cst_tok[i]
            val := eval_const_expr(1)
            if g[G_CST_UNRES] == 0 {
                cst_val[i]  = val
                cst_done[i] = 1
                progress    = 1
                rem -= 1
            }
        }
        if rem == 0 {
            g[G_CST_TRIAL] = 0
            return
        }
        if progress == 0 {
            g[G_CST_TRIAL] = 0
            for i in 0..cnt {
                if cst_done[i] == 0 {
                    g[G_TOK_IDX] = cst_tok[i]
                    eval_const_expr(1)
                }
            }
            die_msg("error: unresolved or cyclic constant")
        }
    }
}

fn prescan_spaces_and_fns() {
    g[G_BSS_OFF] = 64   // `0x10000000 .. +64` reserved for host scalar fault word + alignment
    g[G_TOK_IDX] = 0

    loop <max: 131072 | until: peek_kind() == TOK_EOF> {
        k := peek_kind()

        if k == TOK_IDENT && tok_kind[g[G_TOK_IDX] + 1] == TOK_COLON2 {
            g[G_TOK_IDX] += 2
            if is_descriptor_lt_at(g[G_TOK_IDX]) == 1 {
                expect_kind(TOK_LT)
                d := 1
                loop <max: 1024 | until: d == 0> {
                    if peek_kind() == TOK_LT { d += 1 }
                    if peek_kind() == TOK_GT { d -= 1 }
                    g[G_TOK_IDX] += 1
                }
            } else {
                skip_arrow_expr()
            }
            continue
        }

        if k == TOK_AT {
            g[G_TOK_IDX] += 1
            if g[G_MODE_CAPSULE] == 1 {
                die_cur("error: mutable @slab/@arena forbidden in --target=capsule")
            }
            if peek_kind() != TOK_KW {
                die_cur("error: unimplemented '@' space")
            }
            skw := peek_kw()
            g[G_TOK_IDX] += 1
            sline := peek_line()
            ssym  := expect_ident()
            if find_space(ssym) >= 0 || find_const(ssym) >= 0 {
                die_line("error: duplicate top-level symbol", sline)
            }
            expect_kind(TOK_COLON)
            expect_kind(TOK_LT)

            ety: i64 = TY_U8
            cap: i64 = 0

            if skw == KW_SLAB {
                ety = parse_type_tag()
                expect_kind(TOK_PIPE)
                csym := expect_ident()
                if csym != g[G_SYM_CAP] && csym != g[G_SYM_MAX] {
                    die_line("error: @slab expects cap: or max:", sline)
                }
                expect_kind(TOK_COLON)
                cap = eval_const_expr(1)
            } else {
                if skw == KW_ARENA {
                    csym := expect_ident()
                    if csym != g[G_SYM_CAP] {
                        die_line("error: @arena expects cap:", sline)
                    }
                    expect_kind(TOK_COLON)
                    cap = eval_const_expr(1)
                } else {
                    die_line("error: unimplemented '@' space", sline)
                }
            }
            expect_kind(TOK_GT)
            if cap <= 0 {
                die_line("error: space capacity must be positive", sline)
            }

            esz := ty_byte_size(ety)
            aligned_off := (g[G_BSS_OFF] + 63) & (~63)
            si := g[G_SP_CNT]
            sp_sym[si]     = ssym
            sp_elem_ty[si] = ety
            sp_elem_sz[si] = esz
            sp_cap[si]     = cap
            sp_vaddr[si]   = ELF_DATA_BASE + aligned_off
            g[G_SP_CNT]    = si + 1
            g[G_BSS_OFF]   = aligned_off + cap * esz
            continue
        }

        if k == TOK_KW && peek_kw() == KW_FN {
            g[G_TOK_IDX] += 1
            fline := peek_line()
            fsym  := expect_ident()
            fidx  := find_or_add_fn(fsym)
            if fn_defined[fidx] != 0 {
                die_line("error: duplicate function definition", fline)
            }
            fn_defined[fidx] = 1
            fn_pstart[fidx]  = g[G_FNP_CNT]

            expect_kind(TOK_LPAREN)
            arity: i64 = 0
            if peek_kind() != TOK_RPAREN {
                loop <max: 8 | until: 0 == 1> {
                    if arity >= 6 { die_line("error: maximum 6 function parameters", fline) }
                    expect_ident()
                    expect_kind(TOK_COLON)
                    pty := parse_type_tag()
                    fn_param_ty[g[G_FNP_CNT]] = pty
                    g[G_FNP_CNT] += 1
                    arity += 1
                    if peek_kind() != TOK_COMMA { break }
                    g[G_TOK_IDX] += 1
                }
            }
            expect_kind(TOK_RPAREN)
            fn_arity[fidx] = arity

            if peek_kind() == TOK_ARROW { g[G_TOK_IDX] += 1 }
            rty: i64 = TY_VOID
            if peek_kind() != TOK_LBRACE && peek_kind() != TOK_FAT_ARROW {
                rty = parse_type_tag()
            }
            fn_ret_ty[fidx] = rty

            if peek_kind() == TOK_FAT_ARROW {
                g[G_TOK_IDX] += 1
                skip_arrow_expr()
            } else {
                skip_balanced_braces()
            }
            continue
        }

        die_cur("error: unexpected top-level token")
    }
}

fn emit_move_param_to_rax(idx: i64) {
    if idx == 0 { emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xF8)  return } // mov rax, rdi
    if idx == 1 { emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xF0)  return } // mov rax, rsi
    if idx == 2 { emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xD0)  return } // mov rax, rdx
    if idx == 3 {
        if g[G_MODE_CAPSULE] == 1 {
            emit_u8(0x4C)  emit_u8(0x89)  emit_u8(0xD0)                 // mov rax, r10
        } else {
            emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xC8)                 // mov rax, rcx
        }
        return
    }
    if idx == 4 { emit_u8(0x4C)  emit_u8(0x89)  emit_u8(0xC0)  return } // mov rax, r8
    if idx == 5 { emit_u8(0x4C)  emit_u8(0x89)  emit_u8(0xC8)  return } // mov rax, r9
}

fn compile_all_functions() {
    g[G_TOK_IDX] = 0
    loop <max: 131072 | until: peek_kind() == TOK_EOF> {
        k := peek_kind()

        if k == TOK_IDENT && tok_kind[g[G_TOK_IDX] + 1] == TOK_COLON2 {
            g[G_TOK_IDX] += 2
            if is_descriptor_lt_at(g[G_TOK_IDX]) == 1 {
                expect_kind(TOK_LT)
                d := 1
                loop <max: 1024 | until: d == 0> {
                    if peek_kind() == TOK_LT { d += 1 }
                    if peek_kind() == TOK_GT { d -= 1 }
                    g[G_TOK_IDX] += 1
                }
            } else {
                skip_arrow_expr()
            }
            continue
        }

        if k == TOK_AT {
            g[G_TOK_IDX] += 4
            expect_kind(TOK_LT)
            d := 1
            loop <max: 1024 | until: d == 0> {
                if peek_kind() == TOK_LT { d += 1 }
                if peek_kind() == TOK_GT { d -= 1 }
                g[G_TOK_IDX] += 1
            }
            continue
        }

        if k == TOK_KW && peek_kw() == KW_FN {
            g[G_TOK_IDX] += 1
            fsym := expect_ident()
            fidx := find_or_add_fn(fsym)
            fn_code_off[fidx] = g[G_CODE_OFF]

            // Reset per-function frame & scope state
            g[G_LOC_CNT]      = 0
            g[G_SCOPE_DEPTH]  = 1
            g[G_FRAME_QW]     = 0
            g[G_TEMP_DEPTH]   = 0
            g[G_MAX_FRAME_QW] = 0
            g[G_LP_DEPTH]     = 0
            g[G_REC_DEPTH]    = 0
            g[G_TILE_DEPTH]   = 0
            g[G_CUR_RET_TY]   = fn_ret_ty[fidx]

            // Prologue: `push rbp; mov rbp, rsp; sub rsp, <imm32>`
            emit_u8(0x55)
            emit_u8(0x48)  emit_u8(0x89)  emit_u8(0xE5)
            emit_u8(0x48)  emit_u8(0x81)  emit_u8(0xEC)
            frame_patch := g[G_CODE_OFF]
            emit_u32(0)

            expect_kind(TOK_LPAREN)
            p_idx: i64 = 0
            if peek_kind() != TOK_RPAREN {
                loop <max: 8 | until: 0 == 1> {
                    pline := peek_line()
                    psym  := expect_ident()
                    expect_kind(TOK_COLON)
                    pty   := parse_type_tag()
                    pdisp := alloc_local(psym, pty, pline)
                    emit_move_param_to_rax(p_idx)
                    if (pty & TY_FLAG_SPAN) != 0 {
                        emit_store_span_local(pdisp)
                    } else {
                        emit_narrow_rax(pty)
                        emit_store_local(pdisp)
                    }
                    p_idx += 1
                    if peek_kind() != TOK_COMMA { break }
                    g[G_TOK_IDX] += 1
                }
            }
            expect_kind(TOK_RPAREN)

            if peek_kind() == TOK_ARROW { g[G_TOK_IDX] += 1 }
            if peek_kind() != TOK_LBRACE && peek_kind() != TOK_FAT_ARROW {
                parse_type_tag()
            }

            if peek_kind() == TOK_FAT_ARROW {
                g[G_TOK_IDX] += 1
                parse_expr(1)
                if g[G_CUR_RET_TY] != TY_VOID {
                    emit_narrow_rax(g[G_CUR_RET_TY])
                }
                emit_u8(0xC9)  emit_u8(0xC3)
            } else {
                parse_raw_brace_stmts()
                // Fallthrough epilogue: `xor eax, eax; leave; ret`
                emit_u8(0x31)  emit_u8(0xC0)
                emit_u8(0xC9)  emit_u8(0xC3)
            }

            // Inductive 64B `RSP` alignment: `frame = ((bytes + 79) & ~63) - 16`
            raw_bytes   := g[G_MAX_FRAME_QW] * 8
            frame_bytes := ((raw_bytes + 79) & (~63)) - 16
            patch_u32_at(frame_patch, frame_bytes)
            continue
        }
    }
}

// --- Stage-1 Self-Hosted Compiler Entry Point ---

fn main(argc: u64, argv_ptr: u64) i64 {
    if argc < 3 {
        die_msg("usage: zero1 [--lex | --target=capsule] <input.zr> [output]")
    }
    argv := @view<u64>(argv_ptr, argc)

    in_cstr: u64  = 0
    out_cstr: u64 = 0

    if cstr_eq_str(argv[1], "--lex") == 1 {
        g[G_MODE_LEX] = 1
        in_cstr = argv[2]
    } else {
        if cstr_eq_str(argv[1], "--target=capsule") == 1 {
            if argc != 4 {
                die_msg("usage: zero1 --target=capsule <input.zr> <output.zcap>")
            }
            g[G_MODE_CAPSULE] = 1
            in_cstr  = argv[2]
            out_cstr = argv[3]
        } else {
            if argc != 3 {
                die_msg("usage: zero1 <input.zr> <output_elf>")
            }
            in_cstr  = argv[1]
            out_cstr = argv[2]
        }
    }

    lexer_init()

    in_len   := cstr_len(in_cstr)
    root_off := pool_append_bytes(in_cstr, in_len)
    load_and_lex_module(root_off, in_len)
    push_tok(TOK_EOF, 0, 0, 0, 0)

    if g[G_MODE_LEX] == 1 {
        cnt := g[G_TOK_CNT] - 1
        print("lex ok: {cnt} tokens")
        return 0
    }

    prescan_pass1_decls()
    resolve_constants_fixed_point()
    prescan_spaces_and_fns()

    main_idx := find_or_add_fn(g[G_SYM_MAIN])
    if fn_defined[main_idx] == 0 {
        die_msg("error: missing fn main")
    }

    emit_target_entry_runtime(main_idx)
    compile_all_functions()
    finalize_call_fixups()

    if g[G_MODE_CAPSULE] == 1 {
        finalize_zcap_container()
        write_output_binary(out_cstr)
        print("ok: zero1 emitted native @capsule (.zcap)")
    } else {
        finalize_elf64_container()
        write_output_binary(out_cstr)
        print("ok: zero1 emitted native W^X ELF64")
    }
    return 0
}
