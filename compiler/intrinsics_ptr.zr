    if sym == g[G_SYM_EMIT] {
        expect_kind(TOK_LPAREN)
        loop <max: 4096 | until: 0 == 1> {
            start_b := g[G_TOK_IDX]
            pdepth  := 0
            idx     := start_b
            loop <max: 1024 | until: 0 == 1> {
                tk := tok_kind[idx]
                if tk == TOK_EOF { die_cur("error: parse fault (unclosed @emit)") }
                if tk == TOK_LPAREN { pdepth += 1  idx += 1  continue }
                if tk == TOK_RPAREN {
                    if pdepth == 0 { break }
                    pdepth -= 1
                    idx += 1
                    continue
                }
                if pdepth == 0 && tk == TOK_COMMA { break }
                idx += 1
            }
            saved_tk := tok_kind[idx]
            tok_kind[idx] = TOK_EOF
            g[G_TOK_IDX] = start_b
            bval := eval_const_expr(1)
            tok_kind[idx] = saved_tk
            if g[G_TOK_IDX] != idx || bval < 0 || bval > 255 {
                die_cur("error: parse fault (@emit requires byte constant 0..255)")
            }
            emit_u8(bval)
            if peek_kind() != TOK_COMMA { break }
            g[G_TOK_IDX] += 1
        }
        expect_kind(TOK_RPAREN)
        g[G_LAST_EXPR_TY] = TY_U64
