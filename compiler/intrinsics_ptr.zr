    }
    if sym == g[G_SYM_PORT_OUT8] {
        ip_eval_2_args_rcx_rax()
        emit_u8(0x89)  emit_u8(0xCA)
        emit_u8(0xEE)
        g[G_LAST_EXPR_TY] = TY_U64
        return
    }
    if sym == g[G_SYM_MM_READ32] {
        ip_eval_1_arg_rax()
        emit_u8(0x8B)  emit_u8(0x00)
        g[G_LAST_EXPR_TY] = TY_U32
        return
    }
    if sym == g[G_SYM_MM_READ64] {
        ip_eval_1_arg_rax()
        emit_u8(0x48)  emit_u8(0x8B)  emit_u8(0x00)
        g[G_LAST_EXPR_TY] = TY_U64
        return
    }
    if sym == g[G_SYM_MM_WRITE32] {
        ip_eval_2_args_rcx_rax()
        emit_u8(0x89)  emit_u8(0x01)
        g[G_LAST_EXPR_TY] = TY_U64
        return
    }
    if sym == g[G_SYM_MM_WRITE64] {
        ip_eval_2_args_rcx_rax()
        emit_u8(0x48)  emit_u8(0x89)  emit_u8(0x01)
        g[G_LAST_EXPR_TY] = TY_U64
        return
    }
    if sym == g[G_SYM_ISR_STUB_BASE] {
        ip_expect_0_args()
        emit_isr_stub_base_rax()
        g[G_LAST_EXPR_TY] = TY_U64
        return
    }

    die_line("error: parse fault (unknown '@' intrinsic)", at_line)
}
