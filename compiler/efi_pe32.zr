// =============================================================================
// Zero Stage-1 Self-Hosted Compiler — Bare-Metal UEFI PE32+ Image Builder (`compiler/efi_pe32.zr`)
// =============================================================================
// Emits standalone x86-64 UEFI Application (`PE32+`, `Machine = 0x8664`,
// `Subsystem = 10`, `.text` RX @ RVA `0x1000`, `.reloc` block, `.bss` RW) with:
//   1. MS x64 UEFI entry + GOP / ACPI 2.0 XSDT/RSDT / TSC calibration / `<1MiB`
//      AP startup trampoline / coalesced `MemRange[]` / `ExitBootServices`
//   2. BSP Reactor ABI initialization (`IA32_GS_BASE = &ReactorLocal[0]`, `r12..r15`)
//   3. 256 x 16-byte hardware exception gate stubs (`@isr_stub_base()`)
//   4. RIP-relative `.bss` displacement resolution — zero NASM at compile time!
// =============================================================================

fn emit_d4(d0: i64, d1: i64, d2: i64, d3: i64) {
    emit_u32(d0)
    emit_u32(d1)
    emit_u32(d2)
    emit_u32(d3)
}

