// Emits UEFI MS x64 entry prelude + `call main(&BootHandoff)` + 256 x 16B ISR stubs
fn emit_efi_target_runtime(main_fn_idx: i64) {
    g[G_CODE_OFF] = PE_HDR_FILE_SIZE

    // 1. Save MS x64 non-volatile GPRs (`rbx, rbp, rdi, rsi, r12..r15`)
    emit_u8(0x53)  emit_u8(0x55)  emit_u8(0x57)  emit_u8(0x56)
    emit_u8(0x41)  emit_u8(0x54)
    emit_u8(0x41)  emit_u8(0x55)
    emit_u8(0x41)  emit_u8(0x56)
    emit_u8(0x41)  emit_u8(0x57)

    // 2. `lea r15, [rip + disp32]` -> runtime physical base of `.bss` (`bss_off = 0`)
    emit_u8(0x4C)  emit_u8(0x8D)  emit_u8(0x3D)
    emit_efi_bss_disp32(0)

    // 2b. `lea r10, [rip + disp32]` -> physical base of `.text` (`PE_HDR_FILE_SIZE` / RVA `0x1000`)
    emit_u8(0x4C)  emit_u8(0x8D)  emit_u8(0x15)
    emit_u32(PE_HDR_FILE_SIZE - (g[G_CODE_OFF] + 4))

    // `mov r11d, imm32` -> 4KiB-aligned `.text` span (`BootHandoff.code_bytes`)
    emit_u8(0x41)  emit_u8(0xBB)
    g[G_EFI_CODE_SPAN_PATCH] = g[G_CODE_OFF]
    emit_u32(0)

    // 3. Position-independent UEFI harvest + AP trampoline + ExitBootServices + BSP Reactor init
    emit_efi_harvest_stub()

    // 4. Call `.zr` `main(rdi = &BootHandoff)`
    emit_call_fn_idx(main_fn_idx)

    // 5. Post-main halt loop (`cli; .h: hlt; jmp .h`)
    emit_u8(0xFA)  emit_u8(0xF4)  emit_u8(0xEB)  emit_u8(0xFD)

    // 6. Align `.text` to 16 bytes and emit 256 x 16-byte exception gate stubs
    cur_off := g[G_CODE_OFF]
    aligned_off := (cur_off + 15) & (~15)
    for p in cur_off..aligned_off {
        emit_u8(0)
    }
    g[G_EFI_ISR_STUBS_OFF] = g[G_CODE_OFF]

    for vec in 0..256 {
        // 16B stub: `cli; mov dword [rip + isr_line], vec; hlt; jmp -3; nop2`
        emit_u8(0xFA)
        emit_u8(0xC7)  emit_u8(0x05)
        // Next RIP after `C7 05 <disp32> <imm32>` is `disp_pos + 8`, so record `off - 4`!
        emit_efi_bss_disp32(EFI_BSS_ISR_LINE_OFF - 4)
        emit_u32(vec)
        emit_u8(0xF4)
        emit_u8(0xEB)  emit_u8(0xFD)
        emit_u8(0x66)  emit_u8(0x90)
    }
}

// Finalizes standalone PE32+ UEFI Application (`Subsystem = 10`) in `out_buf`
fn finalize_efi_container() {
    // 1. Compute `.text`, `.reloc`, and `.bss` geometry
    code_end       := g[G_CODE_OFF]
    text_virt_size := code_end - PE_HDR_FILE_SIZE
    text_raw_size  := (text_virt_size + 0x1FF) & (~0x1FF)

    pad_end := PE_HDR_FILE_SIZE + text_raw_size
    for i in code_end..pad_end {
        out_buf[i] = 0
    }

    text_rva_span := (text_virt_size + 0xFFF) & (~0xFFF)
    patch_u32_at(g[G_EFI_CODE_SPAN_PATCH], text_rva_span)

    reloc_rva := PE_TEXT_RVA + text_rva_span
    bss_rva   := reloc_rva + 0x1000

    // 2. Patch all RIP-relative `.bss` displacements (`target_rva - next_rip_rva`)
    bf_cnt := g[G_BSS_FIX_CNT]
    for i in 0..bf_cnt {
        patch_pos: i64 = bss_fix_code[i]
        b_off: i64     = bss_fix_off[i]
        target_rva     := bss_rva + b_off
        next_rip_rva   := (patch_pos + 4 - PE_HDR_FILE_SIZE) + PE_TEXT_RVA
        patch_u32_at(patch_pos, target_rva - next_rip_rva)
    }

    // 3. Write 512-byte `.reloc` section at `PE_HDR_FILE_SIZE + text_raw_size`
    reloc_file_off := PE_HDR_FILE_SIZE + text_raw_size
    for i in 0..0x200 {
        out_buf[reloc_file_off + i] = 0
    }
    patch_u32_at(reloc_file_off + 0, PE_TEXT_RVA)
    patch_u32_at(reloc_file_off + 4, 12)
    patch_u32_at(reloc_file_off + 8, 0)

    g[G_TOTAL_OUT] = reloc_file_off + 0x200

    // 4. Stamp 512-byte PE32+ UEFI Application Header (`0x000 .. 0x1FF`)
    for i in 0..PE_HDR_FILE_SIZE {
        out_buf[i] = 0
    }

    // MZ stub (`0x00`..`0x3F`) -> PE header at `0x40`
    out_buf[0x00] = 0x4D
    out_buf[0x01] = 0x5A
    patch_u32_at(0x3C, 0x40)

    // COFF File Header (`0x40`..`0x57`)
    patch_u32_at(0x40, 0x00004550)              // "PE\0\0"
    out_buf[0x44] = 0x64
    out_buf[0x45] = 0x86                        // Machine = 0x8664 (x86-64)
    out_buf[0x46] = 3                           // NumberOfSections = 3 (.text, .reloc, .bss)
    out_buf[0x54] = 240                         // SizeOfOptionalHeader = 240
    out_buf[0x56] = 0x22                        // EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE

    // Optional Header (`0x58`..`0x147`)
    bss_raw := g[G_BSS_OFF]
    if bss_raw < EFI_BSS_USER_START {
        bss_raw = EFI_BSS_USER_START
    }
    bss_virt_size := (bss_raw + 0xFFF) & (~0xFFF)

    out_buf[0x58 + 0x00] = 0x0B
    out_buf[0x58 + 0x01] = 0x02                 // PE32+ Magic = 0x020B
    out_buf[0x58 + 0x02] = 1                    // MajorLinkerVersion = 1
    patch_u32_at(0x58 + 0x04, text_raw_size)    // SizeOfCode
    patch_u32_at(0x58 + 0x08, 0x200)            // SizeOfInitializedData
    patch_u32_at(0x58 + 0x0C, bss_virt_size)    // SizeOfUninitializedData
    patch_u32_at(0x58 + 0x10, PE_TEXT_RVA)      // AddressOfEntryPoint = 0x1000
    patch_u32_at(0x58 + 0x14, PE_TEXT_RVA)      // BaseOfCode = 0x1000
    patch_u64_at(0x58 + 0x18, 0x00400000)       // Preferred ImageBase
    patch_u32_at(0x58 + 0x20, 0x1000)           // SectionAlignment
    patch_u32_at(0x58 + 0x24, 0x0200)           // FileAlignment

    patch_u32_at(0x58 + 0x38, bss_rva + bss_virt_size) // SizeOfImage
    patch_u32_at(0x58 + 0x3C, PE_HDR_FILE_SIZE)        // SizeOfHeaders = 0x200
    out_buf[0x58 + 0x44] = 10                   // Subsystem = EFI_APPLICATION (10)
    patch_u64_at(0x58 + 0x48, 0x100000)         // SizeOfStackReserve
    patch_u64_at(0x58 + 0x50, 0x10000)          // SizeOfStackCommit
    patch_u64_at(0x58 + 0x58, 0x100000)         // SizeOfHeapReserve
    patch_u64_at(0x58 + 0x60, 0x1000)           // SizeOfHeapCommit
    patch_u32_at(0x58 + 0x6C, 16)               // NumberOfRvaAndSizes = 16

    // DataDirectory[5] = Base Relocation Table (`0xF0`)
    patch_u32_at(0xF0 + 0, reloc_rva)
    patch_u32_at(0xF0 + 4, 12)

    // Section 0: `.text` (`0x148`, 40B, `CNT_CODE | MEM_EXECUTE | MEM_READ`)
    patch_u32_at(0x148 + 0,  0x7865742E)        // ".tex"
    out_buf[0x148 + 4] = 't'
    patch_u32_at(0x148 + 8,  text_virt_size)
    patch_u32_at(0x148 + 12, PE_TEXT_RVA)
    patch_u32_at(0x148 + 16, text_raw_size)
    patch_u32_at(0x148 + 20, PE_HDR_FILE_SIZE)
    patch_u32_at(0x148 + 36, 0x60000020)

    // Section 1: `.reloc` (`0x170`, 40B, `INITIALIZED_DATA | DISCARDABLE | READ`)
    patch_u32_at(0x170 + 0,  0x6C65722E)        // ".rel"
    out_buf[0x170 + 4] = 'o'
    out_buf[0x170 + 5] = 'c'
    patch_u32_at(0x170 + 8,  12)
    patch_u32_at(0x170 + 12, reloc_rva)
    patch_u32_at(0x170 + 16, 0x200)
    patch_u32_at(0x170 + 20, reloc_file_off)
    patch_u32_at(0x170 + 36, 0x42000040)

    // Section 2: `.bss` (`0x198`, 40B, `UNINITIALIZED_DATA | READ | WRITE`)
    patch_u32_at(0x198 + 0,  0x7373622E)        // ".bss"
    patch_u32_at(0x198 + 8,  bss_virt_size)
    patch_u32_at(0x198 + 12, bss_rva)
    patch_u32_at(0x198 + 36, 0xC0000080)
}
